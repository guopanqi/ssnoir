{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ssnoir-web-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "ssnoir-web-demo"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
