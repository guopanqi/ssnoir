{
  "name": "ssnoir-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:web": "vite build --outDir dist/web",
    "build:wechat": "vite build --config vite.wechat.config.ts && node --check dist/wechat/game.js && node scripts/package-wechat.mjs",
    "start:desktop": "electron .",
    "verify": "npm run typecheck && npm test && npm run build:web && npm run build:wechat",
    "capture": "node scripts/capture.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:wechat-harness": "node scripts/smoke-wechat-harness.mjs",
    "build:taptap": "npm run build:wechat && node scripts/build-taptap.mjs",
    "smoke:taptap-harness": "node scripts/smoke-taptap-harness.mjs",
    "smoke:wechat-no-offscreen": "SSNOIR_WX_CANVAS_MODE=missing npm run smoke:wechat-harness",
    "smoke:wechat-offscreen-throws": "SSNOIR_WX_CANVAS_MODE=throws npm run smoke:wechat-harness",
    "smoke:taptap-no-offscreen": "SSNOIR_WX_CANVAS_MODE=missing npm run smoke:taptap-harness"
  },
  "dependencies": {
    "biwascheme": "0.8.3",
    "pixi.js": "8.20.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "electron": "39.0.0",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "playwright": "1.55.0",
    "lips": "1.0.0-beta.23.1",
    "@babel/cli": "7.28.3",
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "terser": "5.44.1"
  }
}
