;; 触发事件的统一生命周期。固定创建与动态创建使用同一种对象；主线不通过这里。
;; effect 返回 #t 才占用本次互动并提交次数；#f 表示没有选中片段。
(define (make-triggered-event id timing activity eligible? effect cooldown limit chance . lifecycle)
  (if (and (string? id) (not (equal? id "")) (string? timing) (string? activity)
           (procedure? eligible?) (procedure? effect) (number? cooldown) (>= cooldown 0)
           (number? limit) (>= limit 0) (number? chance) (>= chance 0) (<= chance 100))
      #t (error "互动：非法声明"))
  (let ((last-day 0) (count 0) (ended? #f) (on-end (lambda () #f))
        (expires? (if (null? lifecycle) (lambda () #f) (list-ref (car lifecycle) 0)))
        (locations (if (null? lifecycle) '() (list-ref (car lifecycle) 1)))
        (factory (if (null? lifecycle) #f (list-ref (car lifecycle) 2))))
    (define (finished?) (or ended? (and (> limit 0) (>= count limit)) (expires?)))
    (define (commit!)
      (set! last-day (get-global '世界日)) (set! count (+ count 1))
      (if (finished?) (begin (set! ended? #t) (on-end)) #f))
    (define (finish! place action)
      (if (and (not (finished?)) (member? place locations)
               (eligible? (list (list "place" place) (list "timing" "进入地点")) )
               (procedure? action)) #t (error "触发事件：入口已经失效"))
      (commit!) (action))
    (lambda (msg . args)
      (cond
        ((eq? msg 'id) id)
        ((eq? msg 'ended?) (finished?))
        ((eq? msg 'on-end!)
          (if (procedure? (car args)) (set! on-end (car args)) (error "触发事件：非法结束回调")))
        ((eq? msg 'refresh!) (if (and (not ended?) (finished?))
          (begin (set! ended? #t) (on-end)) #f))
        ((eq? msg 'nodes-at)
          (let ((place (car args)))
            (if (and factory (not (finished?)) (member? place locations)
                (eligible? (list (list "place" place) (list "timing" "进入地点"))))
              (factory place (lambda (action) (finish! place action))) '())))
        ((eq? msg 'try!)
          (let ((context (car args)) (day (get-global '世界日)))
            (if (and (not factory) (not (finished?)) (equal? timing (assoc-get context "timing" ""))
                     (or (equal? activity "") (equal? activity (assoc-get context "activity" "")))
                     (or (= limit 0) (< count limit))
                     (or (= count 0) (>= day (+ last-day cooldown)))
                     (eligible? context)
                     (or (= chance 100) (< (__interaction-random-100) chance)))
              (let ((played? (effect context)))
                (cond ((equal? played? #t) (commit!) #t)
                      ((equal? played? #f) #f)
                      (else (error "互动效果必须返回#t或#f")))) #f)))
        ((eq? msg 'save) (list (list "ended" ended?) (list "last-day" last-day) (list "count" count)))
        ((eq? msg 'load!)
          (let ((data (car args)))
            (set! ended? (assoc-get data "ended" #f))
            (set! last-day (assoc-get data "last-day" 0))
            (set! count (assoc-get data "count" 0))
            (if (and (number? last-day) (>= last-day 0) (number? count) (>= count 0)
                     (or (= limit 0) (<= count limit))) #t (error "互动：非法存档"))))
        (else (error "互动：未知消息"))))))

(define (interaction-save interactions)
  (map (lambda (entry) (list (entry 'id) (entry 'save))) interactions))
(define (interaction-load! interactions data)
  (map (lambda (entry) (entry 'load! (assoc-get data (entry 'id) '()))) interactions))
(define (try-interactions! entries context)
  (cond ((null? entries) #f)
        (((car entries) 'try! context) #t)
        (else (try-interactions! (cdr entries) context))))

(define (interaction-nodes-at entries place)
  (apply append (map (lambda (entry) (entry 'nodes-at place)) entries)))

;; 动态集合保存具体事件实例，定义仅是重建实例的工厂，不是等待中的占位对象。
;; definitions = (("事件名" factory) ...)，factory(instance-id, payload) 返回普通触发事件。
(define (make-event-pool id definitions)
  (let ((instances '()) (attempts '()))
    (define (build definition source payload)
      (let ((factory (assoc-get definitions definition #f)))
        (if factory #t (error "触发事件：未声明的事件定义"))
        (let ((event (factory (string-append definition "@" source) payload)))
          (event 'on-end! (lambda ()
            (set! instances (filter (lambda (row) (not (equal? ((list-ref row 3) 'id) (event 'id)))) instances))))
          (list definition source payload event))))
    (define (objects) (map (lambda (row) (list-ref row 3)) instances))
    (define (collect!)
      (map (lambda (event) (event 'refresh!)) (objects))
      (set! instances (filter (lambda (row) (not ((list-ref row 3) 'ended?))) instances)))
    (lambda (msg . args)
      (cond
        ((eq? msg 'id) id)
        ((eq? msg 'refresh!) (collect!))
        ((eq? msg 'ended?) #f)
        ((eq? msg 'schedule!)
          (let ((definition (list-ref args 0)) (source (list-ref args 1))
                (payload (list-ref args 2)) (chance (list-ref args 3)))
            (if (and (string? source) (not (equal? source "")) (list? payload)
                     (number? chance) (>= chance 0) (<= chance 100)
                     (assoc-get definitions definition #f)) #t (error "触发事件：非法创建请求"))
            (if (member? source (assoc-get attempts definition '())) #f
              (begin
                (set! attempts (cons (list definition
                    (cons source (assoc-get attempts definition '())))
                  (filter (lambda (row) (not (equal? (car row) definition))) attempts)))
                (if (or (= chance 100) (< (__interaction-random-100) chance))
                  (begin (set! instances (append instances (list (build definition source payload)))) #t) #f)))))
        ((eq? msg 'try!) (collect!) (try-interactions! (objects) (car args)))
        ((eq? msg 'nodes-at) (interaction-nodes-at (objects) (car args)))
        ((eq? msg 'save)
          (collect!)
          (list (list "attempts" attempts)
            (list "instances" (map (lambda (row)
              (list (car row) (cadr row) (list-ref row 2) ((list-ref row 3) 'save))) instances))))
        ((eq? msg 'load!)
          (let ((data (car args)))
            (set! attempts (assoc-get data "attempts" '()))
            (set! instances (map (lambda (row)
              (if (= (length row) 4) #t (error "触发事件：非法实例存档"))
              (let ((instance (build (car row) (cadr row) (list-ref row 2))))
                ((list-ref instance 3) 'load! (list-ref row 3)) instance))
              (assoc-get data "instances" '())))))
        (else (error "触发事件集合：未知消息"))))))
