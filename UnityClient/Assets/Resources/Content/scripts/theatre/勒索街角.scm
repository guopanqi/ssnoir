;; 第三、四场共用的邮箱街角：沿用参考的邮箱左、报摊右构图，不绘制“邮”字。
(define (勒索街角-布景)
  (define 图形 (list (theatre-group "布景" "" 0 0)))
  (define (加入 o) (set! 图形 (append 图形 (list o))))
  (define (线 id color width points) (加入 (theatre-line id "布景" color width points)))
  (define (框 id x y w h color)
    (线 id color 2 (list (list x y) (list (+ x w) y) (list (+ x w) (+ y h))
      (list x (+ y h)) (list x y))))
  (线 "地面" "#5A6F9C" 1.5 '((0 790) (1600 790)))
  (线 "路沿" "#33466E" 1 '((0 806) (1600 806)))
  (框 "邮箱" 670 560 60 190 "#E6EEFF")
  (线 "邮箱顶" "#E6EEFF" 2.5 '((670 560) (675 543) (687 534) (713 534) (725 543) (730 560)))
  (框 "投信口" 680 592 40 8 "#9FB4E0")
  (线 "邮箱脚" "#9FB4E0" 2 '((690 750) (690 790) (710 790) (710 750)))
  (框 "报摊棚" 1110 430 320 36 "#E6EEFF")
  (框 "报摊架" 1150 500 240 110 "#9FB4E0")
  (框 "报摊柜" 1130 620 280 170 "#CFE0FF")
  (线 "摊上报纸" "#6F86B8" 1.5 '((1170 520) (1250 520) (1250 540) (1170 540) (1170 560) (1250 560)))
  (线 "摊上报纸右" "#6F86B8" 1.5 '((1290 520) (1370 520) (1370 540) (1290 540) (1290 560) (1370 560)))
  (加入 (theatre-with (theatre-glow "摊灯光" "布景" "#F3D08A" 1270 494 140 140) 'opacity .15))
  (加入 (theatre-glow "摊灯芯" "布景" "#FFE6A8" 1270 494 14 14))
  (加入 (theatre-focus "焦点" 800 576 .34 .62))
  图形)

(define (勒索街角-报纸)
  (list
    (theatre-with (theatre-group "报纸" "" 1070 598) 'opacity 0)
    (theatre-polygon "报纸面" "报纸" "#D8D2BC" '((-51 -56) (51 -56) (51 56) (-51 56)))
    (theatre-line "报纸字行" "报纸" "#8A846E" 2
      '((-39 -36) (39 -36) (39 -22) (-39 -22) (-39 -8) (19 -8)))
    (theatre-line "报纸下行" "报纸" "#8A846E" 2 '((-39 20) (39 20) (39 34) (-39 34)))
    (theatre-polygon "报纸窥孔" "报纸" "#080A10" '((-9 -6) (9 -6) (9 5) (-9 5)))))
