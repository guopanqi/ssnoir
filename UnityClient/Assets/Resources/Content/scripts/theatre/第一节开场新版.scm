      (theatre-sound "敲门" "StageSounds/老街酒馆/闷踢" #f .22 .5)
      (theatre-tween "门轴" 'scale-x .975 .07 'smooth)
      (theatre-tween "门轴" 'scale-x 1 .13 'smooth)
      (theatre-wait .35)))
    (开场新版-说 "旅馆老板" "尼尔？" 1.6)
    (开场新版-说 "尼尔" "谁？" 1.3)
    (theatre-parallel
      (theatre-tween "尼尔" 'y 790 1.1 'smooth)
      (theatre-tween "尼尔" 'rotation 2 1.1 'smooth))
    (theatre-sound "脚步" "StageSounds/老街酒馆/脚步" #f .18 -.2)
    (theatre-parallel
      (开场新版-说 "旅馆老板" "是我，我看你昨晚喝多了就没来打扰你。" 3.6)
      (theatre-tween "尼尔" 'x 1100 3.6 'smooth))
