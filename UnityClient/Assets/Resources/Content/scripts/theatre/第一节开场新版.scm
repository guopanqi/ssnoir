;; 参考 Claude C1/C2/C3/C13。旧版完整保留在第一节生活.scm，Debug 可分别试演。
;; 只有序幕的断片允许黑场换幕。其余镜头与人物从当前值 tween，不重置关键帧起点，
;; 不在可见状态切换立绘、翻转朝向或改变人体比例；缩放只作用于整套舞台。
;; 清晨与两次酒馆固定全景，让人物在画内表演；不随走位或说话人移动镜头。
;; 序幕只保留卡座聚焦与吧台独白两处缓推，街外和门厅固定观察。
(define (开场新版-框 id parent x y w h color)
  (theatre-line id parent color 1.8
    (list (list x y) (list (+ x w) y) (list (+ x w) (+ y h))
      (list x (+ y h)) (list x y))))
(define (开场新版-面 id parent x y w h color)
  (theatre-polygon id parent color
    (list (list x y) (list (+ x w) y) (list (+ x w) (+ y h)) (list x (+ y h)))))
(define (开场新版-人物 id parent asset x y opacity flip)
  (list
    (theatre-with (theatre-group id parent x y) 'opacity opacity)
    (theatre-with (theatre-image (string-append id "/像") id
      (string-append "Portraits/Neon/" asset) 0 0 308 308 "") 'scale-x flip)))
(define (开场新版-镜头 scale x y seconds)
  ;; 用同一舞台坐标下的观察中心算平移；构图改变时不更换 transform origin。
  (theatre-parallel
    (theatre-tween "镜头" 'scale-x scale seconds 'smooth)
    (theatre-tween "镜头" 'scale-y scale seconds 'smooth)
    (theatre-tween "镜头" 'x (- 800 (* scale x)) seconds 'smooth)
    (theatre-tween "镜头" 'y (- 570 (* scale y)) seconds 'smooth)))
(define (开场新版-说 who text seconds)
  (theatre-caption-for who text seconds
    (if (equal? who "尼尔") "#F0CF8A" "#D3DCE9")))
(define (开场新版-杯 id parent x y)
  (list (theatre-group id parent x y)
    (theatre-line (string-append id "/边") id "#BECBDD" 1.8
      '((-11 -29) (-8 0) (8 0) (11 -29) (-11 -29)))
    (theatre-line (string-append id "/水") id "#809CBF" 1 '((-8 -13) (8 -13)))))
(define (开场新版-擦杯 count)
  ;; 每次都回到零；和镜头、人物走位没有共享属性。
  (theatre-repeat count (theatre-sequence
    (theatre-tween "擦杯" 'rotation -9 .26 'smooth)
    (theatre-tween "擦杯" 'rotation 8 .30 'smooth)
    (theatre-tween "擦杯" 'rotation 0 .26 'smooth))))

(define (开场新版-酒馆初访) (开场新版-白天酒馆 #f))
(define (开场新版-酒馆再访) (开场新版-白天酒馆 #t))
(define (开场新版-白天酒馆 revisit?)
  (define 图形
    (append
      (list (theatre-with (theatre-group "幕" "" 0 0) 'opacity 0)
        (theatre-group "镜头" "幕" 0 0)
        (theatre-group "布景" "镜头" 0 0)
        (theatre-line "地面" "布景" "#465976" 1.8 '((-200 790) (1800 790)))
        (开场新版-框 "窗" "布景" 150 250 300 300 "#A0B6D9")
        (theatre-line "窗格" "布景" "#7184A2" 1.5 '((300 250) (300 550)))
        (theatre-line "窗横" "布景" "#7184A2" 1.5 '((150 400) (450 400)))
        (theatre-with (theatre-polygon "窗光" "布景" "#E8DCB0"
          '((150 550) (450 550) (780 790) (330 790))) 'opacity (if revisit? .035 .07))
        (开场新版-框 "酒架" "布景" 820 180 620 120 "#7184A2")
        (theatre-line "瓶架" "布景" "#A0B6D9" 2 '((810 465) (1500 465)))
        (开场新版-框 "瓶一" "布景" 850 402 24 63 "#7184A2")
        (开场新版-框 "瓶二" "布景" 980 414 28 51 "#7184A2")
        (开场新版-框 "瓶三" "布景" 1160 395 24 70 "#7184A2")
        (开场新版-框 "瓶四" "布景" 1350 410 24 55 "#7184A2")
        (theatre-with (theatre-glow "室内光" "布景" (if revisit? "#91ABCF" "#D4B17B")
          900 550 1400 1100) 'opacity .045))
      (开场新版-人物 "远客" "镜头" "路人男" 1480 790 .16 -1)
      (if revisit? '() (开场新版-人物 "窗边客" "镜头" "路人女" 240 790 .18 1))
      (开场新版-人物 "调酒师" "镜头" "调酒师" 1050 790 1 -1)
      ;; 尼尔从左侧画外走来；入场点在最宽画幅外，先显现再走，不在台上闪现。
      (开场新版-人物 "尼尔" "镜头" "尼尔_伸手" -420 790 1 1)
      (list (开场新版-面 "吧台实体" "镜头" 640 660 1060 200 "#07090F")
        (theatre-line "吧台边" "镜头" "#A7B0C0" 2.5 '((640 860) (640 660) (1700 660)))
        (开场新版-框 "杯垫" "镜头" 716 651 28 9 "#7184A2"))
      (开场新版-杯 "擦杯" "镜头" 1016 645)
      (开场新版-杯 "水杯" "镜头" 1016 660)))
  (play-theatre! (theatre-scene 1600 900 "#08090E" 图形)
    (theatre-tween "幕" 'opacity 1 .8 'smooth)
    (theatre-sound "人声" "StageSounds/老街酒馆/人群哗" #t (if revisit? .035 .065) 0)
    (theatre-sound "拿布" "StageSounds/老街酒馆/拿布" #f .18 .3)
    (开场新版-擦杯 2)
    (theatre-sound "脚步" "StageSounds/老街酒馆/脚步" #f .22 -.5)
    (theatre-parallel
      (theatre-tween "尼尔" 'x 540 (if revisit? 2.4 3.2) 'smooth)
      (theatre-sequence (theatre-wait 1.9)
        (theatre-tween "水杯" 'x 680 .9 'smooth)))
    (if revisit?
      (theatre-sequence
        ;; 同一杯水先搁在原处：尼尔急于报出委托，直到谈完才拿。
        (theatre-during (开场新版-说 "调酒师" "来了，今天还是——" 1.4) (开场新版-擦杯 1))
        (开场新版-说 "尼尔" "我接了个委托。" 1.7)
        (theatre-clear-caption)
        (theatre-wait .65)
        (开场新版-说 "调酒师" "又是哪个婚外情？" 2)
        (开场新版-说 "尼尔" "勒索案。" 1.5)
        (theatre-tween "擦杯" 'y 660 .5 'smooth)
        (theatre-parallel (theatre-tween "调酒师" 'x 960 .9 'smooth)
          (theatre-tween "擦杯" 'x 926 .9 'smooth))
        (开场新版-说 "调酒师" "大案子。你准备怎么做？" 2.6)
        (开场新版-说 "尼尔" "你这儿有挣得多一点的活吗？我需要一笔钱。" 3.6)
        (theatre-clear-caption)
        ;; 调酒师回到原处洗杯。杯与人一起平滑移动，没有道具换位。
        (theatre-parallel
          (theatre-tween "调酒师" 'x 1050 .9 'smooth)
          (theatre-tween "擦杯" 'x 1016 .9 'smooth)
          (theatre-tween "擦杯" 'y 645 .9 'smooth))
        (theatre-sound "拿布二" "StageSounds/老街酒馆/拿布" #f .16 .3)
        (开场新版-擦杯 3)
        (开场新版-说 "调酒师" "没有。有的话，我早就自己干了。" 3)
        (开场新版-说 "调酒师" "要不去码头看看？来钱快的零工就那么几样，不是脏就是累。" 4.8)
        (theatre-volume "人声" .018 .8)
        (theatre-parallel (theatre-tween "调酒师" 'x 960 .9 'smooth)
          (theatre-tween "擦杯" 'x 926 .9 'smooth))
        (开场新版-说 "调酒师" "最近几天晚上也有一些小道消息。" 2.9)
        (开场新版-说 "调酒师" "你看场子的时候多听听，说不定会有些委托，也能赚上一笔。" 4.8)
        (theatre-clear-caption)
        (theatre-tween "尼尔" 'rotation -2 .6 'smooth)
        (theatre-tween "尼尔" 'rotation 0 .7 'smooth)
        (theatre-parallel (theatre-tween "水杯" 'x 601 .7 'smooth)
          (theatre-tween "水杯" 'y 610 .7 'smooth))
        (theatre-wait .8)
        (theatre-parallel (theatre-tween "水杯" 'x 680 .8 'smooth)
          (theatre-tween "水杯" 'y 660 .8 'smooth)))
      (theatre-sequence
        (theatre-parallel (theatre-tween "水杯" 'x 601 .7 'smooth)
          (theatre-tween "水杯" 'y 610 .7 'smooth))
        (开场新版-说 "调酒师" "来了，最近侦探的活儿怎么样？" 2.6)
        (开场新版-说 "尼尔" "和之前差不多，没什么活儿可做。今天酒吧还需要人手吗？" 4.6)
        (theatre-parallel (theatre-tween "水杯" 'x 680 .7 'smooth)
          (theatre-tween "水杯" 'y 660 .7 'smooth))
        (theatre-during (开场新版-说 "调酒师" "还是老样子，帮我们看看场子，做完就结钱。" 3.6)
          (开场新版-擦杯 2))
        (theatre-tween "擦杯" 'y 660 .6 'smooth)
        (开场新版-说 "调酒师" "你如果真的缺钱的话，还是得找份正经的工作，这些零工是攒不到什么钱的。" 5.8)
        (theatre-clear-caption)
        (theatre-tween "尼尔" 'rotation 2 1.1 'smooth)
        (theatre-wait .6)
        (开场新版-说 "尼尔" "我再试试，再等等吧。" 2.2)
        (theatre-tween "尼尔" 'rotation 0 .7 'smooth)
        (开场新版-说 "尼尔" "说不定今天晚上就有什么重要的侦探委托，福尔摩斯那种。" 4.7)
        (开场新版-说 "尼尔" "现在放弃不就错过了？" 2.1)
        (theatre-clear-caption)
        ;; 笑意只用肩身很小的起伏，不切换姿势图。
        (theatre-parallel
          (theatre-sequence (theatre-tween "尼尔" 'rotation -1.5 .35 'smooth)
            (theatre-tween "尼尔" 'rotation 0 .65 'smooth))
          (theatre-sequence (theatre-wait .18)
            (theatre-tween "调酒师" 'rotation 1.5 .35 'smooth)
            (theatre-tween "调酒师" 'rotation 0 .65 'smooth)))))
    (theatre-clear-caption)
    (theatre-volume "人声" 0 .8)
    (theatre-tween "幕" 'opacity 0 .8 'smooth)))

(define (开场新版-清晨)
  (define 图形
    (append
