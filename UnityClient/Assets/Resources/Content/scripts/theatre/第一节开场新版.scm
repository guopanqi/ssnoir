    (theatre-tween "尼尔" 'rotation 4 .8 'smooth)
    (开场新版-说 "旅馆老板" "干不下去的话也可以和我说，我给你介绍点别的活儿。" 4.2)
    (theatre-clear-caption)
    (theatre-wait .9)
    (开场新版-说 "尼尔" "谢谢了……" 1.8)
    (theatre-clear-caption)
    (theatre-tween "尼尔" 'rotation 0 1.3 'smooth)
    (开场新版-说 "尼尔" "房钱我两天后给你。" 2.1)
    (theatre-clear-caption)
    (theatre-parallel (theatre-tween "老板" 'x 1430 1.4 'smooth)
      (theatre-tween "老板" 'opacity 0 1.4 'smooth))
    (theatre-parallel (theatre-tween "门轴" 'scale-x 1 1 'smooth)
      (theatre-tween "走廊光" 'opacity 0 1 'smooth))
    (theatre-wait .6)
    (theatre-tween "幕" 'opacity 0 .8 'smooth)))

(define (开场新版-序幕)
  (define 图形 '())
  (define (加 xs) (set! 图形 (append 图形 xs)))
  (define (框 id parent x y w h)
    (加 (list (开场新版-框 id parent x y w h "#7184A2"))))
  (define (线 id parent points)
    (加 (list (theatre-line id parent "#7184A2" 1.8 points))))
  (define (桌 id parent x y w h)
    (加 (list (开场新版-面 id parent x y w h "#07090F")))
    (框 (string-append id "/边") parent x y w h))
  (define (换幕 from to)
    (theatre-sequence
      (theatre-clear-caption)
      ;; 同值首帧仅用于明确的黑场剪辑；镜头复位发生在黑幕内。
      (theatre-animate "幕" 'opacity '((0 0) (.001 0)))
      (theatre-tween from 'opacity 0 .1)
      (开场新版-镜头 1 800 570 .1)
      (theatre-wait 1.3)
      (theatre-tween to 'opacity 1 .1)
      (theatre-animate "幕" 'opacity '((0 1) (.001 1)))))
  (加 (list (theatre-with (theatre-group "幕" "" 0 0) 'opacity 0)
    (theatre-group "镜头" "幕" 0 0)
    (theatre-group "卡座" "镜头" 0 0)
