;; 第一节的五组日常演出。只负责表现；日期、开放、报酬与招募归城市模块。
;; 人物画布统一308，地面790。黑幕转场在同一场舞台内完成，不闪回城市。
(define (第一节-对白 who x text seconds)
  (theatre-during
    (theatre-caption-for who text seconds (if (equal? who "尼尔") "#F0CF8A" "#D3DCE9"))
    (theatre-parallel
      (theatre-tween "说话光" 'x x .6 'smooth)
      (theatre-tween "焦点" 'x (+ 800 (* (- x 800) .35)) .6 'smooth))))

(define (第一节-酒馆初访) (第一节-会面 '初访))
(define (第一节-酒馆接案后) (第一节-会面 '接案))
(define (第一节-艾迪相识) (第一节-会面 '艾迪))

(define (第一节-会面 mode)
  (define dock? (eq? mode '艾迪))
  (define 图形 '())
  (define 描线 '())
  (define (加 object) (set! 图形 (append 图形 (list object))))
  (define (线 id points color)
    (加 (theatre-with (theatre-line id "布景" color 1.8 points) 'reveal 0))
    (set! 描线 (append 描线 (list (theatre-tween id 'reveal 1 1.4 'smooth)))))
  (define (框 id x y w h)
    (线 id (list (list x y) (list (+ x w) y) (list (+ x w) (+ y h))
      (list x (+ y h)) (list x y)) "#7184A2"))
  (define (说 who text seconds)
    (第一节-对白 who (if (equal? who "尼尔") 700 1100) text seconds))
  (加 (theatre-with (theatre-group "画面" "" 0 0) 'opacity 0))
  (加 (theatre-group "布景" "画面" 0 0))
  (线 "地面" '((80 790) (1520 790)) "#465976")
  (if dock?
    (begin
      (框 "货箱一" 280 485 220 305)
      (框 "货箱二" 1160 570 260 220)
      (框 "货箱三" 1200 415 180 155)
      (线 "箱带一" '((330 485) (330 790)) "#465976")
      (线 "箱带二" '((1235 415) (1235 570)) "#465976")
      (线 "远船" '((150 390) (470 390) (510 355) (1350 355) (1410 390)) "#374963")
      (线 "缆绳" '((1220 200) (1320 355) (1490 440)) "#374963"))
    (begin
      (线 "墙线" '((200 330) (1410 330)) "#374963")
      (框 "酒架" 925 295 430 100)
      (线 "酒架层" '((930 350) (1350 350)) "#465976")
      (框 "瓶一" 970 310 22 40)
      (框 "瓶二" 1040 305 20 45)
      (框 "瓶三" 1170 313 24 37)
      (框 "门框" 250 420 140 370)
      (线 "吊灯" '((765 80) (765 230) (715 285) (815 285) (765 230)) "#7C8CA6")))
  (加 (theatre-with (theatre-glow "背景光" "画面" "#BD9668" 920 430 1600 1150) 'opacity .035))
  (加 (theatre-focus "焦点" 800 570 .20 .52))
  (加 (theatre-with (theatre-glow "说话光" "画面" "#8FB4E8" 1100 560 600 840) 'opacity .10))
  (加 (theatre-group "尼尔位置" "画面" 700 790))
  (加 (theatre-image "尼尔" "尼尔位置" "Portraits/Neon/尼尔" 0 0 308 308 ""))
  (加 (theatre-group "对方位置" "画面" 1100 790))
  (加 (theatre-with (theatre-image "对方" "对方位置"
    (if dock? "Portraits/Neon/艾迪" "Portraits/Neon/调酒师") 0 0 308 308 "") 'scale-x -1))
  ;; 桌面置于人物前，遮挡由实际人物轮廓与桌面共同建立。
  (加 (theatre-polygon "桌面实体" "画面" "#06080D"
    (if dock? '((820 680) (980 680) (980 790) (820 790))
      '((780 650) (1430 650) (1430 790) (780 790)))))
  (加 (theatre-line "桌边" "画面" "#A7B0C0" 2
    (if dock? '((820 790) (820 680) (980 680) (980 790))
      '((780 790) (780 650) (1430 650) (1430 790)))))
  (加 (theatre-group "杯位置" "画面" (if dock? 890 1190) (if dock? 678 648)))
  (加 (theatre-line "杯子" "杯位置" "#BECBDD" 1.6
    (if dock? '((-30 0) (-30 -20) (35 -20) (35 0) (-30 0))
      '((-10 -29) (-8 0) (8 0) (10 -29) (-10 -29)))))
  (加 (theatre-with (theatre-line "杯中水" "杯位置" "#809CBF" 1 '((-7 -13) (7 -13)))
    'opacity (if dock? 0 1)))
  (加 (theatre-with (theatre-line "擦杯布" "画面" "#758399" 1
    '((1160 635) (1195 634) (1202 641) (1163 642))) 'opacity (if dock? 0 .6)))
  (play-theatre! (theatre-scene 1600 900 "#06080D" 图形)
    (theatre-parallel (theatre-tween "画面" 'opacity 1 .6)
      (apply theatre-parallel 描线))
    (cond
      ((eq? mode '初访)
       (theatre-sequence
         (theatre-sound "擦杯" "StageSounds/老街酒馆/拿布" #f .20 .35)
         (theatre-animate "杯位置" 'rotation '((0 0) (.25 -8) (.5 6) (.75 0)))
         (说 "调酒师" "今天还是没什么生意？" 2)
         (说 "尼尔" "没有。没有名气也就没人找你，这行就是这样。今天还是和以前一样？" 4.8)
         (theatre-image-to "尼尔" "Portraits/Neon/尼尔_伸手")
         (theatre-tween "杯位置" 'x 810 .7 'smooth)
         (说 "调酒师" "嗯，还是按老板说的，日结。替我看着点客人，别让他们把杯子扔出去。" 5)
         (说 "调酒师" "真要缺钱的话，就找份固定的活。这儿只能让你顶几班。" 4)
         (theatre-image-to "尼尔" "Portraits/Neon/尼尔_抱臂")
         (说 "尼尔" "固定工作？有人有委托找我怎么办？" 2.8)
         (theatre-tween "对方位置" 'rotation -2 .25)
         (说 "调酒师" "嘿，看来你还是没放弃。" 2.2)))
      ((eq? mode '接案)
       (theatre-sequence
         (说 "调酒师" "今天还是——" 1.1)
         (theatre-image-to "尼尔" "Portraits/Neon/尼尔_伸手")
         (说 "尼尔" "我接了个委托。" 1.5)
         (说 "调酒师" "这次是怎么回事儿？" 1.8)
         (说 "尼尔" "勒索。有人拿照片找她要钱。" 2.5)
         (说 "调酒师" "她付你多少？" 1.5)
         (说 "尼尔" "她没多少钱。" 1.5)
         (说 "调酒师" "所以现在是你替她找钱？" 2.2)
         (说 "尼尔" "你这里有挣得快一点的活吗？" 2.6)
         (theatre-tween "杯位置" 'rotation 5 .15)
         (说 "调酒师" "有的话，我自己先干了。" 2.1)
         (theatre-tween "杯位置" 'rotation 0 .2)
         (theatre-image-to "尼尔" "Portraits/Neon/尼尔_抱臂")
         (theatre-wait .7)
         (说 "调酒师" "去码头看看？日结的工作就那么几样，那儿比这儿累，钱也更多一点。" 4.8)
         (说 "调酒师" "最近几天晚上也有些小道消息。看场的时候多听听，别老站在门口。" 4.5)))
      ((eq? mode '艾迪)
       (theatre-sequence
         (说 "艾迪" "你最近是不是在找人？" 2)
         (说 "尼尔" "对，有一些事，和一些混混有关。" 2.6)
         (theatre-tween "对方位置" 'x 1050 .6)
         (说 "艾迪" "用不用我帮忙？我把他们打得落花流水。" 3)
         (说 "尼尔" "不用，他是……" 1.6)
         (theatre-wait .55)
         (theatre-image-to "尼尔" "Portraits/Neon/尼尔_伸手")
         (说 "尼尔" "对啊，也许可以换个办法。艾迪，你听我说。" 3.1)
         (说 "尼尔" "有人拿照片勒索，让我的委托人把钱放进邮箱。" 3.3)
         (说 "艾迪" "咱们在那儿埋伏着。他一伸手，就把他按住。" 3.1)
         (说 "艾迪" "你送给他一次，还有下一次，会没完没了的。" 3)
         (说 "艾迪" "什么时候？" 1.2)
         (说 "尼尔" "就在信上约定的那天晚上。" 2.3)
         (说 "艾迪" "那天我有班。你替我把这批活干完，我就能把那晚的班换开。" 4)
         (说 "尼尔" "成交。" 1.1)))
      (else (error "第一节会面：未知模式")))
    (theatre-clear-caption)
    (theatre-wait .5)
    (theatre-tween "画面" 'opacity 0 .5)))

;; 清晨故意只有黑幕、敲门与字幕，不让人物突然站到城市对白舞台。
(define (第一节-清晨敲门)
  (play-theatre! (theatre-scene 1600 900 "#000000"
    (list (theatre-polygon "黑幕" "" "#000000" '((0 0) (1600 0) (1600 900) (0 900)))))
    (theatre-repeat 3 (theatre-sequence
      (theatre-sound "敲门" "StageSounds/老街酒馆/闷踢" #f .22 -.25)
      (theatre-wait .28)))
    (theatre-caption-for "旅馆老板" "尼尔？" 1.4 "#D3DCE9")
    (theatre-caption-for "尼尔" "谁？" 1.2 "#F0CF8A")
    (theatre-caption-for "旅馆老板" "我，你又喝多了？" 1.8 "#D3DCE9")
    (theatre-caption-for "尼尔" "哦，老板，你有事儿吗？" 2 "#F0CF8A")
    (theatre-caption-for "旅馆老板" "我是跟你说房钱的事情，你这间房该续了。" 3.3 "#D3DCE9")
    (theatre-caption-for "尼尔" "能等我两天吗？" 1.7 "#F0CF8A")
    (theatre-caption-for "旅馆老板" "没事儿。尼尔，你要不……" 2.4 "#D3DCE9")
    (theatre-wait .6)
    (theatre-caption-for "旅馆老板" "还是找份正经活儿吧。你那些委托，没法养活自己。" 3.8 "#D3DCE9")
    (theatre-caption-for "尼尔" "两天后给你。" 1.5 "#F0CF8A")
    (theatre-wait .5)
    (theatre-caption-for "尼尔" "我得先弄点钱。还是去酒馆吧，至少那儿还有些事做。" 3.8 "#F0CF8A")
    (theatre-clear-caption)))

(define (第一节-醉归)
  (define 图形 '())
  (define 描线 '())
  (define (加 object) (set! 图形 (append 图形 (list object))))
  (define (组 id parent x y opacity)
    (加 (theatre-with (theatre-group id parent x y) 'opacity opacity)))
  (define (线 id parent points color)
    (加 (theatre-with (theatre-line id parent color 1.8 points) 'reveal 0))
    (set! 描线 (append 描线 (list (theatre-tween id 'reveal 1 1.25 'smooth)))))
  (define (框 id parent x y w h)
    (线 id parent (list (list x y) (list (+ x w) y) (list (+ x w) (+ y h))
      (list x (+ y h)) (list x y)) "#7385A1"))
  (define (人物 id parent asset x y opacity)
    (组 id parent x y opacity)
    (加 (theatre-image (string-append id "/像") id asset 0 0 308 308 "")))
  (define (遮桌 id parent x y w h)
    (加 (theatre-polygon id parent "#07090F"
      (list (list x y) (list (+ x w) y) (list (+ x w) (+ y h)) (list x (+ y h)))))
    (框 (string-append id "/边") parent x y w h))
  (define (换幕 from to)
    (theatre-sequence
      (theatre-clear-caption)
      (theatre-tween "幕" 'opacity 0 .06)
      (theatre-tween from 'opacity 0 .001)
      (theatre-wait .23)
      (theatre-tween to 'opacity 1 .001)
      (theatre-tween "幕" 'opacity 1 .45)))
  (组 "幕" "" 0 0 0)
  (组 "卡座" "幕" 0 0 1)
  (组 "吧台" "幕" 0 0 0)
  (组 "街外" "幕" 0 0 0)
  (组 "门厅" "幕" 0 0 0)
  (加 (theatre-focus "焦点" 800 570 .16 .48))
  (加 (theatre-with (theatre-glow "说话光" "幕" "#8FB4E8" 660 560 600 840) 'opacity .08))
  ;; 热闹的卡座：背景人只有轮廓，桌面遮住人物下半身，舞台不缩放人体冒充坐姿。
  (框 "卡座靠背" "卡座" 455 560 360 230)
  (框 "卡座灯" "卡座" 530 260 230 160)
  (线 "卡座墙线" "卡座" '((170 420) (1450 420)) "#354761")
  (人物 "客人一" "卡座" "Portraits/Neon/路人男" 300 790 .28)
  (人物 "客人二" "卡座" "Portraits/Neon/路人女" 1100 790 .25)
  (人物 "客人三" "卡座" "Portraits/Neon/路人男2" 1260 790 .2)
  (人物 "客人四" "卡座" "Portraits/Neon/路人女2" 960 790 .16)
  (人物 "客人五" "卡座" "Portraits/Neon/路人男" 1440 790 .14)
  (人物 "醉客" "卡座" "Portraits/Neon/尼尔_伸手" 650 790 1)
  (组 "酒杯" "卡座" 730 640 1)
  (加 (theatre-line "举杯轮廓" "酒杯" "#D9B57C" 1.8 '((-12 -30) (-10 0) (10 0) (12 -30) (-12 -30))))
  (遮桌 "卡座桌" "卡座" 500 665 390 160)
  ;; 吧台断片：姿态更低，杯子搁下，背景人声压远。
  (框 "吧台酒架" "吧台" 930 320 410 100)
  (人物 "吧台尼尔" "吧台" "Portraits/Neon/尼尔_靠墙" 760 810 1)
  (人物 "夜间调酒师" "吧台" "Portraits/Neon/调酒师" 1150 790 .55)
  (遮桌 "吧台前沿" "吧台" 650 660 750 180)
  (框 "搁下的杯" "吧台" 815 632 20 28)
  ;; 酒馆外。
  (框 "酒馆门" "街外" 450 425 180 365)
  (框 "酒馆外墙" "街外" 350 280 600 510)
  (线 "街沿" "街外" '((0 790) (1600 790)) "#354761")
  (线 "霓虹杯" "街外" '((475 330) (600 330) (538 395) (475 330) (538 395) (538 435)) "#B75A68")
  (加 (theatre-with (theatre-glow "门外暖光" "街外" "#C49B68" 550 650 900 1000) 'opacity .07))
  (人物 "街外尼尔" "街外" "Portraits/Neon/尼尔_醉行" 570 790 1)
  ;; 旅馆门厅：老板只喊一声，催账留到清晨。
  (框 "旅馆后窗" "门厅" 1080 290 240 200)
  (线 "旅馆地面" "门厅" '((100 790) (1500 790)) "#354761")
  (线 "楼梯" "门厅" '((170 790) (220 790) (220 755) (270 755) (270 720) (320 720) (320 685)) "#7385A1")
  (人物 "老板位置" "门厅" "Portraits/Neon/旅馆老板" 1160 790 1)
  (人物 "归来尼尔" "门厅" "Portraits/Neon/尼尔_醉行" 770 790 1)
  (遮桌 "旅馆柜台" "门厅" 1000 650 400 140)
  (play-theatre! (theatre-scene 1600 900 "#07090F" 图形)
    (theatre-parallel (theatre-tween "幕" 'opacity 1 1)
      (apply theatre-parallel 描线))
    (theatre-sound "酒馆喧哗" "StageSounds/老街酒馆/人群哗" #t .14 0)
    (theatre-sound "酒馆钢琴" "StageSounds/剧院/钢琴" #t .08 -.4)
    (theatre-tween "酒杯" 'y 625 .4)
    (第一节-对白 "尼尔" 650 "贝尔维尔，不夜城！酒！女人！多么好的地方！喝！" 4)
    (theatre-animate "醉客" 'rotation '((0 0) (.3 -4) (.7 3) (1.1 0)))
    (换幕 "卡座" "吧台")
    (theatre-volume "酒馆喧哗" .05 .5)
    (theatre-tween "吧台尼尔" 'rotation 8 .6)
    (第一节-对白 "尼尔" 760 "私家侦探？听着像那么回事，其实什么也不是！" 3.7)
    (theatre-wait .8)
    (换幕 "吧台" "街外")
    (theatre-volume "酒馆喧哗" .015 .5)
    (theatre-volume "酒馆钢琴" .025 .5)
    (theatre-parallel
      (theatre-tween "街外尼尔" 'x 780 2.4 'smooth)
      (theatre-animate "街外尼尔" 'rotation '((0 0) (.6 4) (1.2 -3) (1.8 4) (2.4 0))))
    (theatre-image-to "街外尼尔/像" "Portraits/Neon/尼尔_扶墙")
    (theatre-wait .5)
    (theatre-animate "街外尼尔" 'rotation '((0 0) (.35 10) (.7 4) (1 12) (1.4 0)))
    (theatre-sound "喘息" "StageSounds/室内求助/叹息" #f .22 .1)
    (theatre-wait .8)
    (换幕 "街外" "门厅")
    (theatre-stop-sound "酒馆喧哗")
    (theatre-stop-sound "酒馆钢琴")
    (theatre-sound "门厅脚步" "StageSounds/老街酒馆/脚步" #f .3 -.15)
    (theatre-tween "归来尼尔" 'x 550 1.8)
    (第一节-对白 "旅馆老板" 1160 "尼尔？" 1.3)
    (theatre-clear-caption)
    (theatre-parallel
      (theatre-tween "归来尼尔" 'x 270 2.5)
      (theatre-animate "归来尼尔" 'rotation '((0 0) (.6 4) (1.2 -3) (1.8 4) (2.5 0))))
    (theatre-parallel (theatre-tween "归来尼尔" 'y 720 1)
      (theatre-tween "归来尼尔" 'opacity 0 1))
    (theatre-wait .6)
    (theatre-tween "幕" 'opacity 0 .8)))
