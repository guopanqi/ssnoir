;; 独立线绘舞台样板：移植 experiments/立绘剧场 · 线绘世界 · Claude Sonnet 5.5.html 的路灯片段。
;; 布景、表演和本场组合函数各有边界；不读写剧情状态，不替换正式剧情。
(define (路灯下-布景)
  (define (描线 id color width points)
    (theatre-with (theatre-line id "布景" color width points) 'reveal 0))
  (define (路面刻线 i)
    (if (= i 8) '()
      (let ((x (+ 80 (* i 190))))
        (cons (描线 (string-append "路面/" (number->string i)) "#46608F" 3
                (list (list x 860) (list (+ x 90) 860)))
              (路面刻线 (+ i 1))))))
  (theatre-scene 1600 900 "#08090F"
    (append
      (list
        (theatre-with (theatre-group "布景" "" 0 0) 'opacity 0)
        (描线 "地面" "#5A6F9C" 1.5 '((0 790) (1600 790)))
        (描线 "路沿" "#33466E" 1 '((0 806) (1600 806))))
      (路面刻线 0)
      (list
        (描线 "灯杆左" "#CFE0FF" 2 '((794 790) (794 282)))
        (描线 "灯杆右" "#CFE0FF" 2 '((806 790) (806 282)))
        (描线 "灯座" "#CFE0FF" 2 '((778 790) (822 790) (822 770) (778 770) (778 790)))
        (描线 "灯罩" "#E6EEFF" 2.5 '((768 272) (832 272) (816 228) (784 228) (768 272)))
        (描线 "灯顶" "#CFE0FF" 2 '((800 228) (800 212)))
        ;; 一盏逻辑灯控制整套可见光，也控制绑定人物的照明。
        (theatre-light "路灯" "布景" "#F3D08A" 800 550 620 0)
        (theatre-polygon "光锥" "路灯" "#F3D08A18" '((-8 -280) (8 -280) (240 240) (-240 240)))
        (theatre-glow "地面光池" "路灯" "#F3D08A66" 0 240 620 76)
        (theatre-line "光池外圈" "路灯" "#D9B86A66" 1.5 (theatre-ellipse-points 0 240 250 24))
        (theatre-line "光池内圈" "路灯" "#D9B86A44" 1.5 (theatre-ellipse-points 0 240 165 15))
        (theatre-glow "灯泡光晕" "路灯" "#F3D08A88" 0 -284 140 140)
        (theatre-glow "灯芯" "路灯" "#FFE6A8" 0 -286 30 30)
        (theatre-glow "路灯柔光" "路灯" "#F3D08A44" 0 0 660 820)
        (theatre-with (theatre-image "尼尔" "" "Portraits/Neon/尼尔_抱臂" -180 790 450 550 "路灯") 'opacity 0)
        (theatre-with
          (theatre-with (theatre-image "夜莺" "" "Portraits/Neon/夜莺_低头" 1780 790 450 550 "路灯") 'scale-x -1)
          'opacity 0)))))

;; 本场的描线顺序：地面 -> 灯杆 -> 灯罩。组合留在本场，不塞进公共引擎。
(define (路灯下-画路面)
  (define (刻线 i)
    (if (= i 8) '()
      (append (theatre-tween (string-append "路面/" (number->string i)) 'reveal 1 1.5) (刻线 (+ i 1)))))
  (apply theatre-parallel
    (list
      (theatre-tween "布景" 'opacity 1 0.6)
      (theatre-tween "地面" 'reveal 1 1.8)
      (theatre-tween "路沿" 'reveal 1 1.8)
      (刻线 0))))
(define (路灯下-闪烁)
  (theatre-parallel
    (theatre-animate "路灯" 'brightness
      '((0 1) (0.04 0.15) (0.11 0.15) (0.13 1)
        (0.22 1) (0.24 0.3) (0.33 0.3) (0.35 0.9)
        (0.44 0.9) (0.46 0.5) (0.55 0.5) (0.57 1) (0.66 1)))
    (theatre-sound "电流" "Theatre/路灯电流" #f 0.28 0)))
(define (路灯下-试演!)
  (play-theatre! (路灯下-布景)
    (路灯下-画路面)
    (theatre-parallel
      (theatre-tween "灯杆左" 'reveal 1 1.4)
      (theatre-tween "灯杆右" 'reveal 1 1.4)
      (theatre-tween "灯座" 'reveal 1 1))
    (theatre-parallel
      (theatre-tween "灯罩" 'reveal 1 1.2)
      (theatre-tween "灯顶" 'reveal 1 1))
    (路灯下-闪烁)
    (theatre-parallel
      (theatre-tween "尼尔" 'opacity 1 0.6)
      (theatre-tween "夜莺" 'opacity 1 0.6)
      (theatre-tween "尼尔" 'x 470 2.8)
      (theatre-tween "夜莺" 'x 1130 2.8)
      (theatre-sound "脚步" "StageSounds/老街酒馆/脚步" #f 0.4 -0.3))
    (theatre-say "尼尔" "现在可以说了？")
    (theatre-image-to "夜莺" "Portraits/Neon/夜莺_低头")
    (theatre-say "夜莺" "莱恩是我……之前的男朋友。")
    (theatre-say "尼尔" "继续。")
    (theatre-say "夜莺" "他不会做出这样的事情来。他，他怎么会这样？")
    (theatre-parallel
      (theatre-tween "尼尔" 'x 540 0.7)
      (theatre-image-to "尼尔" "Portraits/Neon/尼尔_逼近"))
    (theatre-say "尼尔" "第一次的时候我就问过你，你为什么没有告诉我？")
    (theatre-tween "夜莺" 'x 1100 0.5)
    (theatre-say "夜莺" "我不能确定，而且我觉得你会不愿意管。")
    (theatre-say "夜莺" "一个没钱的女孩，一个以前的男人。")
    (theatre-say "夜莺" "如果我真的告诉你，你还会帮我吗？")
    (theatre-tween "路灯" 'brightness 0.6 0.7)
    (theatre-wait 1)
    (路灯下-闪烁)
    (theatre-image-to "尼尔" "Portraits/Neon/尼尔_抱臂")
    (theatre-say "尼尔" "也许会，也许不会，我不知道。")
    (theatre-say "夜莺" "分手之后，他找过我，我总是甩掉他。")
    (theatre-say "夜莺" "后来我离开老街，他到剧院找我，但都被保安拦住了。")
    (theatre-say "夜莺" "我们没有再见过面了。")
    (theatre-say "尼尔" "你还有什么是瞒着我的？")
    (theatre-tween "夜莺" 'x 1070 0.5)
    (theatre-say "夜莺" "没有了，尼尔，我知道的就这些了，真的。")
    (theatre-tween "路灯" 'brightness 0.5 0.8)
    (theatre-wait 1.4)
    (路灯下-闪烁)
    (theatre-image-to "夜莺" "Portraits/Neon/夜莺_仰头")
    (theatre-say "夜莺" "我知道他住的地方，我们去看看吧。")
    (theatre-animate "夜莺" 'scale-x '((0 1) (0.01 1)))
    (theatre-tween "夜莺" 'x 1850 4.8)
    (theatre-wait 1.2)
    (theatre-tween "尼尔" 'x 1850 4.8)
    (路灯下-闪烁)
    (theatre-tween "路灯" 'brightness 0.6 1)
    (theatre-wait 1.5)
    (theatre-tween "布景" 'opacity 0 1.2)))
