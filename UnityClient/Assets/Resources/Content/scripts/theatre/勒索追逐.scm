        (6.19000 0.0000) (6.78999 1600.0000) (6.79000 0.0000) (7.30000 1360.0000) (7.39992 1600.0000)
        (7.39993 0.0000) (7.58000 432.4978) (7.86000 1030.8267) (8.14000 1554.9867) (8.16800 1600.0000)
