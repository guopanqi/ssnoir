      (theatre-animate "远街" 'x '(
        (0.00000 0.0000) (0.14000 3.4844) (0.28000 10.4533) (0.42000 20.9067) (0.56000 34.8444)
        (0.70000 52.2667) (0.84000 73.1733) (0.98000 97.5644) (1.12000 125.4400) (1.26000 156.8000)
