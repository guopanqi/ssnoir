 ;; 第一幕的临时 Dialogue 表现；剧情事实由 world/第一幕.scm 持有。
(define (第一幕-清晨)
  (play-dialogue!
    (line "世界" "窗帘没拉严。尼尔数了数桌上的零钱，把房租单压回下面。")
    (line "尼尔" "这点钱……")
    (line "旅馆老板" "房钱别忘了。")
    (line "尼尔" "没忘，我过两天给你。")
    (line "尼尔" "还是先去酒吧打听打听吧。")))
(define (第一幕-酒馆)
  (play-dialogue!
    (line "调酒师" "又没活儿了？") (line "尼尔" "有就不来问你了。")
    (line "调酒师" "码头、咖啡馆都有零工可做。")
    (line "调酒师" "码头工钱高，活重。咖啡馆挣得少，省点力气。")
    (line "尼尔" "你这儿呢？")
    (line "调酒师" "还是和以前一样，看场子。有人闹事就你来处理。")
    (line "世界" "小舞台的灯亮了。夜莺扶正麦克风，等伴奏过去，开口唱起来。")
    (line "世界" "歌声停下时，台下响起掌声。她朝乐手点了点头。")
    (line "尼尔" "她是谁？") (line "调酒师" "夜莺。就快去大剧院了。")
    (line "尼尔" "那里会要我们这儿的人？") (line "调酒师" "也许是她唱得好吧。")))
(define (第一幕-酒馆消息)
  (play-dialogue!
    (line "调酒师" "第五天，夜莺要在大剧院彩排。剧院的人说，酒馆这边也能去看。")
    (line "尼尔" "他们请了整个酒馆？")
    (line "夜莺" "你也来吧。那天我会在台上。")
    (line "尼尔" "好，第五天见。")))
(define (第一幕-露西初识 dock-worked?)
  (play-dialogue!
    (line "世界" "露西接住托盘上晃动的杯子，把它放稳。")
    (line "露西" "你是新来的？") (line "尼尔" "嗯。")
    (line "露西" "只干今天？") (line "尼尔" "看老板明天还要不要我。")
    (line "露西" "先学会把杯子摆平。")
    (line "露西" (if dock-worked? "你之前在码头干过活？袖子上还有煤灰。"
      "你以前干什么的？看起来不像常端盘子的人。"))
    (line "尼尔" "哪儿有活儿就去哪儿。")
    (line "露西" "明天要是还来，记得从后面拿托盘，别挡住客人。")))
(define (第一幕-露西打字)
  (play-dialogue!
    (line "世界" "露西在报纸背面写字。听见脚步，她把纸倒扣过来。")
    (line "露西" "你来了。今天还是端盘子？最近有没有别的活儿？")
    (line "尼尔" "没有，老板肯给钱，我就能干。")
    (line "露西" "那你会打字吗？") (line "尼尔" "不会。怎么？")
    (line "露西" "我想学。城里有个夜校，教打字和记账。")
    (line "露西" "我以后想找一份不用站一整天的活儿。")
    (line "尼尔" "这字不是挺好的吗？")
    (line "露西" "这是用笔写的。打字机可不管你写得好不好看。")
    (line "世界" "外面有人点单。她把报纸收进抽屉，跑去招呼客人。")))
(define (第一幕-艾迪初识 grade)
  (play-dialogue!
    (line "世界" "木箱卡在接缝里。工头喊着让开通道，艾迪走来搭了把手。")
    (line "艾迪" (cond ((eq? grade '好) "不错嘛，第一天就知道找省力的办法。")
      ((eq? grade '中) "下次先绑好，省得一路追箱子。")
      (else "手先松开。别跟一只箱子拼命。")))
    (line "尼尔" (cond ((eq? grade '好) "我只是怕砸着脚。")
      ((eq? grade '中) "你们都这么干？") (else "我差一点就搬起来了。")))
    (line "艾迪" (cond ((eq? grade '好) "那也是个办法。")
      ((eq? grade '中) "会搬的人都这么干。") (else "差一点和搬起来，是两回事。")))
    (line "艾迪" "第一次来？") (line "尼尔" "有这么明显？")
    (line "艾迪" "太明显了。我叫艾迪。明天来得早，站我那边。")))
(define (第一幕-艾迪再见)
  (play-dialogue!
    (line "艾迪" "嘿！又来了。") (line "尼尔" "你不是让我站你那边？")
    (line "艾迪" "没叫你天天来。") (line "尼尔" "工钱比别处高。")
    (line "艾迪" "那你算来对地方了。下班请你吃点好的。")))
(define (第一幕-艾迪邀请)
  (play-dialogue!
    (line "艾迪" "今天下工以后去酒馆坐坐？")
    (line "尼尔" "怎么突然请我？")
    (line "艾迪" "你今天搬了半天货，怕你回去还梦见箱子。")))
(define (第一幕-艾迪喝酒)
  (play-dialogue!
    (line "世界" "艾迪把两只杯子推到靠墙的小桌上。")
    (line "尼尔" "你每天都来？")
    (line "艾迪" "手里有钱就来，没钱就在门口跟人打招呼。")
    (line "尼尔" "听着也挺忙。") (line "艾迪" "你以为认识这么多人是白认识的？")
    (line "艾迪" "以前我还打过拳。他们现在都不肯跟我打了。")
    (line "尼尔" "为什么？") (line "艾迪" "怕我赢。还有一次是怕我输得太难看。")
    (line "艾迪" "你呢？打算一直这样到处找活儿？")))
(define (第一幕-彩排 mode)
  (play-dialogue!
    (line "世界" "剧院座椅空着。夜莺站在工作灯下，唱了一段，又从第二段重来。")
    (line "世界" "第二次开口时，几个工作人员停下了手里的活。")
    (line "导演" "行。今天先到这里。")
    (line "世界" "她留在台上，望着一排排空座位。"))
  (cond
    ((eq? mode '同行)
    (play-dialogue!
      (line "夜莺" "你什么时候来的？") (line "尼尔" "第二遍的时候。")
      (line "夜莺" "那你听见我唱错了。") (line "尼尔" "我没听出来。")
      (line "夜莺" "但我喜欢这个地方。我在上面的时候，看起来怎么样？")))
    ((eq? mode '相识)
    (play-dialogue!
      (line "夜莺" "你也来看彩排？") (line "尼尔" "听说今天在这里。")
      (line "夜莺" "正式演出会比今天好。") (line "尼尔" "今天已经很好了。")
      (line "夜莺" "你还没听过最好的。")))
    (else (play-dialogue! (line "世界" "夜莺在台边和导演说话。尼尔随着零星的观众离开。")))))

;; 第一幕 V0.2：日常相处发生在工作结算之后，无需额外“刷好感”。
(define (第一幕-夜莺台边)
  (play-dialogue!
    (line "世界" "尼尔收好最后几只酒杯。夜莺抱着歌谱从台上下来。")
    (line "夜莺" "让一让。我总怕下台时踩空。")
    (line "尼尔" "台阶就在你脚下。")
    (line "夜莺" "看见了。只是每晚都比上去难。")
    (line "夜莺" "你最近都在这儿做工？")
    (line "尼尔" "哪里有活，就在哪里干。")
    (line "夜莺" "那我们今晚算同行。")))
(define (第一幕-夜莺收工)
  (play-dialogue!
    (line "世界" "客人散去，夜莺卸下演出的外套，坐在靠门的小桌边。")
    (line "夜莺" "你还没走？酒保还没发工资？")
    (line "尼尔" "你不也是？")
    (line "夜莺" "我们都是等人发钱的。")
    (line "尼尔" "去了大剧院，就不用等了吧。")
    (line "夜莺" "那可难说。那里总不至于还让我吃隔夜面包。")
    (line "世界" "她望着小舞台，停了一会儿。")
    (line "夜莺" "真要走了，又觉得这地方也没那么糟。")))
(define (第一幕-夜莺关心)
  (play-dialogue!
    (line "世界" "一名客人冲尼尔喊着让他擦桌子。夜莺先走过去收起空杯。")
    (line "夜莺" "今天他忙了很久。您要续杯，我去叫酒保。")
    (line "客人" "我又没叫你。")
    (line "夜莺" "那这杯我先收走了。")
    (line "世界" "她转身回到尼尔身边。")
    (line "夜莺" "你不用把那些难听的话都听进去。")
    (line "尼尔" "这也是工作。")
    (line "夜莺" "工作是工作。总得让自己好过一点。")))
(define (第一幕-酒馆告别 mode)
  (play-dialogue!
    (line "世界" "酒馆把桌子挪得很近。吧台旁挂着今夜最后一场的小纸牌。")
    (line "世界" "夜莺仍站在开场时那束追光里。伴奏响起，酒馆渐渐安静。")
    (line "世界" "唱完最后一段时，客人敲着杯沿鼓掌。她向乐手鞠了一躬。"))
  (cond
    ((eq? mode '同行)
      (play-dialogue!
        (line "世界" "人走得差不多时，夜莺在尼尔身边停下来。")
        (line "夜莺" "下次再听我唱歌，就得去大剧院了。")
        (line "尼尔" "那门票可不便宜。")
        (line "夜莺" "我给你留个位置。")))
    ((eq? mode '相识)
      (play-dialogue!
        (line "夜莺" "你也来了。我还以为今晚你要去上工。")
        (line "尼尔" "最后一场，总要来听听。")
        (line "夜莺" "有空来大剧院看看我唱得怎么样。")))
    (else (play-dialogue!
      (line "世界" "夜莺向熟客们道谢。尼尔随着散场的人群走出酒馆。")))))
(define (第一幕-告别消息)
  (play-dialogue!
    (line "调酒师" "昨晚是夜莺在这儿的最后一场。")
    (line "尼尔" "这么快。")
    (line "调酒师" "今天她应该已经在大剧院了。")))
