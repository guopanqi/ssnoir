 ;; 第一幕的临时 Dialogue 表现；剧情事实由 world/第一幕.scm 持有。
(define (第一幕-清晨)
  (play-dialogue!
    (line "世界" "走廊尽头的水龙头滴个不停。尼尔摸了摸内袋，只剩几张零钞。楼下，旅馆老板又把楼梯踩得很响。")
    (line "尼尔" "先找点进项。去酒馆问问，码头也该有活。")))
(define (第一幕-酒馆)
  (play-dialogue!
    (line "世界" "酒馆里还有隔夜的麦酒味。酒保擦着玻璃杯，抬眼看了看尼尔。")
    (line "尼尔" "这儿缺人手吗？看场，跑腿都行。")
    (line "调酒师" "醉鬼认熟脸，不认生人。急着挣钱就去码头，那儿的板条箱不挑人。")
    (line "尼尔" "要是有人想找人办点事呢？")
    (line "调酒师" "坐下喝一杯，自己听听。看场的活，等我认得你再说。")))

 ;; 尼尔不覆盖 :at，沿队员身份定位自己的气泡；夜莺使用实际人物锚点。
(define (第一幕-听歌初次)
  (play-bubble!
    (line "尼尔" "今晚这首叫什么？")
    (line "夜莺" "等歇场我告诉你，先听完。" :at "夜莺@酒馆")))

(define (第一幕-听歌再来)
  (play-bubble!
    (line "夜莺" "今天外头风大。你衣领还是湿的。" :at "夜莺@酒馆")
    (line "尼尔" "一会儿就干了。")))

(define (第一幕-听歌回扣 heard?)
 (if heard?
 (play-bubble!
    (line "尼尔" "第三小节，今天顺多了。")
    (line "夜莺" "你那晚果然听出来了？" :at "夜莺@酒馆"))
 (play-bubble!
    (line "尼尔" "新歌？")
    (line "夜莺" "老歌换了个调。琴师还不大习惯。" :at "夜莺@酒馆"))))

(define (第一幕-听歌熟客 heard?)
  (play-dialogue!
    (line "世界" "酒馆里人满为患。尼尔刚进门，酒保就指了指靠墙的一张小圆桌，上面放着块“已留”的木牌。")
    (line "世界" "夜莺演出完走过来，自己拉开对面的椅子坐下，把一杯苏打水推给他。"))
  (if heard? (play-dialogue!
    (line "夜莺" "今天第二首可没慢，我盯着琴师的手唱的。")) (play-dialogue!
    (line "夜莺" "看你在门口站半天了。那边风大，坐这儿吧。")))
  (play-dialogue!
    (line "尼尔" "谢了。这位置视野不错。")
    (line "夜莺" "视野好，还没人灌你酒。歇会儿吧，看你今天挺累的。")))

(define (第一幕-夜莺关怀)
 (play-bubble!
    (line "夜莺" "喝口水吧，别拿啤酒当晚饭。" :at "夜莺@酒馆")
    (line "尼尔" "谢了。")))

(define (第一幕-夜莺台边)
  (play-dialogue!
    (line "世界" "夜莺坐在后台木箱上，拿小刀削铅笔，膝盖上摊着谱子。尼尔走过去时，她头也没抬。")
    (line "夜莺" "老吉姆，说了今晚不加唱那首快板，琴师根本跟不上——")
    (line "尼尔" "是我。")
    (line "世界" "夜莺停下手里的刀，抬头看他，揉了揉眉心。")
    (line "夜莺" "抱歉，我当是他呢。今天嗓子有点紧，第三段词改了三次还觉得拗口。")
    (line "尼尔" "那你先顺词，我不打扰你。")
    (line "夜莺" "坐会儿吧，不用说话，正好帮我挡着点老吉姆。")))

(define (第一幕-夜莺收工 working?)
  (play-dialogue!
    (line "世界" "夜莺从台上下来，端起吧台上的温水喝了一口。")
    (line "尼尔" "今天第二首，副歌前头好像慢了半拍。")
    (line "世界" "夜莺放下杯子，斜睨了他一眼。")
    (line "夜莺" "你还懂这个？那是故意留出来的气口，不信你去问琴师。")
    (line "尼尔" "我是不懂。就是听着像你在那儿犹豫了一下。")
    (line "世界" "夜莺愣了愣，手指在玻璃杯壁上划了一道。")
    (line "夜莺" "……前排有个客人一直在看表。算你耳朵尖，明晚不会了。")))

(define (第一幕-夜莺解围)
 (play-dialogue!
    (line "世界" "两个喝高的水手对你的劝阻不依不饶，眼看就要推搡起来。台上的夜莺忽然对着麦克风轻咳了一声，笑着朝这边开口。")
    (line "夜莺" "那两位先生，要是把店里的帮手气走了，待会儿谁替我搬谱架呀？给我个面子，坐下听完这首好不好？")
    (line "世界" "水手们哄笑起来，讪讪地松开手坐了回去。夜莺在台上朝你眨了眨眼。")))

(define (第一幕-露西初识)
  (play-dialogue!
    (line "世界" "尼尔端着托盘转身，两杯咖啡滑向边缘。露西伸手扶住杯子。")
    (line "露西" "小心！托盘底下垫块干抹布，不然走两步就打滑。")
    (line "尼尔" "谢谢。")
    (line "露西" "新来的吧？我叫露西。")
    (line "尼尔" "尼尔。")
    (line "露西" "拿好单子，那边的客人还等着要吐司呢。")))

(define (第一幕-露西打字)
  (play-dialogue!
    (line "世界" "趁着没人点单，露西拿着铅笔，在报纸上画圈。")
    (line "尼尔" "看什么呢？")
    (line "露西" "公司招打字员。坐办公室，整天敲打字机，不用站一天，也不用洗这些杯子。")
    (line "尼尔" "你会用打字机？")
    (line "露西" "还没碰过呢。附近的夜校有班，等攒够学费我就去报名。")
    (line "世界" "前台的铃响了。露西收起报纸，擦了擦手。")
    (line "露西" "来客人了，去拿咖啡壶。")))

(define (第一幕-艾迪教搬运)
  (play-dialogue!
    (line "世界" "木箱底板早已糟朽，尼尔刚扛上肩，钉子就崩开了。十几罐沙丁鱼罐头滚了一地，工头骂骂咧咧地从栈桥那头走过来。")
    (line "工头" "没吃饭吗？摔瘪一罐从你今天工钱里扣！愣着干什么，还不快捡！")
    (line "世界" "尼尔蹲下身去拢罐头。旁边伸过来一只戴着破线手套的大手，三两下把滚到水坑边的几罐捞了回来，码进另一个空筐里。")
    (line "艾迪" "行了头儿，那箱子底下早泡烂了，换谁扛都得散。这几罐没瘪，我刚看过了，耽误不了装船。")
    (line "工头" "就你话多！赶紧弄完去三号仓！")
    (line "世界" "工头骂了一句走了。壮汉帮尼尔把筐抬起来，拍了拍手上的灰。")
    (line "艾迪" "新来的？下回挑箱子，看箱角包着新铁皮的扛，那种结实，不扎手。")
    (line "尼尔" "谢了。刚才要不是你搭话，今天白干了。下工请你喝一杯？")
    (line "艾迪" "喝什么酒，几毛钱也是汗珠子摔出来的。有烟吗？来一根就行。")
    (line "世界" "尼尔从兜里摸出烟盒递过去。壮汉抽出一根叼在嘴上，借着尼尔的火点着，深吸了一口。")
    (line "艾迪" "劲儿够足。我叫艾迪，在二号栈桥干活。")
    (line "尼尔" "尼尔。")
    (line "艾迪" "行，尼尔。跟紧点，三号仓的货轻，去晚了全让人挑走了。")))

(define (第一幕-艾迪再见)
  (play-dialogue!
    (line "世界" "吊车的铁链响着。艾迪看见尼尔，把手套递了过来。")
    (line "艾迪" "骨架没散啊，小子，又来了？")
    (line "尼尔" "码头的钞票现结，不压账。")
    (line "艾迪" "那过来顶这头，别让货箱压着绳子。")))

;; D8 大剧院首次彩排：已有舞台 DSL 与音乐，区别于需要玩家判定的Scenario。
;; 第一遍只是试音；第二遍真正给观众留一段听歌的时间，不用对白复述美感。
(define (第一幕-彩排)
  (define 景
    (list
      (theatre-group "剧院布景" "" 0 0)
      (theatre-polygon "舞台地面" "剧院布景" "#18171B"
        '((120 535) (1480 535) (1580 795) (20 795)))
      (theatre-polygon "天幕" "剧院布景" "#090A11"
        '((100 90) (1500 90) (1490 535) (110 535)))
      (theatre-line "台口" "剧院布景" "#B7A37C" 2
        '((100 537) (1500 537)))
      (theatre-line "前排座椅" "剧院布景" "#3D3740" 3
        '((50 810) (260 775) (480 800) (730 776) (1010 800) (1300 775) (1550 810)))
      (theatre-light "彩排追光" "" "#F2D3A5" 800 425 510 .16)
      (theatre-with (theatre-glow "舞台光池" "" "#F4D5AB" 800 630 340 85) 'opacity .1)
      (theatre-with (theatre-group "歌者位置" "" 800 650) 'opacity 1)
      (theatre-image "夜莺" "歌者位置" "Portraits/Neon/夜莺" 0 0 310 310 "彩排追光")
      (theatre-line "钢琴" "剧院布景" "#A1A4A7" 3
        '((1060 610) (1200 610) (1200 680) (1080 680)))
      (theatre-line "琴凳" "剧院布景" "#77777D" 2
        '((1085 700) (1160 700)))))
  (play-theatre! (theatre-scene 1600 900 "#07080B" 景)
    (theatre-say "舞台监督" "第一遍，先试试声音。" 2.3 "#C5C3BB")
    (theatre-sound "试音" "StageSounds/酒馆告别/最后一首" #t .24 0)
    (theatre-during
      (theatre-tween "彩排追光" 'brightness .42 4 'smooth)
      (theatre-loop (theatre-animate "歌者位置" 'rotation '((0 0) (1 .7) (2 0)))))
    (theatre-stop-sound "试音")
    (theatre-say "舞台监督" "再来一遍。这一次，不用收着。" 2.6 "#C5C3BB")
    (theatre-parallel
      (theatre-tween "彩排追光" 'brightness 1.4 2 'smooth)
      (theatre-tween "舞台光池" 'opacity .34 2 'smooth))
    (theatre-sound "第二遍" "StageSounds/酒馆告别/最后一首" #t .8 0)
    (theatre-during
      (theatre-sequence
        (theatre-wait 6)
        (theatre-image-to "夜莺" "Portraits/Neon/夜莺_仰头")
        (theatre-wait 8)
        (theatre-image-to "夜莺" "Portraits/Neon/夜莺"))
      (theatre-loop (theatre-animate "歌者位置" 'rotation
        '((0 0) (2 .8) (4 0) (6 -.8) (8 0)))))
    (theatre-stop-sound "第二遍")
    (theatre-tween "彩排追光" 'brightness .55 1.5 'smooth)
    (theatre-say "夜莺" "刚才在后面忙什么？" 1.8 "#8FD9D0")
    (theatre-say "尼尔" "在侧幕后头干活。一直听得见。" 1.8 "#F0CF8A")
    (theatre-say "夜莺" "我看见你了。戴着那副大手套。" 2.2 "#8FD9D0")
    (theatre-say "夜莺" "我在上面的时候，看起来怎么样？" 2.7 "#8FD9D0")
    (theatre-say "尼尔" "很漂亮。" 2 "#F0CF8A")
    (theatre-parallel
      (theatre-tween "彩排追光" 'brightness 1.1 1.2)
      (theatre-tween "舞台光池" 'opacity .2 1.2))
    (theatre-say "夜莺" "我喜欢这里。" 2.5 "#8FD9D0")
    (theatre-clear-caption)
    (theatre-wait 2)))
