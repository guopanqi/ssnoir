;; Claude 22-photo-develop / 23-photo-source 的线绘舞台移植。
;; 共用原型布景、柜台和道具；保留时间与对话顺序，复用现有立绘表达姿态。
;; 演出不持有委托状态。两卷? 由正式入口依据实际取证成果传入。
(define (照相馆冲印-演出 两卷?) (照相馆-演出 '冲印 两卷?))
(define (照相馆查来源-演出) (照相馆-演出 '查来源 #f))
(define (照相馆-演出 模式 两卷?)
  (if (member? 模式 '(冲印 查来源)) #t (error "照相馆演出：未知模式"))
  (define 图形 '())
  (define 描绘 '())
  (define (加入 object) (set! 图形 (append 图形 (list object))))
  (define (线 id parent color width points delay)
    (加入 (theatre-with (theatre-line id parent color width points) 'reveal 0))
    (set! 描绘 (append 描绘 (list (theatre-sequence
      (theatre-wait (+ .001 delay)) (theatre-tween id 'reveal 1 2.2 'smooth))))))
  (define (静线 id parent color width points)
    (加入 (theatre-line id parent color width points)))
  (define (框 id parent x y w h color width delay)
    (线 id parent color width
      (list (list x y) (list (+ x w) y) (list (+ x w) (+ y h))
            (list x (+ y h)) (list x y)) delay))
  (define (填 id parent x y w h color)
    (加入 (theatre-polygon id parent color
      (list (list x y) (list (+ x w) y) (list (+ x w) (+ y h)) (list x (+ y h))))))
  (define (组 id parent x y opacity)
    (加入 (theatre-with (theatre-group id parent x y) 'opacity opacity)))
  (define (说 who x text seconds)
    (theatre-during
      (theatre-caption-for who text seconds
        (cond ((equal? who "尼尔") "#F0CF8A")
              ((equal? who "店主") "#F4907C") (else "#C9CFE2")))
      (theatre-parallel
        (theatre-tween "焦点" 'x (+ 800 (* (- x 800) .5)) 1 'smooth)
        (theatre-tween "说话柔光" 'x x 1.2 'smooth)
        (theatre-tween "说话柔光" 'opacity .13 1.2 'smooth))))
  (define (近景 id x y scale opacity seconds)
    (theatre-parallel
      (theatre-tween id 'x x seconds 'smooth)
      (theatre-tween id 'y y seconds 'smooth)
      (theatre-tween id 'scale-x scale seconds 'smooth)
      (theatre-tween id 'scale-y scale seconds 'smooth)
      (theatre-tween id 'opacity opacity seconds 'smooth)))
  (define (推近 scale x y seconds)
    (theatre-parallel
      (theatre-tween "画面" 'scale-x scale seconds 'smooth)
      (theatre-tween "画面" 'scale-y scale seconds 'smooth)
      (theatre-tween "画面" 'x (* (- 1 scale) x) seconds 'smooth)
      (theatre-tween "画面" 'y (* (- 1 scale) y) seconds 'smooth)))
  (define (提示声 id asset)
    (theatre-sound id (string-append "StageSounds/照相馆/" asset) #f .6 0))
  (define (胶卷 id x)
    (组 id "画面" x 606 0)
    (填 (string-append id "/身") id 0 0 24 34 "#07080C")
    (静线 (string-append id "/框") id "#CFD6E6" 2.5 '((0 0) (24 0) (24 34) (0 34) (0 0)))
    (填 (string-append id "/盖") id 4 -6 16 6 "#CFD6E6"))
  (define (相纸背面 id)
    (组 id "画面" 800 360 0)
    (填 (string-append id "/纸") id -75 -55 150 110 "#CDBFA0")
    (静线 (string-append id "/边") id "#2A2418" 3 '((-75 -55) (75 -55) (75 55) (-75 55) (-75 -55)))
    (静线 (string-append id "/压纹0") id "#8A7A5CBF" 1.3 '((-55 41) (-41 55)))
    (静线 (string-append id "/压纹1") id "#8A7A5CBF" 1.3 '((-41 -55) (-55 -41)))
    (静线 (string-append id "/压纹2") id "#8A7A5CBF" 1.3 '((-55 25) (-25 55)))
    (静线 (string-append id "/压纹3") id "#8A7A5CBF" 1.3 '((-25 -55) (-55 -25)))
    (静线 (string-append id "/压纹4") id "#8A7A5CBF" 1.3 '((-55 9) (-9 55)))
    (静线 (string-append id "/压纹5") id "#8A7A5CBF" 1.3 '((-9 -55) (-55 -9)))
    (静线 (string-append id "/压纹6") id "#8A7A5CBF" 1.3 '((-55 -7) (7 55)))
    (静线 (string-append id "/压纹7") id "#8A7A5CBF" 1.3 '((7 -55) (-55 7)))
    (静线 (string-append id "/压纹8") id "#8A7A5CBF" 1.3 '((-55 -23) (23 55)))
    (静线 (string-append id "/压纹9") id "#8A7A5CBF" 1.3 '((23 -55) (-55 23)))
    (静线 (string-append id "/压纹10") id "#8A7A5CBF" 1.3 '((-55 -39) (39 55)))
    (静线 (string-append id "/压纹11") id "#8A7A5CBF" 1.3 '((39 -55) (-55 39)))
    (静线 (string-append id "/压纹12") id "#8A7A5CBF" 1.3 '((-55 -55) (55 55)))
    (静线 (string-append id "/压纹13") id "#8A7A5CBF" 1.3 '((55 -55) (-55 55)))
    (静线 (string-append id "/压纹14") id "#8A7A5CBF" 1.3 '((-39 -55) (55 39)))
    (静线 (string-append id "/压纹15") id "#8A7A5CBF" 1.3 '((55 -39) (-39 55)))
    (静线 (string-append id "/压纹16") id "#8A7A5CBF" 1.3 '((-23 -55) (55 23)))
    (静线 (string-append id "/压纹17") id "#8A7A5CBF" 1.3 '((55 -23) (-23 55)))
    (静线 (string-append id "/压纹18") id "#8A7A5CBF" 1.3 '((-7 -55) (55 7)))
    (静线 (string-append id "/压纹19") id "#8A7A5CBF" 1.3 '((55 -7) (-7 55)))
    (静线 (string-append id "/压纹20") id "#8A7A5CBF" 1.3 '((9 -55) (55 -9)))
    (静线 (string-append id "/压纹21") id "#8A7A5CBF" 1.3 '((55 9) (9 55)))
    (静线 (string-append id "/压纹22") id "#8A7A5CBF" 1.3 '((25 -55) (55 -25)))
    (静线 (string-append id "/压纹23") id "#8A7A5CBF" 1.3 '((55 25) (25 55)))
    (静线 (string-append id "/压纹24") id "#8A7A5CBF" 1.3 '((41 -55) (55 -41)))
    (静线 (string-append id "/压纹25") id "#8A7A5CBF" 1.3 '((55 41) (41 55)))
    (静线 (string-append id "/印记") id "#8A7A5C" 2 (theatre-ellipse-points 45 30 16 16)))

  (组 "画面" "" 0 0 1)
  (组 "布景" "画面" 0 0 0)
  (线 "地面" "布景" "#5A6F9C" 1.5 '((0 790) (1600 790)) 0)
  (线 "路沿" "布景" "#33466E" 1 '((0 806) (1600 806)) .4)
  (线 "墙线" "布景" "#7F95C4" 1.5 '((260 340) (1340 340)) .6)
  ;; SVG 二次曲线 Q(800,250) 转等价 cubic。
  (线 "晾片绳" "布景" "#9FB4E0" 1.8
    (theatre-cubic '(340 190) '(646.6667 230) '(953.3333 230) '(1260 190) 32) .8)
  (define (晾照片 i)
    (if (< i 6)
      (let* ((x (+ 400 (* i 150))) (u (/ (- x 800) 460.0)) (y (+ 190 (* 60 (- 1 (* u u))))))
        (框 (string-append "晾片" (number->string i)) "布景" (- x 22) (+ y 6) 44 56 "#CFE0FF" 1.5 (+ 1 (* i .12)))
        (晾照片 (+ i 1))) #f))
  (晾照片 0)
  (框 "架子" "布景" 1020 330 260 14 "#9FB4E0" 2 1.4)
  (框 "架盒一" "布景" 1040 288 70 42 "#7F95C4" 1.5 1.5)
  (框 "架盒二" "布景" 1130 300 60 30 "#7F95C4" 1.5 1.6)
  (框 "门框" "布景" 260 470 150 320 "#E9EEF8" 2.5 1.2)
  (线 "红灯支架" "布景" "#9FB4E0" 2 '((1320 436) (1320 470) (1300 470) (1340 470)) 1.7)
  (加入 (theatre-light "安全灯" "画面" "#FF3A3A" 1320 420 650 1))
  (静线 "红灯边" "安全灯" "#FF9A9A" 2 (theatre-ellipse-points 0 0 16 16))
  (加入 (theatre-glow "红灯芯" "安全灯" "#FF3A3A" 0 0 32 32))
  (加入 (theatre-with (theatre-glow "红灯柔光" "安全灯" "#FF3A3A" 0 0 220 220) 'opacity .3))
  (加入 (theatre-focus "焦点" 800 594 .20 .52))
  (加入 (theatre-with (theatre-glow "说话柔光" "画面" "#8FB4E8" 860 560 600 840) 'opacity 0))
  (组 "尼尔位置" "画面" -150 790 0)
  (加入 (theatre-image "尼尔" "尼尔位置" "Portraits/Neon/尼尔" 0 0 308 308 ""))
  (组 "店主位置" "画面" 1070 790 0)
  ;; 沿用普通男性立绘；前景柜台遮住下半身，不以具名人物冒充店主。
  (加入 (theatre-with (theatre-image "店主" "店主位置" "Portraits/Neon/路人男" 0 0 308 308 "") 'scale-x -1))
  (组 "柜台" "画面" 0 0 0)
  (填 "柜台面" "柜台" 740 640 660 150 "#07080C")
  (静线 "柜台框" "柜台" "#9FB4E0" 2.5 '((740 640) (1400 640) (1400 790) (740 790) (740 640)))
  (静线 "柜台沿" "柜台" "#F0F4FF" 4 '((740 640) (1400 640)))
  (静线 "柜台竖一" "柜台" "#4F6490" 2 '((800 664) (800 780)))
  (静线 "柜台竖二" "柜台" "#4F6490" 2 '((1000 664) (1000 780)))
  (静线 "柜台竖三" "柜台" "#4F6490" 2 '((1200 664) (1200 780)))
  (胶卷 "胶卷一" 796)
  (胶卷 "胶卷二" 836)
  (组 "取件单" "画面" 1010 616 0)
  (填 "取件单纸" "取件单" 0 0 44 24 "#E6DCC4")
  (静线 "取件单字" "取件单" "#8A7A5C" 2 '((6 8) (36 8) (6 8) (6 15) (28 15)))
  (组 "相纸" "画面" 1150 622 0)
  (填 "相纸下" "相纸" 0 8 70 8 "#E6DCC4")
  (填 "相纸上" "相纸" 6 0 70 8 "#ECE3CC")
  (组 "冲印相片" "画面" 800 620 0)
  (填 "相片下" "冲印相片" 0 8 64 10 "#D8D2C4")
  (填 "相片上" "冲印相片" 6 0 64 8 "#CFC8B6")
  (组 "勒索相片" "画面" 880 626 0)
  (填 "勒索相片纸" "勒索相片" 0 0 76 12 "#D8D2C4")
  (静线 "勒索相片边" "勒索相片" "#8A7A5C" 2 '((0 0) (76 0) (76 12) (0 12) (0 0)))
  (相纸背面 "照片背面")
  (相纸背面 "样片背面")
  (相纸背面 "回忆背面")
  (组 "暗场" "" 0 0 0)
  (填 "暗场幕" "暗场" 0 0 1600 900 "#030102")
  (加入 (theatre-with (theatre-glow "暗房红光" "" "#FF3A3A" 1320 420 110 110) 'opacity 0))

  (define 开场
    (theatre-sequence
      ;; CSS 描线与人物进场原本同时进行，不等整个布景画完再走入。
      (theatre-parallel
        (apply theatre-parallel (cons (theatre-tween "布景" 'opacity 1 1.5) 描绘))
        (theatre-sequence
          (theatre-wait .5)
          (theatre-parallel (theatre-tween "柜台" 'opacity 1 .1)
            (theatre-tween "店主位置" 'opacity 1 .6))
          (提示声 "门铃" "门铃")
          (theatre-parallel
            (theatre-tween "尼尔位置" 'opacity 1 .05)
            (theatre-tween "尼尔位置" 'x 650 2.2 'smooth)
            (theatre-sound "脚步" "StageSounds/老街酒馆/脚步" #f .35 -.3)
            (theatre-wait 2.4))))
      (推近 1.04 992 630 .5)))
  (define 冲印
    (theatre-sequence
      (theatre-wait .5)
      (theatre-image-to "尼尔" "Portraits/Neon/尼尔_伸手")
      (theatre-tween "胶卷一" 'opacity 1 .1)
      (提示声 "放胶卷一" "放胶卷")
      (theatre-during
        (说 "尼尔" 650 (if 两卷? "这卷替我洗出来。还有这一卷。" "这卷替我洗出来。") (if 两卷? 2.025 1.290))
        (if 两卷? (theatre-sequence (theatre-wait 1.7)
                   (theatre-tween "胶卷二" 'opacity 1 .1) (提示声 "放胶卷二" "放胶卷"))
            (theatre-wait .01)))
      (theatre-image-to "尼尔" "Portraits/Neon/尼尔")
      (theatre-wait .5)
      (theatre-parallel (theatre-tween "胶卷一" 'opacity 0 .3) (theatre-tween "胶卷二" 'opacity 0 .3))
      (theatre-wait .4)
      (提示声 "写取件单" "写取件单")
      (theatre-wait 1.8)
      (theatre-tween "取件单" 'opacity 1 .3)
      (theatre-wait .6)
      (theatre-tween "取件单" 'x 820 .9 'smooth)
      (说 "店主" 1070 "拿着取件单，别丢了。" 1.500)
      (theatre-clear-caption)
      ;; 原型 brightness(0) 转成短暗场；同一次访问，无世界时间变化。
      (theatre-tween "暗场" 'opacity .96 .5)
      (theatre-tween "暗房红光" 'opacity .3 .15)
      (theatre-tween "取件单" 'opacity 0 .01)
      (提示声 "冲印滴水" "冲印")
      (theatre-wait 2.66)
      (theatre-tween "冲印相片" 'opacity 1 .01)
      (theatre-parallel (theatre-tween "暗场" 'opacity 0 .9) (theatre-tween "暗房红光" 'opacity 0 .9))
      (theatre-wait .2)
      (theatre-image-to "尼尔" "Portraits/Neon/尼尔_伸手")
      (theatre-tween "冲印相片" 'opacity 0 .4)
      (theatre-wait .6)
      (近景 "照片背面" 700 330 1.25 1 .6)
      (提示声 "翻相片" "翻相片")
      (推近 1.1 928 594 .6)
      (theatre-wait 2.2)
      (theatre-image-to "尼尔" "Portraits/Neon/尼尔")
      (近景 "照片背面" 700 330 1.25 0 .3)
      (说 "尼尔" 650 "我能看看你们的相纸吗？" 1.605)
      (theatre-tween "相纸" 'opacity 1 .4)
      (说 "店主" 1070 "喏，最好的纸张。" 1.290)
      (theatre-image-to "尼尔" "Portraits/Neon/尼尔_伸手")
      (theatre-wait .7)
      (近景 "样片背面" 700 330 1.25 1 .5)
      (提示声 "摸相纸" "翻相片")
      (theatre-wait 1.3)
      (theatre-parallel
        (近景 "照片背面" 560 330 1 1 .5)
        (近景 "样片背面" 840 330 1 1 .5))
      (theatre-wait .9)
      (说 "尼尔" 650 "这背面的压纹，是原来就有的吗？" 2.025)
      (theatre-tween "店主位置" 'rotation 3 .2)
      (说 "店主" 1070 "嗯，应该是吧。" 1.185)
      (theatre-tween "店主位置" 'rotation 0 .2)
      (theatre-image-to "尼尔" "Portraits/Neon/尼尔")
      (theatre-tween "布景" 'brightness .7 .5)
      (theatre-sound "钟声" "StageSounds/室内求助/钟表" #f .22 0)
      ;; 半透明的旧照片背面只作为记忆，不额外产生物品或结论。
      (theatre-during
        (说 "旁白" 650 "夜莺给我看的那张照片背面，好像也有这个。" 2.550)
        (theatre-sequence (近景 "回忆背面" 700 330 1 .5 .9)
          (theatre-wait .5) (近景 "回忆背面" 700 330 1 .2 .8)))
      (theatre-clear-caption)
      (theatre-parallel
        (近景 "照片背面" 560 330 1 0 .6)
        (近景 "样片背面" 840 330 1 0 .6)
        (近景 "回忆背面" 700 330 1 0 .6)
        (推近 1 800 594 1.5))))
  (define 查来源
    (theatre-sequence
      (theatre-image-to "尼尔" "Portraits/Neon/尼尔_伸手")
      (theatre-wait .5)
      (theatre-tween "勒索相片" 'opacity 1 .4)
      (提示声 "放照片" "放胶卷")
      (theatre-wait .5)
      (theatre-image-to "尼尔" "Portraits/Neon/尼尔")
      (说 "尼尔" 650 "老板，我这儿有张照片想请你看看。" 2.130)
      (说 "店主" 1070 "要洗照片吗？" 1.080)
      (theatre-image-to "尼尔" "Portraits/Neon/尼尔_伸手")
      (theatre-wait .7)
      (推近 1.1 960 612 .7)
      (说 "尼尔" 650 "我只是问问，这张是不是也在你们这儿洗的？" 2.550)
      (theatre-clear-caption)
      (theatre-tween "店主位置" 'rotation 3 .7)
      (theatre-parallel
        (theatre-tween "店主位置" 'x 1090 .5 'smooth)
        (theatre-tween "布景" 'brightness .8 .5)
        (theatre-sound "犹豫钟声" "StageSounds/室内求助/钟表" #f .22 0)
        (theatre-wait 1.7))
      (说 "店主" 1090 "这、这我怎么知道……" 1.500)
      (theatre-parallel
        (theatre-tween "店主位置" 'rotation 0 .2)
        (theatre-tween "店主位置" 'x 1040 .6 'smooth)
        (theatre-tween "店主位置" 'brightness 1.2 .2)
        (theatre-tween "安全灯" 'brightness 1.3 .2)
        (提示声 "恼火低音" "低音"))
      (theatre-wait .5)
      (说 "店主" 1040 "你到底想问什么？" 1.290)
      (theatre-clear-caption)
      (theatre-image-to "尼尔" "Portraits/Neon/尼尔")
      (theatre-sound "僵持钟声" "StageSounds/室内求助/钟表" #f .22 0)
      (theatre-wait 1.8)
      (推近 1 800 594 .9)))
  (play-theatre! (theatre-scene 1600 900 "#0A0809" 图形)
    开场 (if (eq? 模式 '冲印) 冲印 查来源)))
