;; S2-D 独立原生语义实验：不是第一章正典，也不加入 Debug 白名单。
;; 对照纸面 R122–R124 只验证“揭示后两项可操作”的顺序契约。
;; 本场每次投骰确定推进1格，不能用它估算纸面0/1/2概率或玩家体验。
(define 研究名称 "线索两选")
(set-actor-composure! 'player 5)
(define 已结算? #f)
(define 已交信? #f)
(define 已发现? #f)
(define 查信钟 (make-clock "查信" 2 'gauge "两格才揭示递信人，不能自动交信。"))
(define 艾迪钟 (make-clock "艾迪请求" 2 'gauge "第一天有效，过期仍保留完成记录。"))
(define 递信钟 (make-clock "递信踪迹" 2 'gauge "揭示后可追查，交信后尚未完成的踪迹关闭。"))
(define 日期钟 (make-clock "已过日期" 2 'gauge "第一天有交信与艾迪机会，第二天还可追查。"))
(define (研究结果 status)
  (list status (查信钟 'current) (艾迪钟 'current)
    (递信钟 'current) 已发现? 已交信? (日期钟 'current)))
(define (研究结束! status title)
  (if 已结算? (error "线索两选：重复结算") #t)
  (set! 已结算? #t)
  (spotlight! 研究名称 title)
  (end-scenario (研究结果 status)))
(define (调查信!)
  (if (or 已结算? (查信钟 'full?)) (error "线索两选：不可重复调查") #t)
  (查信钟 'advance! 1)
  (if (and (查信钟 'full?) (not 已发现?))
    (begin
      (set! 已发现? #t)
      (spotlight! "递信人出现" "发现新的踪迹，但信还没交。现在仍可以追查，也可以直接交信。"))
    #f))
(define (帮艾迪!)
  (if (or 已结算? (> (日期钟 'current) 0) (艾迪钟 'full?))
    (error "线索两选：艾迪机会已经结束") #t)
  (艾迪钟 'advance! 1))
(define (追踪!)
  (if (or 已结算? (not 已发现?) 已交信? (递信钟 'full?))
    (error "线索两选：踪迹不可追查") #t)
  (递信钟 'advance! 1))
(define (交信!)
  (if (or 已结算? 已交信? (not 已发现?) (> (日期钟 'current) 0))
    (error "线索两选：不能在此时交信") #t)
  (set! 已交信? #t)
  (spotlight! "交信已定" "信已经交出；尚未完成的递信人踪迹立即失去机会。"))
(define (研究耗骰 名称 简述 效果)
  (node 名称 :subtitle 简述 :requires (list (req-die))
    :resolve (instant 效果)))
(define-opponent-rule "跨日"
  (lambda () (not 已结算?))
  (lambda ()
    (日期钟 'advance! 1)
    (if (日期钟 'full?)
      (研究结束! 'timeout "两天过去。已经做成的事保留，其余机会结束。")
      (spotlight! "第二天" "艾迪的请求和交信窗口已过。尚未关闭的递信线索仍可追查。"))))
(define (on-scenario-collapse) (collapse-result (研究结果 'collapse)))
(define (get-render-data)
  (container 研究名称
    (append
      (list
        (note-node "标注：情境" "两日，三件值得关心的事"
          "实验而非剧情正典。行动会揭示新路线；交信是单独选择，不随进度自动发生。")
        (note-node "标注：线索状态"
          (if 已发现? "已发现递信人" "递信人尚未出现")
          (cond (已交信? "已交信，未完成追查关闭。")
                (已发现? "追查或交信，都是可花行动的真实选项。")
                (else "调查到2格后公开新线索。"))))
      (clock-nodes (查信钟 'render-data) (艾迪钟 'render-data)
        (递信钟 'render-data) (日期钟 'render-data))
      (if (and (not 已发现?) (= (日期钟 'current) 0))
        (list (研究耗骰 "调查信件" "花一骰推进1格，满2格揭示递信人。" 调查信!))
        '())
      (if (and (not (艾迪钟 'full?)) (= (日期钟 'current) 0))
        (list (研究耗骰 "帮艾迪" "仅第一天；花一骰推进1格。" 帮艾迪!))
        '())
      (if (and 已发现? (not 已交信?) (not (递信钟 'full?)))
        (list (研究耗骰 "沿线追查" "花一骰推进1格；交信将关闭本项。" 追踪!))
        '())
      (if (and 已发现? (not 已交信?) (= (日期钟 'current) 0))
        (list (研究耗骰 "交付信件" "花一骰立即定案；关闭未完成的追查。" 交信!))
        '()))))
