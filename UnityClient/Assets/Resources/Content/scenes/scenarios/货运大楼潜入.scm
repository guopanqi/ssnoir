;; 城市与测试菜单共用；天亮之前为整场八回合，换阶段不刷新。
(define 阶段 '大门)
(define 已结束? #f)
(define 工头 (speaker "潜入工头" :name "工头" :appearance '成年男性))
(define 罗科 (speaker "潜入罗科" :name "罗科" :appearance '成年男性))
(define 铁门 (make-clock "铁门阻碍" 4 'gauge "打开后进入装卸场，选择上楼的办法。" :beneficial-direction 'increase))
(define 门铃 (make-clock "破解门铃" 2 'gauge "填满后，可以小心翼翼地打开铁门，不引起警觉。" :beneficial-direction 'increase))
(define 装卸 (make-clock "核完分拣货物" 6 'gauge "核完这一批货，工头便让尼尔送运单上三楼账房。" :beneficial-direction 'increase))
(define 通道 (make-clock "穿过内部通道" 4 'gauge "穿过封锁通道，抵达三楼。" :beneficial-direction 'increase))
(define 文件柜 (make-clock "文件柜搜查" 4 'gauge "查清这处是否藏着有用的材料。" :beneficial-direction 'increase))
(define 办公桌 (make-clock "办公桌搜查" 4 'gauge "查清这处是否藏着有用的材料。" :beneficial-direction 'increase))
(define 外寄纸箱 (make-clock "外寄纸箱搜查" 4 'gauge "查清这处是否藏着有用的材料。" :beneficial-direction 'increase))
(define 搜查分配 '(材料 情报 账单))
(define 找到材料? #f)
(define 看过罗科账单? #f)
(define (搜查钟 i) (list-ref (list 文件柜 办公桌 外寄纸箱) i))
(define (搜查名称 i) (list-ref '("文件柜" "办公桌" "外寄纸箱") i))
(define (发现说明 i)
  (cond ((eq? (list-ref 搜查分配 i) '材料) "已找到：付款记录、威胁信件与指控稿")
    ((eq? (list-ref 搜查分配 i) '情报) "已找到：货运账目的可疑线索，获得一份情报")
    (else "已找到：罗科积欠的一长串账单")))
(define (揭开搜查! i)
  (let ((where (搜查名称 i)) (what (list-ref 搜查分配 i)))
    (cond
      ((eq? what '材料)
        (set! 找到材料? #t)
        (play-dialogue!
          (line "世界" (string-append "尼尔在" where "里找到一只写着夜莺旧艺名的信封。里面有未扣除的付款记录、带威胁措辞的信件和准备交给小报的指控稿。"))
          (line "尼尔" "这些够和他谈了。")))
      ((eq? what '情报)
        (add-item! "情报" 1)
        (play-dialogue!
          (line "世界" (string-append where "里夹着几张重复报销的货运收据，落款却是不同的公司。与夜莺的事无关，但尼尔记下了那些名字，日后也许能派上用场。"))))
      (else
        (set! 看过罗科账单? #t)
        (play-dialogue!
          (line "世界" (string-append where "里压着罗科的一长串账单：旅馆房租、货物寄存费、拖欠的车费。几封催款信已经拆得起了毛边。"))
          (line "尼尔" "原来他自己的账，也快付不清了。"))))))
(define (搜查! i grade)
  (if (or (not (eq? 阶段 '档案)) ((搜查钟 i) 'full?))
    (error "货运大楼：不能重复搜查已查清的对象") #t)
  (if (eq? grade '坏) (begin (警觉 'advance! 1) (检查!))
    (begin
      ((搜查钟 i) 'advance! (if (eq? grade '好) 2 1))
      (if ((搜查钟 i) 'full?) (揭开搜查! i) #f))))
(define (搜查对象 i)
  (let ((c (搜查钟 i)))
    (node (搜查名称 i)
      :anchor (list-ref '("货运大楼潜入-文件柜" "货运大楼潜入-办公桌" "货运大楼潜入-外寄纸箱") i)
      :subtitle (if (c 'full?) (发现说明 i) "好2中1；失败警觉加1，查清后揭示内容")
      :disabled (c 'full?) :requires (list (req-die))
      :clocks (list (c 'render-data))
      :progress-target (list 'clock (list-ref (c 'render-data) 1))
      :risk '冒险 :risk-target (list 'clock "警觉")
      :resolve (roll 'sharpness
        (outcome (lambda () (搜查! i '坏)))
        (outcome (lambda () (搜查! i '中)))
        (outcome (lambda () (搜查! i '好)))))))
(define 警觉 (make-clock "警觉" 4 'pressure "全程累计，换楼层不清零；达到四点，潜入暴露，整场失败。" :beneficial-direction 'decrease))
(define 余时 (make-clock "天亮之前" 8 'countdown "回合结束减一；全程共用八回合；归零时天亮，整场失败。" :beneficial-direction 'increase))
(define (目标钟)
  (cond ((eq? 阶段 '大门) 铁门) ((eq? 阶段 '装卸) 装卸)
    ((eq? 阶段 '通道) 通道)
    (else (error "潜入：当前阶段没有行动目标"))))
(define (失败! reason)
  (if (not 已结束?)
    (begin (set! 已结束? #t)
      (play-dialogue! (line "世界" reason))
      (end-scenario "失败")) #f))
(define (进入! next)
  (set! 阶段 next)
  (focus-node! "货运大楼潜入"))
(define (检查!)
  (cond ((警觉 'full?) (失败! "值班员循着动静找了过来。尼尔的身份暴露了，今晚的潜入到此为止。"))
    ((and (eq? 阶段 '大门) (铁门 'full?))
      (set! 阶段 '选路)
      (focus-node! "货运大楼潜入")
      (play-dialogue! (line "世界" "铁门开了。装卸场里，夜班工人正在卸车；另一边的消防楼梯没有灯。")))
    ((and (eq? 阶段 '装卸) (装卸 'full?))
      (play-dialogue!
        (line 工头 "核完了？把这张运单送三楼账房。")
        (line "世界" "尼尔沿楼梯把运单送上三楼。隔壁档案室的门虚掩着，里面暂时没人。"))
      (进入! '档案))
    ((and (eq? 阶段 '通道) (通道 'full?))
      (play-dialogue! (line "世界" "尼尔穿过二楼最后一段走廊，登上三楼。档案室的门虚掩着，里面暂时没人。"))
      (进入! '档案))
    (else #f)))
(define (推进! clock amount alert)
  (clock 'advance! amount)
  (if (> alert 0) (警觉 'advance! alert) #f)
  (检查!))
(define (失手! alarm cost)
  (if (> cost 0) (spend-composure! cost) #f)
  (if (> alarm 0) (警觉 'advance! alarm) #f)
  (检查!))
(define (行动锚点)
  (cond ((eq? 阶段 '大门) "货运大楼潜入-铁门")
    ((eq? 阶段 '装卸) "货运大楼潜入-装卸")
    ((eq? 阶段 '通道) "货运大楼潜入-消防梯")
    (else "货运大楼潜入-档案室")))
(define (阶段锚点)
  (cond ((eq? 阶段 '大门) "货运大楼潜入-外形")
    ((eq? 阶段 '选路) "货运大楼潜入-一楼")
    ((member? 阶段 '(装卸 通道)) "货运大楼潜入-二楼")
    (else "货运大楼潜入-三楼")))
(define (确定行动 id description clock amount alert)
  (node id :anchor (行动锚点) :subtitle description :requires (list (req-die))
    :progress-target (list 'clock (car (cdr (clock 'render-data))))
    :resolve (instant (outcome (lambda () (推进! clock amount alert))))))
(define (判定行动 id description skill risk clock good alarm cost)
  (node id :anchor (行动锚点) :subtitle description :risk risk :requires (list (req-die))
    :risk-target (cond ((> cost 0) (list 'composure "player")) ((> alarm 0) (list 'clock "警觉")) (else #f))
    :progress-target (list 'clock (car (cdr (clock 'render-data))))
    :resolve (roll skill
      (outcome (lambda () (失手! alarm cost)))
      (outcome (lambda () (推进! clock 1 0)))
      (outcome (lambda () (推进! clock good 0))))))
(define (选路! route)
  (if (eq? 阶段 '选路) #t (error "潜入：不能重复选择路线"))
  (if (eq? route '装卸)
    (begin (进入! '装卸)
      (play-dialogue!
        (line "世界" "尼尔套上挂在墙边的工作外套，跟着装卸队沿楼梯上到二楼分拣区。")
        (line 工头 "新来的？把这批货核完，运单送三楼账房。")))
    (begin (进入! '通道) (警觉 'advance! 1)
      (play-dialogue! (line "世界" "尼尔沿外消防梯爬到二楼。楼里的巡查员听见脚步，推开门看了一眼。"))
      (检查!))))
(define (谈判!)
  (if (and (eq? 阶段 '档案) 找到材料?) #t (error "潜入：尚未取得谈判材料"))
  (set! 已结束? #t)
  (play-dialogue!
    (line "尼尔" "这笔演出报酬，你收过，账单却没扣。还有这些信。欠款可以核算，威胁她的事不能再继续。")
    (line 罗科 "你翻了我的档案？")
    (line "尼尔" (if 看过罗科账单?
      "还有那一摞催款账单。你也需要拿到钱，把这里的账结清。别再拿她的以后填你的窟窿。"
      "过去的垫款可以结清，但她以后的演出不再归你管。"))
    (line "尼尔" "你可以和经理核清余额，签字解除代理关系。也可以继续纠缠，让这些信有别的读者。")
    (line "世界" "罗科沉默了很久。最后，经理按核过的余额安排结算，罗科签下解除代理关系与停止纠缠的协议。他拿着结算款付清几笔急账，收拾行李，离开了这里。"))
  (end-scenario "问题被解决"))
(define-opponent-rule "货运大楼：局部时间"
  (lambda () (and (not 已结束?) (not (member? 阶段 '(选路 谈判)))))
  (lambda () (余时 'advance! -1)
    (if (余时 'empty?)
      (失败! "夜班的交接开始了，值班员回到岗位。尼尔没能在机会关闭前完成潜入。") #f)))
(define (on-scenario-enter)
  (余时 'load! 8)
  (set! 搜查分配 (random-choice '((材料 情报 账单) (材料 账单 情报) (情报 材料 账单) (情报 账单 材料) (账单 材料 情报) (账单 情报 材料))))
  (play-dialogue!
    (line "世界" "货运大楼后方的铁门锁着。尼尔要进入三楼档案室，找出罗科索款与威胁夜莺的材料。")
    (line "世界" "天亮之前完成潜入，全程共用八回合，换区域不刷新。警觉达到四点或时间耗尽，潜入失败。")))
(define (on-scenario-collapse) (collapse-result "失败"))
(define (get-render-data)
  (node "货运大楼潜入" :name "货运大楼"
    :anchor (阶段锚点)
    :children
    (append
      (list (note-node "潜入：目标" "目标"
        (cond ((eq? 阶段 '大门) "打开后方铁门，进入装卸场。")
          ((eq? 阶段 '选路) "在一楼选择一种上楼办法；两条路线互斥。")
          ((eq? 阶段 '装卸) "在二楼分拣货物，取得送运单上三楼的理由。")
          ((eq? 阶段 '通道) "在二楼贴着阴影穿过内部通道，抵达三楼。")
          ((eq? 阶段 '档案) (if 找到材料? "材料已找到，可以去谈判，也可以继续搜查其他对象。" "搜查文件柜、办公桌或外寄纸箱，找到夜莺的材料。"))
          (else "带着材料与罗科谈判，结束纠缠。"))))
      (if (member? 阶段 '(选路 谈判)) '()
        (list (clock-node "潜入：时间" (余时 'render-data))
          (clock-node "潜入：警觉" (警觉 'render-data))))
      (if (member? 阶段 '(大门 装卸 通道))
        (list (clock-node "潜入：进度" ((目标钟) 'render-data))) '())
      (cond
        ((eq? 阶段 '大门)
          (append
            (list (判定行动 "撬开铁门" "好2中1；失手警觉加1" 'sharpness '冒险 铁门 2 1 0))
            (if (门铃 'full?)
              (list (判定行动 "小心翼翼地打开铁门" "好2中1，失败不推进；不增加警觉" 'sharpness '稳妥 铁门 2 0 0))
              (list (clock-node "潜入：门铃" (门铃 'render-data))
                (判定行动 "破解门铃" "好2中1，失败不推进；不增加警觉" 'knowledge '稳妥 门铃 2 0 0)))))
        ((eq? 阶段 '选路)
          (list
            (node "混进装卸队" :anchor "货运大楼潜入-装卸入口" :subtitle "二楼分拣6格；完成后送运单上楼"
              :resolve (instant (outcome (lambda () (选路! '装卸)))))
            (node "绕行消防梯" :anchor "货运大楼潜入-消防梯入口" :subtitle "通道4格，天亮之前完成；进入警觉立即加1"
              :resolve (instant (outcome (lambda () (选路! '通道)))))))
        ((eq? 阶段 '装卸)
          (list (确定行动 "核对货件" "按单搬运并核清分拣货物" 装卸 1 0)
            (判定行动 "抢搬重货" "好3中1；失败耗1心情，不增加警觉" 'violence '冒险 装卸 3 0 1)))
        ((eq? 阶段 '通道)
          (list (判定行动 "贴着阴影走" "好2中1；失手警觉加1" 'sharpness '危险 通道 2 1 0)
            (确定行动 "抢穿走廊" "固定推进2，警觉加1" 通道 2 1)))
        ((eq? 阶段 '档案)
          (append
            (list (搜查对象 0) (搜查对象 1) (搜查对象 2))
            (if 找到材料?
              (list (node "与罗科谈判" :anchor "货运大楼潜入-档案室" :subtitle "带材料离开，结束搜查并与罗科谈判"
                :resolve (instant (outcome 谈判!)))) '())))
        (else (error "潜入：未知阶段"))))))
