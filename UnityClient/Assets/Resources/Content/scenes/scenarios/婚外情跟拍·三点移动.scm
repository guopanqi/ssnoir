;; 独立对照原型：东—中—西，每次沿边移动一格、消耗一骰。
;; 拍成（有效照片增长）后，当地被留意两轮；再次拍成刷新持续时间。
;; 当轮后续行动即生效，在第二次回合回应结束时消失。
;; 无用餐期限；沿用引擎回合冷静消耗。未接入城市委托。
(define finished? #f)
(define position 1) ; 0 东 / 1 中 / 2 西
(define watched-east 0)
(define watched-middle 0)
(define watched-west 0)
(define photos (make-clock "有效照片" 12 'gauge "满12完成取证；拍成后，该位置被留意两轮。"))
(define alertness (make-clock "对象警觉" 6 'gauge "满6暴露；被留意的位置每次拍摄额外增加1警觉。"))
(define (position-name n)
  (cond ((= n 0) "东侧") ((= n 1) "中间") ((= n 2) "西侧")
        (else (error "三点跟拍：非法位置"))))
(define (watched n)
  (cond ((= n 0) watched-east) ((= n 1) watched-middle) ((= n 2) watched-west)
        (else (error "三点跟拍：非法留意位置"))))
(define (watch! n)
  (cond ((= n 0) (set! watched-east 2))
        ((= n 1) (set! watched-middle 2))
        ((= n 2) (set! watched-west 2))
        (else (error "三点跟拍：非法留意位置"))))
(define (finish! result)
  (if finished? (error "三点跟拍：重复结算") #t)
  (set! finished? #t)
  (spotlight! "跟拍结束"
    (if (equal? result '完成) "你拍清了两人的面孔和亲昵动作，收起相机离开。"
      "男人站起来盯住街外。你带着已有照片离开。"))
  (end-scenario (list result (photos 'current) (alertness 'current))))
(define (check!)
  (cond ((photos 'full?) (finish! '完成))
        ((alertness 'full?) (finish! '暴露)) (else #f)))
(define (move! target)
  (if (= (abs (- position target)) 1) #t (error "三点跟拍：只能移动到相邻位置"))
  (set! position target))
(define (move-node target title)
  (node title :subtitle (string-append "花一骰，移到" (position-name target))
    :requires (list (req-die))
    :resolve (instant (outcome (lambda () (move! target))))))
(define (shoot! grade)
  (let ((gain (cond ((equal? grade '好) (+ position 1))
                   ((equal? grade '中) position) (else 0)))
        (risk (cond ((equal? grade '坏) (+ position 1))
                   ((and (= position 2) (equal? grade '中)) 1) (else 0)))
        (was-watched? (> (watched position) 0)))
    ;; 先读取行动前状态：首次拍成不收费，后续才付当地留意的代价。
    (if was-watched? (set! risk (+ risk 1)) #f)
    (photos 'advance! gain)
    (alertness 'advance! risk)
    (if (> gain 0)
      (begin (watch! position)
        (if was-watched? #f
          (play-bubble! (line "世界"
            (string-append "有人朝" (position-name position) "望过来。再拍会引起注意。"))))) #f)
    (check!)))
(define (photo-node)
  (node "拍摄取证"
    :subtitle (cond ((= position 0) "东侧远景：好1，中0，坏警觉1")
                    ((= position 1) "中间侧窗：好2，中1，坏警觉2")
                    (else "西侧近景：好3，中2警觉1，坏警觉3"))
    :tags (list (if (= position 0) "低风险" "高风险"))
    :requires (list (req-die))
    :resolve (roll 'sharpness
      (outcome (lambda () (shoot! '坏)))
      (outcome (lambda () (shoot! '中)))
      (outcome (lambda () (shoot! '好))))))
(define-opponent-rule "各处注意消退"
  (lambda () (not finished?))
  (lambda ()
    (set! watched-east (max 0 (- watched-east 1)))
    (set! watched-middle (max 0 (- watched-middle 1)))
    (set! watched-west (max 0 (- watched-west 1)))))
(define (on-scenario-enter)
  (play-dialogue!
    (line "世界" "两人在饭店吃饭。你从中间的侧窗开始取景。")
    (line "世界" "东侧远，西侧近。每次移动花一骰，只能走到相邻位置。")
    (line "世界" "拍成后，当地会被留意两轮。可以继续拍，也可以换位置。")))
(define (on-scenario-collapse)
  (collapse-result (list '倒下 (photos 'current) (alertness 'current))))
(define (position-note n)
  (note-node (string-append "标注：" (position-name n))
    (string-append (position-name n) (if (= position n) " · 你在这里" ""))
    (if (> (watched n) 0)
      (string-append "有人在看：剩" (number->string (watched n))
        "轮；此处每拍一次额外警觉1。拍成刷新为2轮。")
      "无人留意；拍成后被留意两轮。")))
(define (get-render-data)
  (container "三点移动跟拍"
    (append
      (clock-nodes (photos 'render-data) (alertness 'render-data))
      (list (note-node "标注：路线" "东侧 — 中间 — 西侧"
        "每一步花一骰。留意在第二次回合结束后消失；移动不会清除。")
        (position-note 0) (position-note 1) (position-note 2) (photo-node))
      (if (> position 0) (list (move-node (- position 1) "向东一步")) '())
      (if (< position 2) (list (move-node (+ position 1) "向西一步")) '()))))
