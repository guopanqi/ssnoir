;; 独立测试入口，暂不替换城市汤米线。
(define 结束? #f)
(define 查明? #f)
(define 取回? #f)
(define 登记 (make-clock "核对寄存牌" 4 'gauge "查清大衣与寄存牌的去向。" :beneficial-direction 'increase))
(define 证词 (make-clock "问清出入人员" 3 'gauge "让车童说出拿走大衣的人。" :beneficial-direction 'increase))
(define 余时 (make-clock "宴会耐心" 3 'countdown "回合末减少；归零前未交还金表，经理接手调查。" :beneficial-direction 'increase))
(define 汤米 (speaker "金表汤米" :name "汤米" :appearance '成年男性))
(define 经理 (speaker "金表经理" :name "经理" :appearance '成年男性))
(define 侄子 (speaker "金表侄子" :name "老板的侄子" :appearance '成年男性))
(define (推进! c grade)
  (if (eq? grade '坏) (spend-composure! 1)
    (begin (c 'advance! (if (eq? grade '好) 2 1))
      (if (c 'full?)
        (begin (set! 查明? #t)
          (play-dialogue!
            (line "世界" "寄存牌被故意调换过。登记上的笔迹与车童所见指向同一个人：老板的侄子。他还在楼上的侧间。")
            (line 汤米 "侍者没拿错，是有人让他拿错。"))) #f))))
(define (调查行动 id text skill c)
  (node id :subtitle text :requires (list (req-die)) :risk '冒险
    :risk-target (list 'composure "player")
    :clocks (list (c 'render-data))
    :progress-target (list 'clock (list-ref (c 'render-data) 1))
    :resolve (roll skill
      (outcome (lambda () (推进! c '坏)))
      (outcome (lambda () (推进! c '中)))
      (outcome (lambda () (推进! c '好))))))
(define (取表!)
  (play-dialogue!
    (line "尼尔" "你换了寄存牌，把表装进别人的大衣。")
    (line 侄子 "你要多少钱才肯闭嘴？")
    (line "尼尔" "经理请我找表。把它拿出来，别再让衣帽间那个孩子替你担着。")
    (line "世界" "侄子把金怀表放在桌上。他欠了赌债，本想拿去抵押，再悄悄赎回来。债主偏偏也是今晚的客人。")
    (line "尼尔" "你偷了自己叔叔的表？")
    (line 侄子 "借的。")
    (line "尼尔" "那为什么不问他？"))
  (set! 取回? #t))
(define (交还!)
  (set! 结束? #t)
  (play-dialogue!
    (line "世界" "经理打开表盖，确认了里面刻着的名字。尼尔将调换寄存牌和侄子的事一并告诉他。")
    (line 经理 "侍者回去工作。其他的交给我。")
    (line "世界" "老板没有当众发火，只把侄子叫进另一间包厢。客人重新端起酒杯。经理让汤米以后直接来楼上领差事。")
    (line 汤米 "尼尔，我觉得我快要发财了。"))
  (end-scenario "找回金表"))
(define-opponent-rule "金表：宴会等待"
  (lambda () (not 结束?))
  (lambda () (余时 'advance! -1)
    (if (余时 'empty?)
      (begin (set! 结束? #t)
        (play-dialogue! (line 经理 "先到这里。我接着查，侍者也不能凭怀疑就定罪。"))
        (end-scenario "未能交还金表")) #f)))
(define (on-scenario-enter)
  (余时 'load! 3)
  (play-dialogue!
    (line "世界" "夜总会的私人宴会还没开始，老板的金怀表却不见了。大门关上，怀疑落到衣帽间的年轻侍者身上。")
    (line 汤米 "我偷偷打了电话。你替他找一找，别让这事闹大。")
    (line 经理 "我正式雇你调查。衣帽间、员工和相关客人，都可以查问。找到表，把事实交给我。")))
(define (on-scenario-collapse) (collapse-result "调查中断"))
(define (get-render-data)
  (container "夜总会"
    (append
      (list (note-node "金表：目标" "目标" (cond (取回? "将金表与调查事实交给经理。") (查明? "到侧间找老板的侄子，取回金表。") (else "调查衣帽间或门厅，查清金表去向；任一路查明即可。")))
        (clock-node "金表：余时" (余时 'render-data)))
      (cond
        (取回? (list (instant-action "交还经理" 交还!)))
        (查明? (list (instant-action "找侄子取表" 取表!)))
        (else (list
          (调查行动 "衣帽间" "核对衣物与寄存登记；好2中1，失败耗1心情" 'sharpness 登记)
          (调查行动 "门厅车童" "问清谁拿走大衣；好2中1，失败耗1心情" 'social 证词)))))))
