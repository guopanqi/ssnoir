;; 独立原型：三路段，车距双边界；暂不接城市案件。
(define 路段 0)
(define 车距 2)
(define 调整过? #f)
(define 结束? #f)
(define 路线 (make-clock "确认行驶路线" 6 'gauge "跟完三个路段且路线已确认，才能查明目的地。" :beneficial-direction 'increase))
(define (路名) (list-ref '("剧院街区" "商业街路口" "旧港道路") 路段))
(define (路况) (list-ref '("出租车遮住前车；回合结束车距增加1。" "前车接近红灯；回合结束车距减少1。" "前车驶向空旷港区；回合结束车距增加1。") 路段))
(define (结局! why)
  (set! 结束? #t)
  (let ((clue (cond ((= 路段 0) "只记住黑色轿车与离开剧院的方向。")
                   ((= 路段 1) "已确认它穿过商业街，向旧港行驶。")
                   (else "已跟到旧港，记住了高架桥后的货运街区。"))))
    (play-dialogue! (line "世界" (string-append why clue)))
    (end-scenario (list "失手" 路段 clue))))
(define (移动车距! n)
  (set! 车距 (+ 车距 n))
  (cond ((<= 车距 0) (结局! "前车停在路边，司机回头盯住了尼尔。跟踪暴露了。"))
        ((>= 车距 4) (结局! "黑色轿车消失在前面的道路里。尼尔跟丢了。"))
        (else #f)))
(define (调整! direction grade)
  (if 调整过? (error "跟车：本回合已经调整过车距") #t)
  (set! 调整过? #t)
  (cond
    ((eq? direction '放慢) (移动车距! 1))
    ((eq? direction '跟近)
      (if (eq? grade '坏) (spend-composure! 1) (移动车距! -1)))
    ((eq? direction '抢行)
      (if (eq? grade '坏) (begin (spend-composure! 2) (移动车距! -1))
        (begin (路线 'advance! (if (eq? grade '好) 3 1)) (移动车距! -1))))
    (else (error "跟车：未知调整"))))
(define (观察! grade)
  (if (eq? grade '坏) (移动车距! 1)
    (路线 'advance! (if (eq? grade '好) 2 1))))
(define (判定卡 id text skill fn adjusting? risk)
  (node id :subtitle text :requires (list (req-die)) :risk risk
    :disabled (and adjusting? 调整过?)
    :resolve (roll skill
      (lambda () (if (and (not adjusting?) (= 车距 1)) (list (modifier 1 "看清前车"))
        (if (and (not adjusting?) (= 车距 3)) (list (modifier -1 "距离偏远")) '())))
      (outcome (lambda () (fn '坏)))
      (outcome (lambda () (fn '中)))
      (outcome (lambda () (fn '好))))))
(define-opponent-rule "跟车：道路变化"
  (lambda () (not 结束?))
  (lambda ()
    (移动车距! (list-ref '(1 -1 1) 路段))
    (if (not 结束?)
      (if (= 路段 2)
        (if (路线 'full?)
          (begin (set! 结束? #t)
            (play-dialogue! (line "世界" "黑色轿车驶入货运大楼的后院。尼尔没有跟进去，停在街角，记下地址与司机进去的门。"))
            (end-scenario (list "确认目的地" "货运大楼")))
          (结局! "前车驶入一片相似的院落，尼尔没能确认具体入口。"))
        (begin (set! 路段 (+ 路段 1)) (set! 调整过? #f)
          (play-dialogue! (line "世界" (list-ref '("" "车流涌入商业街，前方路口的灯转红了。" "车驶过高架桥，旧港的道路空旷起来。") 路段))))) #f)))
(define (on-scenario-enter)
  (play-dialogue!
    (line "世界" "彩排结束后，黑色轿车从剧院侧门缓缓驶离。尼尔开着经理借来的车，在两辆出租车后面跟上。")
    (line "世界" "跟完三个路段并确认路线。车距到零会暴露，到四会跟丢；每回合只能选择一次加速、放慢或抢行。")))
(define (on-scenario-collapse) (collapse-result (list "调查中断" 路段)))
(define (get-render-data)
  (container "雨夜跟车"
    (list
      (note-node "跟车：目标" "目标" "不暴露、不跟丢，跟完三个路段并确认目的地。路线满格不会提前结束。")
      (note-node "跟车：车距" "车距" (string-append (number->string 车距) "：" (list-ref '("暴露" "偏近" "合适" "偏远" "跟丢") (max 0 (min 4 车距))) "。偏近观察准备值+1，偏远-1；零或四立即失败。"))
      (note-node "跟车：路况" (路名) (路况))
      (note-node "跟车：调整额度" "车距调整" (if 调整过? "本回合已经调整；可继续确认路线或结束回合。" "本回合可调整一次；三种调整共用额度。"))
      (clock-node "跟车：路线" (路线 'render-data))
      (判定卡 "确认前车去向" "好2中1；失败车距增加1" 'sharpness 观察! #f '冒险)
      (判定卡 "加速跟近" "好中车距减少1；失败耗1心情" 'sharpness (lambda (g) (调整! '跟近 g)) #t '冒险)
      (node "放慢融入车流" :subtitle "一枚骰，车距增加1；占用本回合调整"
        :disabled 调整过? :requires (list (req-die))
        :resolve (instant (outcome (lambda () (调整! '放慢 '中)))))
      (判定卡 "抢过路口" "好3中1且车距减1；失败减距并耗2心情" 'sharpness (lambda (g) (调整! '抢行 g)) #t '危险))))
