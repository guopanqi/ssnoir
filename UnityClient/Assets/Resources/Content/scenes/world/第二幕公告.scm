;; 联合公告（第十三日）已经由第一幕世界日历发布。
;; 此处只决定玩家后来听见谁的反应，不把熟人全聚到一间屋子里。
(define 公告-艾迪看过? #f)
(define 公告-露西看过? #f)
(define 公告-夜莺看过? #f)
(define 公告-夜莺回答 "未答复")
(define (公告-艾迪!)
  (set! 公告-艾迪看过? #t)
  (play-dialogue!
    (line "世界" "艾迪把一副没有破洞的旧手套推给尼尔。")
    (line "艾迪" "你那双手套不能再用了。先穿这副。")
    (line "尼尔" "那你自己呢？")
    (line "艾迪" "别操心我。你看见早上的改造海报了吗？")
    (line "艾迪" "上面连工棚都画没了。希望他们记得这儿还有人在干活。")
    (line "弗兰克" "先问清楚谁要搬走。漂亮的画不能当饭吃。")))
(define (公告-露西!)
  (set! 公告-露西看过? #t)
  (play-dialogue!
    (line "世界" "咖啡馆柜台上贴着夜莺的首演海报。")
    (line "露西" "她真的要在大剧院开唱了！我以前给她端过茶呢。")
    (line "尼尔" "你看起来很高兴。")
    (line "露西" "当然。不过旧港要改造的话，这家店明年还在吗？")
    (line "露西" "我还没学会打字呢，可别先让我失业。")))
(define (公告-夜莺!)
  (set! 公告-夜莺看过? #t)
  (play-dialogue!
    (line "世界" "夜莺站在大剧院的新海报前，读了很久。")
    (line "夜莺" "他们说我要成为这座城的一张新面孔。")
    (line "夜莺" "听起来很好，是不是？我等了好多年。")
    (line "夜莺" "可稿子把旧港写成人人都想逃走的地方。")
    (line "夜莺" "你现在也去那儿干活。你会怎么想？")))
(define (公告-回应! answer)
  (set! 公告-夜莺回答 answer)
  (play-dialogue!
    (line "尼尔" (if (equal? answer "祝福")
      "先唱好你的歌。你等这一天很久了。"
      "旧港的人不该被写成你的反面故事。"))
    (line "夜莺" (if (equal? answer "祝福")
      "我会唱好的。但事情好像比我想的复杂。"
      "我知道。可如果我现在说不，他们还会让我上台吗？"))))
(define (公告-入场 loc)
  (cond
    ((and (>= world-day 13) (equal? loc "码头")
          (第一幕 'eddie-met?) (not 公告-艾迪看过?))
      (list (arrival "公告：码头" 公告-艾迪!)))
    ((and (>= world-day 13) (equal? loc "街角咖啡馆")
          (第一幕 'lucy-met?) (not 公告-露西看过?))
      (list (arrival "公告：咖啡馆" 公告-露西!)))
    ((and (>= world-day 13) (equal? loc "剧院")
          (> (第一幕 'singer-stage) 0) (not 公告-夜莺看过?))
      (list (arrival "公告：夜莺" 公告-夜莺!)))
    (else '())))
(define (公告-节点 loc)
  (if (and (>= world-day 13) (equal? loc "剧院")
           公告-夜莺看过? (equal? 公告-夜莺回答 "未答复"))
    (list (container "你怎么看？" (list
      (instant-action "祝她成功" (lambda () (公告-回应! "祝福")))
      (instant-action "替旧港说话" (lambda () (公告-回应! "质疑"))))))
    '()))
(define (第二幕公告 . args)
  (cond
    ((eq? (car args) 'arrivals-at) (公告-入场 (cadr args)))
    ((eq? (car args) 'nodes-at) (公告-节点 (cadr args)))
    ((eq? (car args) 'singer-answer) 公告-夜莺回答)
    ((eq? (car args) 'save)
      (list (list "eddie" 公告-艾迪看过?)
            (list "lucy" 公告-露西看过?)
            (list "singer" 公告-夜莺看过?)
            (list "answer" 公告-夜莺回答)))
    ((eq? (car args) 'load!)
      (let ((data (cadr args)))
        (set! 公告-艾迪看过? (assoc-get data "eddie" #f))
        (set! 公告-露西看过? (assoc-get data "lucy" #f))
        (set! 公告-夜莺看过? (assoc-get data "singer" #f))
        (set! 公告-夜莺回答 (assoc-get data "answer" "未答复"))
        (if (member? 公告-夜莺回答 '("未答复" "祝福" "质疑"))
          #t (error "联合公告：非法回答存档"))))
    (else (error "第二幕公告：未知消息"))))
