;; D13公共消息不等待支线。每个人留在自己的生活里，不轮番发表同一段担忧。
(define 公告-艾迪看过? #f)
(define 公告-露西看过? #f)
(define 公告-夜莺看过? #f)
(define (公告-艾迪!)
  (set! 公告-艾迪看过? #t)
  (play-dialogue!
    (line "艾迪" "货栈外墙那道白线，看见了吗？昨天收工还没有。")
    (line "尼尔" "有人来量过了？")
    (line "艾迪" "一早就来了。我们还在卸货，他们就拿皮尺量来量去，叫谁都得让路。")))
(define (公告-露西!)
  (set! 公告-露西看过? #t)
  (play-dialogue! (line "露西" "海报里的她真漂亮。以前来咱们店里，总坐最靠里的那张桌子。")))
(define (公告-夜莺!)
  (set! 公告-夜莺看过? #t)
  (play-dialogue!
    (line "世界" "夜莺停在新贴的首演海报前，手指轻轻掠过自己的名字。")
    (line "夜莺" "字印得真大。以前酒馆门口那块黑板，总得给我的名字挤点地方。")
    (line "尼尔" "你等这一天很久了。")
    (line "夜莺" "嗯。可下面这几句，把旧港写得像人人都恨不得逃走。")
    (line "尼尔" "你以前那些歌，也是在那儿唱出来的。")
    (line "夜莺" "我知道。我想留住那些日子，也想站在这里。总该有个办法。")))
(define (第二幕公告 . args)
  (cond
    ((eq? (car args) 'arrivals-at)
      (let ((loc (cadr args)))
        (if (>= world-day 13)
          (cond
            ((and (第一幕 'eddie-met?) (not 公告-艾迪看过?)
                  (第二幕 'eddie-on-dock?) (equal? loc "码头"))
              (list (arrival "货栈白线" 公告-艾迪!)))
            ((and (equal? loc "街角咖啡馆") (第一幕 'lucy-met?) (第二幕 'lucy-at-cafe?) (not (第二幕 'lucy-arrival-pending?)) (not 公告-露西看过?))
              (list (arrival "露西看海报" 公告-露西!)))
            ((and (equal? loc "剧院") (> (第一幕 'singer-stage) 0) (not 公告-夜莺看过?))
              (list (arrival "首演海报" 公告-夜莺!)))
            (else '())) '())))
    ((eq? (car args) 'nodes-at)
      (if (and (>= world-day 13) (equal? (cadr args) "码头"))
        (list (at-anchor "码头-货堆" (note-node "改造测绘线" "货栈外墙"
          "货栈外墙新画了一道白线，墙脚立着测绘木桩。扛货的人得绕开走。"))) '()))
    ((eq? (car args) 'save) (list (list "eddie" 公告-艾迪看过?) (list "lucy" 公告-露西看过?) (list "singer" 公告-夜莺看过?)))
    ((eq? (car args) 'load!)
      (let ((d (cadr args)))
        (set! 公告-艾迪看过? (assoc-get d "eddie" #f))
        (set! 公告-露西看过? (assoc-get d "lucy" #f))
        (set! 公告-夜莺看过? (assoc-get d "singer" #f))))
    (else (error "第二幕公告：未知消息"))))
