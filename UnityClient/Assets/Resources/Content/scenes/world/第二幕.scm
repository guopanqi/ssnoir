;; 所有相对日期均从真实世界日推导，展示不另存倒计时。
(define (第二幕-日期 day)
  (let ((left (- day world-day)))
    (cond ((= left 0) "今天") ((= left 1) "明天") ((= left 2) "后天")
      ((> left 2) (string-append (number->string left) "天后"))
      (else (error "第二幕：不能预告过去的日期")))))
(define (第二幕-期限钟 label day first-day)
  (clock-priority
    (list 'clock label (+ 1 (- day world-day)) (+ 1 (- day first-day))
      'countdown "今晚结束后少一天，归零后不能再参与。") 'secondary))

(define 咖啡馆老板 (speaker "咖啡馆老板" :name (tr "老板" "Owner") :appearance '成年男性))

(define 第二幕
  (let ()
    (define wage-state "未做")
    (define lucy-state "未做")
    (define lucy-cover-clock (make-clock "去学校的时间" 4 'gauge "替她接下几段晚班，老板才肯让她去学校。还没接上的班，也可以请人代。" :beneficial-direction 'increase))
    (define lucy-result-known? #f)
    (define wage-introduced? #f)
    (define wage-intro-day 0)
    (define wage-end-day 0)
    (define eddie-visited? #f)
    (define lucy-enrolled-day 0)
    (define lucy-school-known? #f)
    (define lucy-class-talk? #f)
    (define lucy-introduced? #f)
    (define (active?) (and (= (第一幕 'act) 2) (not (第二章 'started?))))
    ;; 第九天以后是长遭遇窗口，不要求玩家恰好在某日到场。
    ;; 工作中的铺垫若刚发生，至少留到下一日；从未听说也可以撞见冲突。
    (define (wage-open?) (and (active?) (>= world-day 10)
      (or (not wage-introduced?) (> world-day wage-intro-day))
      (equal? wage-state "未做")))
    (define (lucy-open?) (and (active?) (<= world-day 12) (equal? lucy-state "未做")))
    (define (wage-intro-open?) (and (active?) (>= world-day 10) (equal? wage-state "未做")))
    (define (wage-end result)
      (if (member? result '(拿回工钱 凭证核清 保住工作 弗兰克调停 撤出)) #t
        (error "工钱交锋：非法结算"))
      (set! wage-state (symbol->string result))
      (set! wage-end-day world-day))
    (define (eddie-on-dock?)
      (not (and (> wage-end-day 0) (> world-day wage-end-day)
        (<= world-day (+ wage-end-day (if (equal? wage-state "撤出") 2 1)))
        (member? wage-state '("拿回工钱" "撤出")))))
    (define (lucy-at-cafe?)
      ;; 入学手续与第一堂课占两班；此后隔一天上课。不引入早晚时段。
      (if (= lucy-enrolled-day 0) #t
        (let ((elapsed (- world-day lucy-enrolled-day)))
          (not (or (= elapsed 1) (= elapsed 2)
                   (and (> elapsed 3) (= (modulo elapsed 2) 0)))))))
    (define (lucy-note)
      (cond
        ((not (lucy-at-cafe?)) "她去学校了，柜台下留着一本翻开的书。")
        ((and (equal? lucy-state "延后") lucy-result-known?)
          "她还在柜台忙碌，空时读书，准备下一期夜校。")
        (else "她在柜台后忙碌，把客人忘下的书收在一旁。")))
    (define (start-wage!)
      (set! wage-introduced? #t)
      (set! wage-state "争执中")
      (play-dialogue!
        (line "世界" "昨夜大船的工钱正在结算。年轻工人拿着少了十美元的工资单，站在桌前。")
        (line "年轻工人" "昨晚多干了半班，怎么反倒少了十块？")
        (line "工头" "单上写多少就是多少，后头还等着人。")
        (line "艾迪" "我看见他昨晚在东边干活。把底账拿来。")
        (line "工头" "你又不是账房。")
        (line "艾迪" "所以才让你拿账房的记录。该给他的，一分也不能少。"))
      (start-encounter "少了十块钱" wage-end))
    (define (visit-eddie!)
      (set! eddie-visited? #t)
      (play-dialogue!
        (line "世界" "艾迪坐在食堂后门的台阶上，手边放着一只空饭盒。")
        (line "艾迪" "工头不让我上工，我倒是有空吃顿安稳饭了。")
        (line "尼尔" "你那工友呢？")
        (line "艾迪" "还在干。那小子得养家。我少挣这两天，总比他丢了饭碗强。")
        (line "艾迪" "弗兰克在里面。他认识码头那些人，你要问什么，去找他。")))
    (define (school-news!)
      (set! lucy-school-known? #t)
      (play-dialogue!
        (line 咖啡馆老板 "找露西？她交了报名表，今天那班去学校了。")
        (line 咖啡馆老板 (if (<= (- world-day lucy-enrolled-day) 2)
          "报名、领书，还要听头一堂课。这两天都得我自己看柜台了。"
          "她隔一天去上一次课。今天去学校，明天这班才回来。"))))
    (define (class-talk!)
      (set! lucy-school-known? #t)
      (set! lucy-class-talk? #t)
      (play-dialogue!
        (line "露西" "老师让我们把一张收据从头读到尾。你猜怎么着？我以前找错过零钱。")
        (line "尼尔" "第一堂课就挣回学费了？")
        (line "露西" "还早呢。下回我得带店里的账单去。老板一听，比我还认真。")))
    (define (lucy-fee) (* 10 (- 4 (lucy-cover-clock 'current))))
    (define (lucy-finish!)
      (if (and (lucy-open?) (lucy-cover-clock 'full?)) #t
        (error "夜校代班：目标尚未完成或已经结束"))
      (set! lucy-state "已入学")
      (set! lucy-enrolled-day world-day)
      (play-dialogue!
        (line "露西" "班都有人接了。我明天就去学校，把那张表交上去。")
        (line "尼尔" "别再把它夹回书里了。")
        (line "露西" "不会。这回连铅笔都削好了。")))
    (define (lucy-cover! progress)
      (if (and (lucy-open?) lucy-introduced?) #t (error "夜校代班：当前不可投入"))
      (lucy-cover-clock 'advance! progress)
      (if (lucy-cover-clock 'full?) (lucy-finish!) #f))
    (define (lucy-pay!)
      (if (and (lucy-open?) lucy-introduced?) #t (error "夜校代班：当前不可付款"))
      (lucy-cover-clock 'advance! (lucy-cover-clock 'remaining))
      (lucy-finish!))
    (define (lucy-missed!)
      (set! lucy-result-known? #t)
      (play-dialogue!
        (line "世界" "柜台底下的招生纸换成了另一张。露西把旧纸折好，夹进书里。")
        (line "露西" (if (> (lucy-cover-clock 'current) 0)
          "你替的那几段我记着。剩下的还是没找齐人，学校那边已经收满了。"
          "我找过换班的人，有人病了，有人临时不肯来。学校那边已经收满了。"))
        (line "尼尔" "还有别的办法吗？")
        (line "露西" "下期再报。我先把书借回来，空下来自己看。")))
    ;; 私人的事情只在尼尔听到之后才进入手头的事。
    (define (lucy-story-pending?)
      (cond ((equal? lucy-state "已入学") (not lucy-class-talk?))
            ((equal? lucy-state "延后") (not lucy-result-known?))
            (else #t)))
    (define (eddie-story-pending?)
      (or (member? wage-state '("未做" "争执中" "自行处理"))
          (and (member? wage-state '("拿回工钱" "撤出"))
               (<= world-day (+ wage-end-day (if (equal? wage-state "撤出") 2 1))))))
    (define (known-matters)
      (append
        (if wage-introduced?
          (list (dossier "艾迪：工棚里的争执" :kind '人物
            :primary (eddie-story-pending?)
            :status (if (eddie-story-pending?) '进行中 '了结)
            :now (cond
              ((not (eddie-on-dock?)) "争执之后艾迪被停班，码头暂时没人替你救场。他在旧街食堂。")
              ((二幕余波-艾迪已知?) (二幕余波-艾迪近况))
              ((equal? wage-state "未做") "工友说工资被少算，艾迪准备找工头说理。下次上工时留意他的情况。")
              ((equal? wage-state "凭证核清") "凭工时记录核清差额，艾迪照常上工。")
              ((equal? wage-state "拿回工钱") "工钱拿回了，工头却让艾迪从明天起停一天班。")
              ((equal? wage-state "撤出") "冲突没有解决，工头让艾迪从明天起停两天班。")
              ((equal? wage-state "自行处理") "后来发生的事情还没问过艾迪。")
              (else "争执已经结束，可以再问问艾迪的近况。"))
            :steps (if (not (eddie-on-dock?))
              (list (step "到旧街食堂看看艾迪" eddie-visited?)) '())
            :where (if (eddie-on-dock?) "码头" "码头居民区"))) '())
        (if (or lucy-introduced? lucy-school-known? lucy-result-known?)
          (list (dossier "露西：夜校报名" :kind '人物 :primary (lucy-story-pending?)
            :status (if (lucy-story-pending?) '进行中 '了结)
            :now (cond
              ((and (equal? lucy-state "已入学") lucy-class-talk?)
                "露西已经回来，说起了第一堂课上核对收据的事。往后她会一边工作，一边上夜校。")
              ((equal? lucy-state "已入学")
                (if lucy-school-known?
                  (if (lucy-at-cafe?) "露西回店里了，忙完会说起学校的事。"
                    "露西去学校了，这班不在咖啡馆。")
                  "代班已安排好。露西准备去办入学手续，之后会少来几班。"))
              ((equal? lucy-state "延后")
                (if lucy-result-known? "代班没能安排齐，露西错过本期，正准备下一期。"
                  "报名截止了，还没见到露西问起后来怎么样。"))
              (else (string-append "报名" (第二幕-日期 12) "截止。代班还差"
                (number->string (- 4 (lucy-cover-clock 'current))) "段，可替班或付"
                (number->string (lucy-fee)) "美元请人。")))
            :where "街角咖啡馆")) '())))
    (define (nodes-at loc)
      (append
        (if (and (active?) (equal? loc "码头居民区")
                 (not (eddie-on-dock?)) (not eddie-visited?))
          (list (instant-action "看看艾迪" visit-eddie!)) '())
        (if (and (equal? loc "街角咖啡馆") (lucy-open?) lucy-introduced?)
          (list
            (clock-node "露西代班目标" (lucy-cover-clock 'render-data))
            (node "替露西顶班" :name "帮她顶班" :anchor "露西@咖啡馆"
              :subtitle "社交判定；坏无进展，中1格，好2格；不拿工资"
              :risk '稳妥 :progress-target (list 'clock "去学校的时间")
              :requires (list (req-die))
              :clocks (list (第二幕-期限钟 "报名截止" 12 6))
              :resolve (roll 'social
                (outcome (lambda () (lucy-cover! 0)))
                (outcome (lambda () (lucy-cover! 1)))
                (outcome (lambda () (lucy-cover! 2)))))
            (node "付代班费" :name "请人代班" :anchor "露西@咖啡馆"
              :subtitle (string-append "付" (number->string (lucy-fee)) "美元安排剩余代班")
              :requires (list (req-item "金钱" (lucy-fee)))
              :clocks (list (第二幕-期限钟 "报名截止" 12 6))
              :resolve (instant (outcome lucy-pay!)))) '())))
    ;; 熟人通过日常工作或主动交谈告诉尼尔，并不是每日进地点自动播放。
    (define (tell-wage!)
      (if wage-introduced? #f
        (begin
          (set! wage-introduced? #t)
          (set! wage-intro-day world-day)
          (play-dialogue!
            (line "艾迪" "一个工友说工钱少了十块。工头连账本都不肯给他看。")
            (line "尼尔" "你要去找他？")
            (line "艾迪" "那小子昨晚搬了半夜货。账错了，得有人替他说话。")))))
    (define (tell-lucy!)
      (set! lucy-introduced? #t)
      (play-dialogue!
        (line "世界" "露西擦完柜台，还攥着那张招生纸。老板正在排班表上画线。")
        (line "露西" "这次有空位了。我得去办手续，可这几段班没人接。")
        (line 咖啡馆老板 "四段。你找人接上，去学校的时间就给你留着。")
        (line "露西" (string-append "报名" (第二幕-日期 12) "截止。请人一段十块，我也在找肯换班的人。"))
        (line "尼尔" "我能替你守一部分。")
        (line "露西" "你也得挣钱。量力来，剩下的我再想办法。")))
    (define (arrivals-at location)
      (cond
        ((and (equal? location "码头") (wage-open?))
          (list (arrival "工棚冲突" start-wage!)))
        ((and (active?) (equal? location "街角咖啡馆")
              (not (lucy-at-cafe?)) (not lucy-school-known?))
          (list (arrival "露西去上课" school-news!)))
        ((and (active?) (equal? location "街角咖啡馆") (lucy-at-cafe?)
              (> lucy-enrolled-day 0) (>= world-day (+ lucy-enrolled-day 3))
              (not lucy-class-talk?))
          (list (arrival "露西从学校回来" class-talk!)))
        ((and (active?) (equal? location "街角咖啡馆")
              (equal? lucy-state "延后") (not lucy-result-known?))
          (list (arrival "露西没赶上本期" lucy-missed!)))
        (else '())))
    (define-turn-start-rule "第二幕事件期限"
      (lambda () #t)
      (lambda ()
        ;; 艾迪的遭遇不在第十一天凭空消失；离开这一幕后才由他自行处理。
        (if (and (第二章 'started?) (equal? wage-state "未做"))
          (begin (set! wage-state "自行处理") (set! wage-end-day world-day)) #f)
        (if (and (>= world-day 13) (equal? lucy-state "未做"))
          (set! lucy-state "延后") #f)))
    (lambda args
      (cond
        ((eq? (car args) 'wage-end-day) wage-end-day)
        ((eq? (car args) 'eddie-visited?) eddie-visited?)
        ((eq? (car args) 'lucy-at-cafe?) (lucy-at-cafe?))
        ((eq? (car args) 'lucy-note) (lucy-note))
        ((eq? (car args) 'lucy-enrolled-day) lucy-enrolled-day)
        ((eq? (car args) 'wage-state) wage-state)
        ((eq? (car args) 'eddie-on-dock?) (eddie-on-dock?))
        ((eq? (car args) 'on-dock-work!)
          (if (and (wage-intro-open?) (第一幕 'eddie-met?)
                   (not wage-introduced?))
            (tell-wage!) #f))
        ((eq? (car args) 'on-cafe-work!)
          (cond
            ((not (lucy-at-cafe?)) #f)
            ((and (active?) (> lucy-enrolled-day 0)
                  (>= world-day (+ lucy-enrolled-day 3)) (not lucy-class-talk?)) (class-talk!))
            ((and (lucy-open?) (第一幕 'lucy-met?)
                   (not lucy-introduced?)) (tell-lucy!))
            ((and (active?) (equal? lucy-state "延后") (not lucy-result-known?)) (lucy-missed!))
            (else #f)))
        ((eq? (car args) 'lucy-state) lucy-state)
        ((eq? (car args) 'dossier)
          (if (= (第一幕 'act) 2)
            (known-matters)
            '()))
        ((eq? (car args) 'nodes-at) (nodes-at (cadr args)))
        ((eq? (car args) 'arrivals-at) (arrivals-at (cadr args)))
        ((eq? (car args) 'save)
          (list (list "wage-intro-day" wage-intro-day) (list "wage-end-day" wage-end-day)
                (list "eddie-visited" eddie-visited?)
                (list "lucy-enrolled-day" lucy-enrolled-day)
                (list "lucy-school-known" lucy-school-known?) (list "lucy-class-talk" lucy-class-talk?)
                (list "wage" wage-state) (list "lucy" lucy-state)
                (list "wage-introduced" wage-introduced?)
                (list "lucy-introduced" lucy-introduced?)
                (list "lucy-progress" (lucy-cover-clock 'save))
                (list "lucy-result-known" lucy-result-known?)))
        ((eq? (car args) 'load!)
          (let ((data (cadr args)))
            (set! wage-intro-day (assoc-get data "wage-intro-day" 0))
            (set! wage-end-day (assoc-get data "wage-end-day" 0))
            (set! eddie-visited? (assoc-get data "eddie-visited" #f))
            (set! lucy-enrolled-day (assoc-get data "lucy-enrolled-day" 0))
            (set! lucy-school-known? (assoc-get data "lucy-school-known" #f))
            (set! lucy-class-talk? (assoc-get data "lucy-class-talk" #f))
            (set! wage-state (assoc-get data "wage" "未做"))
            (set! lucy-state (assoc-get data "lucy" "未做"))
            (set! wage-introduced? (assoc-get data "wage-introduced" #f))
            (set! lucy-introduced? (assoc-get data "lucy-introduced" #f))
            (if (> (assoc-get data "lucy-covered" 0) 0)
              (error "夜校代班已改为四格目标，旧版顶班进度不能直接读取") #t)
            (lucy-cover-clock 'load! (assoc-get data "lucy-progress" 0))
            (set! lucy-result-known? (assoc-get data "lucy-result-known" #f))
            (if (and (>= wage-intro-day 0) (>= wage-end-day 0) (>= lucy-enrolled-day 0)
                 (member? wage-state '("未做" "争执中" "拿回工钱" "凭证核清" "保住工作" "弗兰克调停" "撤出" "自行处理"))
                 (member? lucy-state '("未做" "已入学" "延后"))
                 (if (equal? lucy-state "已入学")
                   (and (lucy-cover-clock 'full?) (> lucy-enrolled-day 0))
                   (= lucy-enrolled-day 0))) #t
              (error "第二幕：剧情状态无效，请从本轮内容的新档开始"))))
        (else (error "第二幕：未知消息"))))))
