;; 可选彩排与悬疑谈话解耦；正式调查期间首次回旅馆发生宵夜。
(define 第二幕剧院
  (let ()
    (define talk-day 0)
    (define first-visit? #f)
    (define rehearsal-state "未参加")
    (define audience-day 0)
    (define private-seen? #f)
    (define audience-result "未发生")
    (define (active?) (and (= (第一幕 'act) 2) (not (第二章 'started?))))
    (define (performance-ready?)
      (and (active?) (member? rehearsal-state '("未参加" "待追查"))
        (> (第一幕 'rehearsal-day) 0)
        (>= world-day (+ (第一幕 'rehearsal-day) 3))))
    (define (first-visit!)
      (set! first-visit? #t)
      (play-dialogue!
        (line "世界" "夜莺从侧幕探出头来，看见尼尔，便领着他走向后台的经理。")
        (line "夜莺" "经理先生，这位是尼尔，就是我跟您说——")
        (line "经理" "尼尔？我们认识。")
        (line "世界" "经理放下账本，先伸出了手。夜莺看了看他们两个。")
        (line "尼尔" (if (经理的首单 'access?) "之前替经理办过一回事。" "在老街酒馆见过。"))
        (line "经理" "来得正好。她在走彩排，今天赞助人也来。愿意搭手，就找场务。")
        (line "夜莺" "那我先回台上了。你别急着走。"))
      (第二幕生活 'remember-manager!))
    (define (talk!)
      (if (= talk-day 0) #t (error "经理黑影谈话：重复"))
      (set! talk-day world-day)
      (play-dialogue!
    (line "世界" "剧院办公室里飘着雪茄和柠檬水的气味。夜莺坐在沙发边，把这几天有人尾随的事低声说了一遍。")
    (line "经理" "（听完后轻轻敲了敲桌面，眉头微蹙）大剧院的演员在街上被人盯着，传出去不仅姑娘受惊，剧院的脸面也挂不住。夜莺小姐，这几天排练完先走正门，别一个人钻后巷。")
    (line "夜莺" "麻烦您了，经理先生。")
    (line "经理" "（转向你）尼尔，你在街面上消息灵通。我会交代门房多留心。接下来有赞助人来看彩排，你也来看看。发现什么，再来告诉我。")))
    (define (rehearsal!)
      (set! rehearsal-state "彩排中")
      (start-scenario "第一次彩排" (lambda (result)
        (add-item! "金钱" (cond ((eq? result '两项交付) 50) ((eq? result '一项交付) 15) (else 0)))
        (set! rehearsal-state "待追查"))))
    (define (audience!)
      (set! rehearsal-state "追查中")
      (start-scenario "最后一排的观众" (lambda (result)
        (if (and (list? result) (= (length result) 2)
                 (member? (car result) '(车辆线索 错失车辆 倒下)))
          #t (error "彩排观众：非法追查结果"))
        ;; Scenario 返回带情报数的结果；章节与存档持有可序列化的结果名称。
        (set! audience-result (symbol->string (car result)))
        (set! audience-day world-day)
        (set! rehearsal-state "已结束")
        (第二幕生活 'remember-manager!))))
    (define (private!)
      (set! private-seen? #t)
      (restore-actor-composure! 'player 2)
      (play-dialogue!
    (line "世界" "走廊里很暗，尼尔开门前，看见夜莺站在他的房门边，手里提着个牛皮纸袋。听见脚步声，她转过身。")
    (line "夜莺" "你回来了。我跟房东说了一嘴，他在楼下看报，就让我上来等了。")
    (line "尼尔" "等多久了？快进来。")
    (line "世界" "房间里很窄，只有床、小桌和一把木椅。尼尔把桌上的杂物扫到一边，把唯一的椅子拉出来擦了擦。")
    (line "尼尔" "坐这儿吧。")
    (line "夜莺" "那你呢？")
    (line "尼尔" "我坐床沿就行，习惯了。"))
      (play-dialogue!
    (line "世界" "她打开纸袋，里面是两份火腿三明治和一罐热汤。她把大的那份递给尼尔，自己拿起小的，小口咬着。窗外偶尔有电车驶过的声音，屋里一时没人说话。")
    (line "尼尔" "大剧院那边还顺心吗？")
    (line "夜莺" "挺好的。就是地方太大了，昨天我在侧台等场，听见自己高跟鞋的声音在走廊里打回音，突然有点想念老吉姆那儿吵吵嚷嚷的样子。")
    (line "尼尔" "习惯就好了。")
    (line "夜莺" "嗯。罗科那事……不好查吧？看你这两天都没怎么睡好。")
    (line "尼尔" "还在找线头。慢慢来吧。")
    (line "夜莺" "这两天你老往外跑，今晚先吃顿热的。把汤喝了吧，凉了就腻了。")
    (line "世界" "尼尔接过汤罐喝了一口。两人在小桌边安静地把饭吃完，夜莺把纸袋折好收起来，站起身。")
    (line "夜莺" "我回去了。明早还要练声，不用送我，就在楼下拦车。")
    (line "尼尔" "我送你到楼梯口。")))
    (lambda (msg . args)
      (cond
        ((eq? msg 'nodes-at)
          (if (and (active?) (equal? (car args) "剧院"))
            (append
              (if (= talk-day 0)
                (list (node "和经理谈黑影" :name "提起黑衣人" :anchor "剧院-后台" :button-text "交谈"
                  :subtitle "向经理提起尾随夜莺的那个人。" :resolve (instant (outcome talk!)))) '())
              (if (performance-ready?)
                (list (node "赞助人到场演出" :name "赞助人彩排" :anchor "剧院-中央台" :button-text "执行"
                  :required-before-rest "先处理剧院的赞助人彩排"
                  :subtitle "到观众席观看；进入后播放彩排收场与后续事件。"
                  :resolve (instant (outcome audience!)))) '())
              (if (and (equal? rehearsal-state "未参加") (not (performance-ready?)))
                (list (node "赞助人彩排" :name "参加彩排" :anchor "剧院-后台" :button-text "执行"
                  :subtitle "赞助人来看夜莺的彩排；帮场务完成换景和灯位。"
                  :resolve (instant (outcome rehearsal!)))) '())) '()))
        ((eq? msg 'arrivals-at)
          (if (and (active?) (equal? (car args) "剧院") (not first-visit?))
            (list (arrival "夜莺在剧院介绍尼尔" first-visit!))
          '()))
        ((eq? msg 'supper-seen?) private-seen?)
        ((eq? msg 'supper!) (private!))
        ((eq? msg 'case-followup-ready?) (and (> audience-day 0) (>= world-day (+ audience-day 2))))
        ((eq? msg 'trial-pending?) #f)
        ((eq? msg 'audience-result) audience-result)
        ((eq? msg 'promise-trial!) #t)
        ((eq? msg 'dossier)
          (if (not (active?)) '()
            (list (dossier "夜莺：大剧院" :kind '人物 :where "剧院"
              :status (if (第三幕 'started?) '了结 '进行中)
              :now (cond ((第三幕 'started?) "经理已提出正式调查。夜莺继续在剧院工作。")
                ((equal? rehearsal-state "已结束") "彩排后的黑衣人追查已经结束。两天后回城市地图，等经理的调查消息。")
                ((> talk-day 0) "夜莺正在剧院彩排。经理已听说尾随者的事，交代门房多留心。")
                (else "夜莺已在剧院开始彩排，正逐渐熟悉新舞台。"))))))
        ((eq? msg 'save) (list (list "first-visit" first-visit?) (list "rehearsal-state" rehearsal-state) (list "audience-day" audience-day) (list "talk-day" talk-day) (list "private" private-seen?) (list "audience-result" audience-result)))
        ((eq? msg 'load!) (let ((s (car args)))
          (set! first-visit? (assoc-get s "first-visit" #f))
          (set! talk-day (assoc-get s "talk-day" (if (assoc-get s "performance" #f) (max 1 (- world-day 2)) 0)))
          (set! rehearsal-state (assoc-get s "rehearsal-state" "未参加"))
          (set! audience-day (assoc-get s "audience-day" 0))
          (set! private-seen? (assoc-get s "private" #f)) (set! audience-result (assoc-get s "audience-result" "未发生"))
          (if (>= talk-day 0) #t (error "剧院：非法谈话日期"))))
        (else (error "第二幕剧院：未知消息"))))))
