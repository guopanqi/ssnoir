;; 艾迪新生活：不依附罗科案件。日期集中定义；私人记忆只由实际行动写入。
(define 艾迪生活
 (let ()
  (define 舞厅开始日 12)
  (define 舞厅结束日 17)
  (define 正式受聘日 18)
  (define 租房日 22)
  (define 入住日 24)
  (define 生活回访日 26)
  (define dance "未邀请") ; 未邀请／待答复／参加／婉拒／错过
  (define job-known? #f)
  (define celebrated? #f)
  (define home-known? #f)
  (define moved-with? #f)
  (define visited? #f)
  (define clearance "未决定") ; 未决定／保留／取消
  (define ending-seen? #f)
  (define (active?) (and (>= (第一幕 'act) 2) (not (第二章 'started?))))
  (define (known?) (第一幕 'eddie-met?))
  (define (hired?) (>= world-day 正式受聘日))
  (define (moved?) (>= world-day 入住日))
  (define (home-present?) (not (= (modulo world-day 3) 0)))
  (define (ensure! ok text) (if ok #t (error text)))
  (define (invite-dance!)
    (set! dance "待答复")
    (play-dialogue!
      (line "世界" "艾迪站在吧台边，西服肩膀宽了一截，头发却梳得很认真。")
      (line "艾迪" "码头今晚用不着我。我想去舞厅，你来不来？")
      (line "尼尔" "你这身像偷穿了工头的衣服。")
      (line "艾迪" (string-append "借的，不许磨黑袖口。最后一晚是" (第二幕-日期 (- 舞厅结束日 1)) "。想来就在酒馆找我。"))))
  (define (dance! attend?)
    (ensure! (and (active?) (known?) (equal? dance "待答复") (< world-day 舞厅结束日)) "舞厅：邀请已过期")
    (set! dance (if attend? "参加" "婉拒"))
    (play-dialogue!
      (line "世界" (if attend?
        "舞厅里，艾迪刚说自己跳得不错，就被椅脚绊了一下。尼尔扶住他的胳膊，两个人都笑了。"
        "尼尔说今晚有别的安排。艾迪理了理袖口，仍旧推门走向舞厅。"))
      (line "艾迪" (if attend? "我想请她跳一支。你可别替我说。" "行，别把整晚都用来搬箱子。"))
      (line "世界" (if attend?
        "他终于走过去，第一句话说得太快，只好再说一遍。姑娘笑着听完，答应跳一支；下一支，她要和朋友跳。艾迪回来时脸还红着。"
        "那个晚上他自己过。尼尔没有舞池里的共同记忆。"))))
  (define (job-news!)
    (第一幕 'meet-eddie!)
    (set! job-known? #t)
    (play-dialogue!
      (line "世界" "工头念过装卸班的名字。艾迪没有像往常那样再去等下一张临时工票。")
      (line "艾迪" "往后这班有我的位置了。固定的工钱，固定的日子。")
      (line "尼尔" "大船那一班让工头记住你了？")
      (line "艾迪" "那班，还有这些天。大家知道我能搭哪头绳子。不是让我管修机器，我可没那本事。")
      (line "艾迪" (if (< world-day 租房日)
        "这几晚到酒馆找我，我请。也该想想能不能租间自己的屋子了。"
        "酒我已经请过他们了。我还租了间朝港口的屋子，改天来坐。"))))
  (define (celebrate!)
    (ensure! (and (active?) job-known? (hired?) (< world-day 租房日) (not celebrated?)) "艾迪庆祝：当前不可参加")
    (set! celebrated? #t)
    (play-dialogue!
      (line "世界" "艾迪把酒端到工友的桌上，尼尔替他让出一个位置。")
      (line "艾迪" "以前不知道下星期在哪干。这回总算能算一算房租。")
      (line "尼尔" "所以今天酒钱你算？")
      (line "艾迪" "第一轮。你喝慢点，我还得攒桌子钱。")))
  (define (home-news!)
    (if (not job-known?) (job-news!) #f)
    (set! home-known? #t)
    (play-dialogue!
      (line "艾迪" (if (moved?)
        "我搬进去了，窗户朝港口。码头居民区那排公寓，来时敲门就行。"
        (string-append "房租交了，窗户朝港口。" (第二幕-日期 入住日) "入住，之前有空来码头居民区搭把手？")))
      (line "尼尔" (if (moved?) "你自己搬的？" "总算轮到我帮你搬东西了。"))
      (line "艾迪" (if (moved?) "找了两个工友。已经安顿好了，来坐坐。" "你来就好。不来我也得找人搬，不能让屋子空着。"))))
  (define (move!)
    (ensure! (and (active?) home-known? (>= world-day 租房日) (not (moved?)) (not moved-with?)) "艾迪搬家：当前不在搬家窗口")
    (set! moved-with? #t)
    (play-dialogue!
      (line "世界" "尼尔帮艾迪把家具与生活物件搬进新屋。码头的汽笛从敞开的窗户飘进来。")
      (line "艾迪" "以前总是在搬别人的东西。这回搬完，是我的家。")
      (line "世界" "他们收拾出坐的地方，留下吃了顿不太高明的晚饭。艾迪尝了一口，决定先把锅从火上拿下来。")
      (line "尼尔" "搬运你先教我，做饭咱们一起慢慢学。")))
  (define (visit!)
    (ensure! (and (active?) home-known? (or moved-with? (moved?)) (home-present?)) "艾迪回访：他今天不在家")
    (set! visited? #t)
    (play-dialogue!
      (line "世界" (cond
        ((equal? clearance "取消") "艾迪把账单和招工广告放在桌边，挪开给尼尔腾地方。")
        ((>= world-day 生活回访日) "墙上新挂了一幅风景画。艾迪把两件衬衫摊在床上，问哪件看起来不像刚下夜班。")
        (else "艾迪在窗边挪出位置。窗外是港口，桌上已经放得下两只杯子。")))
      (line "艾迪" (cond
        ((equal? clearance "取消") "有两处在招人，我准备去问问。先坐，饭总还是要吃的。")
        ((>= world-day 生活回访日) "上回夜班，把约好的饭错过去了。这回我可得记准。")
        (moved-with? "上次那顿算练手。这回我没让锅烧那么久。")
        (else "你头回来吧？随便坐。我搬进来才发现，椅子真不够。")))
      (line "尼尔" (if (equal? dance "参加") "挑衣服这事，我可记着你舞厅那件西服。" "有窗，有地方请朋友坐，挺好了。"))))
  (define (on-clearance! allowed?)
    (ensure! (and (>= world-day 入住日) (or (equal? allowed? #t) (equal? allowed? #f)) (equal? clearance "未决定")) "艾迪：清场结果不可重复或非法")
    (set! clearance (if allowed? "取消" "保留")))
  (define (ending!)
    (set! ending-seen? #t)
    (play-dialogue!
      (line "世界" (if (equal? clearance "取消") "装卸班的岗位牌被撤下，艾迪收好工具。" "装卸班照常开工。艾迪在下工时朝尼尔招手。"))
      (line "艾迪" (if (equal? clearance "取消") "再找就是了。我这两只手还在。你吃饭没有？" "星期天来坐坐？这回我先试过再做给你吃。"))
      (line "世界" (if (equal? clearance "取消")
        "他回家把账单摊在桌上，翻起招工广告。房租还有些余地，却得重新算着花钱。"
        "他回到自己的屋子，继续安排下一个休息日。未来并非没有变化，眼前的日子仍能过下去。"))))
  (define-turn-start-rule "艾迪舞厅窗口结束"
    (lambda () (and (active?) (>= world-day 舞厅结束日) (member? dance '("未邀请" "待答复"))))
    (lambda () (set! dance "错过")))
  (define (arrivals-at loc)
    (if (not (active?)) '()
      (cond
        ((and (equal? loc "码头") (>= world-day 租房日) (not home-known?)) (list (arrival "艾迪的新住处消息" home-news!)))
        ((and (equal? loc "码头") (hired?) (not job-known?)) (list (arrival "艾迪的正式班表" job-news!)))
        ((and (equal? loc "老街酒馆") (known?) (>= world-day 舞厅开始日) (< world-day 舞厅结束日) (equal? dance "未邀请")) (list (arrival "艾迪今晚不上工" invite-dance!)))
        (else '()))))
  (define (nodes-at loc)
    (if (not (active?)) '()
      (append
        (if (and (equal? loc "老街酒馆") (equal? dance "待答复") (< world-day 舞厅结束日))
          (list (node "陪艾迪去舞厅" :subtitle "一枚骰，和他出去玩一晚；不影响他的工作"
                  :requires (list (req-die)) :resolve (instant (outcome (lambda () (dance! #t)))))
                (instant-action "婉拒舞厅邀请" (lambda () (dance! #f)))) '())
        (if (and (equal? loc "老街酒馆") job-known? (hired?) (< world-day 租房日) (not celebrated?))
          (list (instant-action "为艾迪庆祝" celebrate!)) '())
        (if (and (equal? loc "码头居民区") home-known?)
          (list (container "艾迪的新房"
            (append
              (if (and (>= world-day 租房日) (not (moved?)) (not moved-with?))
                (list (node "帮艾迪搬家" :subtitle "一枚骰，帮他搬进新屋；不参加他也会入住"
                  :requires (list (req-die)) :resolve (instant (outcome move!)))) '())
              (if (or moved-with? (moved?))
                (if (home-present?)
                  (list (node "到艾迪家坐坐" :subtitle "看看近况，和朋友聊几句" :use-limit 'daily-once
                    :resolve (instant (outcome visit!))))
                  (list (note-node "艾迪今天外出" "" "门关着。他今天有自己的安排，改天再来。"))) '())))) '())
        (if (and (equal? loc "码头") (known?) (not (equal? clearance "未决定")) (not ending-seen?))
          (list (instant-action "艾迪接下来的日子" ending!)) '()))))
  (define (dossier-at)
    (if (or (not (active?)) (not (known?))) '()
      (list (dossier "艾迪的生活" :kind '人物 :status (if ending-seen? '了结 '进行中)
        :now (cond
          ((not (equal? clearance "未决定")) (if (equal? clearance "取消") "原装卸岗位被清场打断；艾迪开始找工，住处并未立刻失去。" "装卸工作与新生活暂时延续。"))
          (home-known? (if (or moved-with? (moved?)) "艾迪已经在朝港口的新屋住下。可以继续来往，看看他的日常。" "艾迪租了间朝港口的屋子，正在安排搬家。"))
          (job-known? "艾迪成了正式装卸班组的一员，想请朋友喝酒。")
          ((equal? dance "待答复") "艾迪穿着不合身的西服，邀你这几晚去舞厅。")
          (else "码头的工友艾迪继续上工。下次来工作，还能和他碰面。"))
        :steps (list (step (cond
          ((and (not (equal? clearance "未决定")) (not ending-seen?)) "去码头见艾迪，听听接下来怎样过日子。")
          (home-known? (if (or moved-with? (moved?)) "码头居民区有他的新房；他有时外出，不必等着你。" "入住前可去码头居民区帮他搬家。错过仍可日后来坐坐。"))
          (job-known? (if (< world-day 租房日) "这几晚可到老街酒馆祝贺他；之后到码头听听租房的消息。" "再去码头找他，听听新住处的消息。"))
          ((equal? dance "待答复") "老街酒馆：可以陪他去舞厅，也可以婉拒；不影响他之后的生活。")
          (else "继续正常做工，不需要替他刷满聘用进度。")) #f))
        :where (cond (home-known? "码头居民区") (job-known? (if (< world-day 租房日) "老街酒馆" "码头")) ((equal? dance "待答复") "老街酒馆") (else "码头"))))))
  (lambda args
    (let ((msg (car args)))
      (cond
        ((eq? msg 'nodes-at) (nodes-at (cadr args)))
        ((eq? msg 'arrivals-at) (arrivals-at (cadr args)))
        ((eq? msg 'dossier) (dossier-at))
        ((eq? msg 'hired?) (hired?))
        ((eq? msg 'moved?) (or moved-with? (moved?)))
        ((eq? msg 'on-clearance!) (on-clearance! (cadr args)))
        ((eq? msg 'save) (list (list "dance" dance) (list "job-known" job-known?)
          (list "celebrated" celebrated?) (list "home-known" home-known?)
          (list "moved-with" moved-with?) (list "visited" visited?)
          (list "clearance" clearance) (list "ending-seen" ending-seen?)))
        ((eq? msg 'load!)
          (let ((d (cadr args)))
            (set! dance (assoc-get d "dance" "未邀请"))
            (set! job-known? (assoc-get d "job-known" #f))
            (set! celebrated? (assoc-get d "celebrated" #f))
            (set! home-known? (assoc-get d "home-known" #f))
            (set! moved-with? (assoc-get d "moved-with" #f))
            (set! visited? (assoc-get d "visited" #f))
            (set! clearance (assoc-get d "clearance" "未决定"))
            (set! ending-seen? (assoc-get d "ending-seen" #f))
            (ensure! (and (member? dance '("未邀请" "待答复" "参加" "婉拒" "错过"))
                          (member? clearance '("未决定" "保留" "取消"))
                          (or (not moved-with?) home-known?) (or (not home-known?) job-known?)) "艾迪生活：存档事实不一致")))
        (else (error "艾迪生活：未知消息"))))))
)
