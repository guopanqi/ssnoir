(load-file "scripts/theatre/酒馆最后一夜.scm")
(load-file "scripts/theatre/第一幕对白.scm")
;; 第一章公共主轴：谋生、面试消息、酒馆告别，赴约后转入剧院生活。
;; 旧「三封信」主线已退役；世界日期推进，人物生活不等待玩家清空支线。
(define 第一幕
  (let ()
    (define opened? #f)
    (define tavern-seen? #f)
    (define farewell-day 0)
    (define rehearsal-day 0)
    (define (rehearsal-ready?) (and (= act 2) (> rehearsal-day 0) (>= world-day rehearsal-day) (not rehearsal-seen?)))
    (define farewell-seen? #f)
    (define farewell-done? #f)
    (define rehearsal-seen? #f)
    (define rehearsal-done? #f)
    (define notice-seen? #f)
    (define act 1)

    (define (start!)
      (if opened? (error "第一幕：重复开场") #t)
      (set! opened? #t)
      (第一幕-清晨))

    (define (farewell-pending?) (and farewell-seen? (not farewell-done?) (= act 1)))
    ;; 报喜与迁移分开：她先留在酒馆完成最后一场，玩家赴约后才进入剧院阶段。
    (define (farewell!)
      (if (and (= act 1) (not farewell-seen?)) #t (error "夜莺面试：消息已告知或阶段非法"))
      (set! farewell-day world-day)
      (set! farewell-seen? #t)
      (play-dialogue!
    (line "世界" "街角风很大，夜莺站在报刊亭旁边，手里捏着一张硬卡纸。看见尼尔过来，她想把卡片塞进包里，没塞好，干脆直接亮了出来。")
    (line "夜莺" "你看这个。")
    (line "尼尔" "大剧院的排练通行证？")
    (line "夜莺" "上午刚考完。三个考官坐在台下，连灯都没开全。我唱完第一段，中间那个戴眼镜的让我直接唱副歌，我还以为没戏了。")
    (line "世界" "她说话比平时快，嘴角一直往上翘，又故意清了清嗓子压下去。")
    (line "尼尔" "恭喜。那地方有专门的乐池，不用再踩老吉姆的破木板了。")
    (line "夜莺" "后台还有单独的化妆镜呢。不过我还得回老吉姆那儿，把最后一场唱完，再去那边报到。")
    (line "世界" "她看着尼尔，停了一下。")
    (line "夜莺" "大剧院在东街，往后来酒馆就碰不到我了。今晚这最后一场，你来听，好不好？")
    (line "尼尔" "我来。给我留个位子。")
    (line "夜莺" "前排。我跟吉姆说，别让人占了。今晚见。")))
    (define (attend-farewell!)
      (if (farewell-pending?) #t (error "酒馆告别：没有待履行的约定"))
      (酒馆最后一夜-演出 (first-act-walk 'met?) (码头工作 'met?) (露西起步 'met?))
      (set! farewell-done? #t)
      (set! rehearsal-day world-day)
      (set! act 2))
    (define (rehearsal! grade)
      (set! rehearsal-seen? #t) (set! rehearsal-done? #t)
      (cond ((eq? grade '好)
              (add-item! "金钱" 18) (result-supplement! "画幕和木架都按时安置妥当。"))
            ((eq? grade '中)
              (add-item! "金钱" 10) (result-supplement! "没误排练，还有一摞木架等人搬。"))
            (else (add-item! "金钱" 5) (spend-composure! 1)
              (result-supplement! "滑轮卡了几次，催促声一直没停。"))))
    (define (read-city-notice!)
      (set! notice-seen? #t)
      (spotlight! "旧港改造计划启动" "街头的早报头版写着：旧港改造计划启动，大剧院首演助阵。"))
    (define (arrivals-at location)
      (cond
        ((and (equal? location "世界") (> farewell-day 0) (>= world-day farewell-day)
              (= act 1) (not farewell-seen?))
          (list (arrival "夜莺面试通过" farewell!)))
        ((and (equal? location "世界") (>= world-day 15) (not notice-seen?))
          (list (arrival "旧港改造早报" (lambda () (read-city-notice!)))))
        ((and opened? (equal? location "老街酒馆") (not tavern-seen?))
         (list (arrival "酒馆与夜莺" (lambda ()
           (set! tavern-seen? #t)
           (第一幕-酒馆)))))
        (else '())))

    (define (nodes-at location)
      (append
        (if (and (equal? location "家") (not opened?))
          (list (node "旅馆清晨" :name "起身出门" :anchor "家" :required-before-rest "先起床看看"
             :resolve (instant start!))) '())
        (if (and (equal? location "老街酒馆") (farewell-pending?))
          (list (node "夜莺最后一场演出" :name "赴告别演出" :anchor "夜莺@酒馆"
            :required-before-rest "先赴告别演出" :button-text "执行"
            :subtitle "已答应今晚到场；演出后她才转去剧院。"
            :resolve (instant (outcome attend-farewell!)))) '())

        '()))

    (lambda args
      (let ((msg (car args)))
        (cond
          ((eq? msg 'nodes-at) (nodes-at (cadr args)))
          ((eq? msg 'arrivals-at) (arrivals-at (cadr args)))
          ((eq? msg 'opened?) opened?)
          ((eq? msg 'work-open?) tavern-seen?)
          ((eq? msg 'theater-open?) (>= act 2))
          ((eq? msg 'rehearsal-seen?) rehearsal-seen?)
          ((eq? msg 'act) act)
          ((eq? msg 'farewell-day) farewell-day)
          ((eq? msg 'rehearsal-day) rehearsal-day)
          ((eq? msg 'trial-day) (if (> rehearsal-day 0) (+ rehearsal-day 5) 0))
          ((eq? msg 'poster-day) (if (> rehearsal-day 0) (+ rehearsal-day 7) 0))
          ((eq? msg 'schedule-farewell!)
            (if (and (= act 1) (= farewell-day 0)) (set! farewell-day (cadr args)) #f))
           ((eq? msg 'begin-third-act!)
            (if (= act 2) (set! act 3)
              (error "第一幕：第三幕只能从第二幕进入")))
          ((eq? msg 'farewell-seen?) farewell-seen?)
          ((eq? msg 'farewell-pending?) (farewell-pending?))
          ((eq? msg 'farewell-done?) farewell-done?)
          ((eq? msg 'debug-finish!)
           (set! opened? #t) (set! tavern-seen? #t)
           (set! farewell-seen? #t) (set! farewell-done? #t) (set! rehearsal-done? #t)
           (set! act 2) (set! farewell-day 6) (set! rehearsal-day 8) (夜莺生活 'meet!))
          ((eq? msg 'dossier)
           (list (dossier "活下去" :kind '主线 :primary #t
             :status (if (= act 1) '进行中 '了结)
             :now (cond
               ((not opened?) "口袋快空了。去酒馆问问零工，也得挣房钱。")
               ((not tavern-seen?) "码头能搬货，酒馆能听消息。先找份能领到钱的活。")
               ((farewell-pending?) "已答应去酒馆听夜莺的最后一场演出。休息前赴约；散场后她就转去剧院。")
               ((and (= act 1) (> farewell-day 0)) "夜莺还在酒馆唱歌，也忙着准备剧院面试。有空去看看她。")
               ((and (= act 2) (rehearsal-ready?)) "夜莺通过了面试。剧院后台有零工，也可以找经理聊聊尾随者。")
               ((and (= act 2) (not rehearsal-seen?)) "夜莺已在剧院工作，有空可以去看看她。")
               ((= act 2) "剧院的活随时可以再接。也别忘了手头的委托和熟人。")
               (else "在城市工作，留意有人需要怎样的帮助。"))
             :where (cond ((not opened?) "家")
               ((not tavern-seen?) "老街酒馆")
               ((farewell-pending?) "老街酒馆")
               ((and (= act 2) (rehearsal-ready?)) "剧院") (else "")))))
          ((eq? msg 'save)
           (list
             (list "opened" opened?) (list "tavern" tavern-seen?)
             (list "farewell-day" farewell-day) (list "rehearsal-day" rehearsal-day)

             (list "farewell-seen" farewell-seen?) (list "farewell-done" farewell-done?)
             (list "rehearsal-seen" rehearsal-seen?) (list "rehearsal-done" rehearsal-done?)
             (list "notice" notice-seen?)
             (list "act" act)))
          ((eq? msg 'load!)
           (let ((data (cadr args)))
             (set! opened? (assoc-get data "opened" #f))
             (set! tavern-seen? (assoc-get data "tavern" #f))
             (set! farewell-seen? (assoc-get data "farewell-seen" #f))
             (set! farewell-done? (assoc-get data "farewell-done" #f))
             (set! rehearsal-seen? (assoc-get data "rehearsal-seen" #f))
             (set! rehearsal-done? (assoc-get data "rehearsal-done" #f))
             (set! notice-seen? (assoc-get data "notice" #f))
             (set! act (assoc-get data "act" 1))
             (set! farewell-day (assoc-get data "farewell-day" (if (>= act 2) 6 0)))
             (set! rehearsal-day (assoc-get data "rehearsal-day" (if (>= act 2) 8 0)))
             (if (member? act '(1 2 3))
                #t (error "第一幕存档：阶段非法"))
             (if (and tavern-seen? (not opened?))
               (error "第一幕存档：开场顺序矛盾") #t)))
          (else (error "第一幕：未知消息")))))))
(set-global! '开场动作 "旅馆清晨")
