(load-file "scripts/theatre/第一幕对白.scm")
;; 五天的世界日程与人物经历。工作结算在地点；表现单独交给 Dialogue 脚本。
(define 第一幕
  (let ()
    (define opened? #f)
    (define tavern-seen? #f)
    (define lucy-stage 0)
    (define eddie-stage 0)
    ;; 初识以后每隔三班日常工作才有下一段；不渲染，也不写入行动效果条。
    (define lucy-life (make-clock "露西日常间隔" 3 'gauge ""))
    (define eddie-life (make-clock "艾迪日常间隔" 3 'gauge ""))
    (define (advance-hidden! clock)
      (clock 'load! (min (clock 'max) (+ (clock 'current) 1))))
    (define drink-day 0)
    (define drink-state "未邀请")
    (define drank? #f)
    (define drink-talk? #f)
    (define rehearsal-announced? #f)
    (define rehearsal-seen? #f)
    (define rehearsal-done? #f)
    (define rehearsal-news? #f)
    (define rehearsal-answer? #f)
    (define tavern-message-sent? #f)
    (define act 1)

    (define (start!)
      (if opened? (error "第一幕：重复开场") #t)
      (set! opened? #t) (第一幕-清晨))
    (define (on-work! location grade)
      (cond
        ((equal? location "街角咖啡馆")
          (cond ((= lucy-stage 0) (set! lucy-stage 1) (第一幕-露西初识 (> eddie-stage 0)))
            ((= lucy-stage 1)
              (advance-hidden! lucy-life)
              (if (lucy-life 'full?)
                (begin (set! lucy-stage 2) (第一幕-露西打字)) #f))
            (else #f)))
        ((equal? location "码头")
          (cond ((= eddie-stage 0) (set! eddie-stage 1) (第一幕-艾迪初识 grade))
            ((member? eddie-stage '(1 2))
              (advance-hidden! eddie-life)
              (if (eddie-life 'full?)
                (begin
                  (eddie-life 'load! 0)
                  (if (= eddie-stage 1)
                    (begin (set! eddie-stage 2) (第一幕-艾迪再见))
                    (begin (set! eddie-stage 3) (set! drink-day world-day)
                      (set! drink-state "待答复") (第一幕-艾迪邀请)))) #f))
            (else #f)))
        (else (error "第一幕：未知工作地点"))))
    (define (watch-rehearsal!)
      (if (or (not (= world-day 5)) rehearsal-seen?) (error "第一幕：彩排不在观看窗口") #t)
      (set! rehearsal-seen? #t) (set! rehearsal-done? #t)
      (第一幕-彩排 (cond ((first-act-walk 'close?) '同行)
        ((first-act-walk 'met?) '相识) (else '观众)))
      )
    (define (answer! text)
      (set! rehearsal-answer? #t)
      (play-dialogue! (line "尼尔" text)
        (line "夜莺" (cond ((equal? text "很漂亮。") "是吗？那就好。")
          ((equal? text "你唱得很好。") "第二遍才好一点。我还得练。") (else "……我希望是。")))
        (line "夜莺" "我还会在这儿唱很多次的。你有空就来。")))
    (define (arrivals-at location)
      (cond
        ((and opened? (equal? location "老街酒馆")
              (or (not tavern-seen?) (and tavern-message-sent? (not rehearsal-announced?))))
          (list (arrival "酒保与夜莺" (lambda ()
            (if (not tavern-seen?) (begin (set! tavern-seen? #t) (第一幕-酒馆)) #f)
            (if (and tavern-message-sent? (not rehearsal-announced?))
              (begin (set! rehearsal-announced? #t) (第一幕-酒馆消息)) #f)))))
        ((and rehearsal-done? (not rehearsal-seen?) (not rehearsal-news?)
              (member? location '("家" "老街酒馆")))
          (list (arrival "彩排之后的消息" (lambda ()
            (set! rehearsal-news? #t)
            (play-dialogue! (line "世界" "大剧院昨日已完成首轮正式彩排。夜莺仍将参加接下来的演出。"))))))
        (else '())))
    (define (nodes-at location)
      (append
        (if (and (equal? location "家") (not opened?))
          (list (node "旅馆清晨" :required-before-rest "先起床看看" :resolve (instant start!))) '())
        (if (and (equal? location "码头") (equal? drink-state "待答复") (= drink-day world-day))
          (list (container "艾迪的邀请" (list
            (instant-action "去坐一会儿" (lambda () (set! drink-state "已答应")
              (play-dialogue! (line "艾迪" "那就酒馆见，别跑了。"))))
            (instant-action "改天吧" (lambda () (set! drink-state "婉拒")
              (play-dialogue! (line "艾迪" "行。下次我逮着你再说。"))))))) '())
        (if (and (equal? location "老街酒馆") (= drink-day world-day) (equal? drink-state "已答应"))
          (list (action "与艾迪喝酒" (list (req-die)) (instant (outcome (lambda ()
            (set! drink-state "赴约") (set! drank? #t) (第一幕-艾迪喝酒)))))) '())
        (if (and (equal? location "老街酒馆") drank? (not drink-talk?))
          (list (container "艾迪等你回答" (map (lambda (answer)
            (instant-action (car answer) (lambda () (set! drink-talk? #t)
              (play-dialogue! (line "尼尔" (cadr answer)) (line "艾迪" "也对。先过完这个月。")))))
            (list (list "先交房租" "先把这个月的房租交了再说。")
                  (list "有机会就做" "碰上什么好机会，就做什么。")
                  (list "找点像样的事" "总得找点像样的事做。"))))) '())
        (if (and (equal? location "老街酒馆") opened? (not rehearsal-announced?))
          (list (at-anchor "夜莺@酒馆"
                 (note-node "夜莺·酒馆" "夜莺" ""))) '())
        (if (and (equal? location "剧院") (= world-day 5) (not rehearsal-seen?))
          (list (node "观看正式彩排" :required-before-rest "先去剧院看正式彩排"
            :requires (list (req-die)) :resolve (instant (outcome watch-rehearsal!)))) '())
        (if (and (equal? location "剧院") rehearsal-announced?)
          (list (at-anchor "夜莺@剧院"
                 (note-node "夜莺·剧院" "夜莺" ""))) '())
        (if (and (equal? location "剧院") rehearsal-seen? (first-act-walk 'close?)
                 (not rehearsal-answer?) (= world-day 5))
          (list (container "她在舞台上" (map (lambda (answer)
            (instant-action (car answer) (lambda () (answer! (cadr answer)))))
            (list (list "很漂亮" "很漂亮。") (list "唱得很好" "你唱得很好。")
                  (list "像是属于这里" "像真的属于这里一样。"))))) '())))
    ;; 日历已先走到新一天；事件不等待可选人物线或交锋。
    (define-turn-start-rule "第一幕日程"
      (lambda () #t)
      (lambda ()
        (if (and (> drink-day 0) (> world-day drink-day) (member? drink-state '("待答复" "已答应")))
          (set! drink-state "错过") #f)
        (if (and (>= world-day 3) (not tavern-message-sent?))
          (begin (set! tavern-message-sent? #t)
            (play-dialogue! (line "世界" "酒保托人捎来口信：酒馆有几件事得当面说，今天尽量过来一趟。"))) #f)
        (if (and (>= world-day 6) (= act 1))
          (begin (set! rehearsal-done? #t) (set! act 2)
            (spotlight! "第二幕" "这里有我的朋友。城市照常生活，彩排已经结束。")) #f)))
    (lambda args
      (let ((msg (car args)))
        (cond
          ((eq? msg 'nodes-at) (nodes-at (cadr args)))
          ((eq? msg 'arrivals-at) (arrivals-at (cadr args)))
          ((eq? msg 'opened?) opened?)
          ((eq? msg 'work-open?) tavern-seen?)
          ((eq? msg 'theater-open?) rehearsal-announced?)
          ((eq? msg 'rehearsal-seen?) rehearsal-seen?)
          ((eq? msg 'act) act)
          ((eq? msg 'eddie-met?) (> eddie-stage 0))
          ((eq? msg 'on-work!) (on-work! (cadr args) (caddr args)))

          ((eq? msg 'debug-finish!)
            (set! opened? #t) (set! tavern-seen? #t) (set! act 2)
            (set! rehearsal-announced? #t) (set! rehearsal-done? #t))
          ((eq? msg 'dossier)
            (list (dossier "活下去" :kind '主线 :primary #t
              :status (if (= act 1) '进行中 '了结)
              :now (cond ((not opened?) "起床，看看手里的钱。")
                ((not tavern-seen?) "去酒馆打听零工。")
                ((= act 2) "彩排已经结束。与城里人的经历保留下来。")
                (rehearsal-announced? "第五天剧院彩排；尚未到场，不能休息。")
                (else "三处工作都能挣钱。留意收租，也给自己留些精力。"))
              :where (cond ((not opened?) "家") ((not tavern-seen?) "老街酒馆")
                ((and (= world-day 5) (not rehearsal-seen?)) "剧院") (else "")))))
          ((eq? msg 'save)
            (list (list "opened" opened?) (list "tavern" tavern-seen?)
              (list "lucy" lucy-stage) (list "eddie" eddie-stage)
              (list "lucy-life" (lucy-life 'save)) (list "eddie-life" (eddie-life 'save))
              (list "drink-day" drink-day) (list "drink-state" drink-state)
              (list "drank" drank?) (list "drink-talk" drink-talk?)
              (list "announced" rehearsal-announced?) (list "seen" rehearsal-seen?)
              (list "done" rehearsal-done?) (list "news" rehearsal-news?)
              (list "answer" rehearsal-answer?) (list "act" act)
              (list "tavern-message-sent" tavern-message-sent?)))
          ((eq? msg 'load!)
            (let ((data (cadr args)))
              (set! opened? (assoc-get data "opened" #f)) (set! tavern-seen? (assoc-get data "tavern" #f))
              (set! lucy-stage (assoc-get data "lucy" 0)) (set! eddie-stage (assoc-get data "eddie" 0))
              (lucy-life 'load! (assoc-get data "lucy-life" 0))
              (eddie-life 'load! (assoc-get data "eddie-life" 0))
              (set! drink-day (assoc-get data "drink-day" 0)) (set! drink-state (assoc-get data "drink-state" "未邀请"))
              (set! drank? (assoc-get data "drank" #f)) (set! drink-talk? (assoc-get data "drink-talk" #f))
              (set! rehearsal-announced? (assoc-get data "announced" #f))
              (set! rehearsal-seen? (assoc-get data "seen" #f)) (set! rehearsal-done? (assoc-get data "done" #f))
              (set! rehearsal-news? (assoc-get data "news" #f)) (set! rehearsal-answer? (assoc-get data "answer" #f))
              (set! tavern-message-sent? (assoc-get data "tavern-message-sent" #f))
              (set! act (assoc-get data "act" 1))
              (map (lambda (value) (if (member? value '(#t #f)) #t
                (error "第一幕存档：经历标记必须是布尔值")))
                (list opened? tavern-seen? drank? drink-talk? rehearsal-announced?
                  rehearsal-seen? rehearsal-done? rehearsal-news? rehearsal-answer? tavern-message-sent?))
              (if (and (member? lucy-stage '(0 1 2)) (member? eddie-stage '(0 1 2 3))
                       (member? act '(1 2)) (member? drink-state '("未邀请" "待答复" "已答应" "赴约" "婉拒" "错过")))
                #t (error "第一幕存档：人物或日程状态非法"))
              (if (or (and tavern-seen? (not opened?))
                      (and drank? (not (equal? drink-state "赴约"))))
                (error "第一幕存档：经历顺序矛盾") #t)))
          (else (error "第一幕：未知消息")))))))
(set-global! '开场动作 "旅馆清晨")
