(load-file "scripts/theatre/第一幕对白.scm")
;; 第一幕是城市日历中的第 1—6 日：谋生、熟络、雨夜，最后酒馆告别。
;; 第二幕从第 7 日开始，剧院首次正式彩排在第 9 日。
;; 人物生活是可错过的，世界事件不因玩家没有认识任何角色而停滞。
(define 第一幕
  (let ()
    (define opened? #f)
    (define tavern-seen? #f)
    (define act 1)
    (define nightingale-stage 0)
    (define eddie-stage 0)
    (define lucy-stage 0)
    (define eddie-count 0)
    (define lucy-count 0)
    (define drink-day 0)
    (define drink-state "未邀请")
    (define drank? #f)
    (define drink-talk? #f)
    (define farewell-notice? #f)
    (define farewell-seen? #f)
    (define farewell-news? #f)
    (define rehearsal-seen? #f)
    (define rehearsal-news? #f)
    (define rehearsal-answer? #f)

    (define (start!)
      (if opened? (error "第一幕：不可重复开场") #t)
      (set! opened? #t)
      (第一幕-清晨))
    (define (tavern-work!)
      (if (and opened? (= act 1) (<= world-day 6))
        (cond
          ((= nightingale-stage 0)
            (set! nightingale-stage 1)
            (第一幕-夜莺台边))
          ((= nightingale-stage 1)
            (set! nightingale-stage 2)
            (第一幕-夜莺收工))
          ((= nightingale-stage 2)
            (set! nightingale-stage 3)
            (第一幕-夜莺关心))
          (else #f))
        #f))
    (define (on-work! location grade)
      (cond
        ((equal? location "街角咖啡馆")
          (cond ((= lucy-stage 0)
                  (set! lucy-stage 1)
                  (第一幕-露西初识 (> eddie-stage 0)))
                ((= lucy-stage 1)
                  (set! lucy-count (+ lucy-count 1))
                  (if (>= lucy-count 2)
                    (begin (set! lucy-stage 2) (第一幕-露西打字))
                    #f))
                (else #f)))
        ((equal? location "码头")
          (cond ((= eddie-stage 0)
                  (set! eddie-stage 1)
                  (第一幕-艾迪初识 grade))
                ((member? eddie-stage '(1 2))
                  (set! eddie-count (+ eddie-count 1))
                  (if (>= eddie-count 2)
                    (begin
                      (set! eddie-count 0)
                      (if (= eddie-stage 1)
                        (begin (set! eddie-stage 2) (第一幕-艾迪再见))
                        (begin
                          (set! eddie-stage 3)
                          (set! drink-day world-day)
                          (set! drink-state "待答复")
                          (第一幕-艾迪邀请))))
                    #f))
                (else #f)))
        (else (error "第一幕：未知工作地点"))))

    (define (farewell!)
      (if (or (not (= act 1)) (not (= world-day 6)) farewell-seen?)
        (error "第一幕：酒馆告别演出时间不对") #t)
      (set! farewell-seen? #t)
      (第一幕-酒馆告别
        (cond ((first-act-walk 'close?) '同行)
              ((> nightingale-stage 0) '相识)
              (else '观众))))
    (define (rehearsal!)
      (if (or (not (= act 2)) (not (= world-day 9)) rehearsal-seen?)
        (error "第二幕：正式彩排时间不对") #t)
      (set! rehearsal-seen? #t)
      (第一幕-彩排
        (cond ((first-act-walk 'close?) '同行)
          ((> nightingale-stage 0) '相识)
          (else '观众))))
    (define (answer! text)
      (if rehearsal-answer? (error "彩排：不能重复回答") #t)
      (set! rehearsal-answer? #t)
      (play-dialogue!
        (line "尼尔" text)
        (line "夜莺" (cond
          ((equal? text "很漂亮。") "是吗？那就好。")
          ((equal? text "你唱得很好。") "第二遍才好一点。我还得练。")
          (else "……我希望是。")))))
    (define (arrivals-at location)
      (cond
        ((and opened? (equal? location "老街酒馆") (not tavern-seen?))
          (list (arrival "酒保与夜莺" (lambda ()
            (set! tavern-seen? #t)
            (第一幕-酒馆)))))
        ((and (equal? location "老街酒馆")
              (= act 2) (not farewell-seen?) (not farewell-news?))
          (list (arrival "酒馆少了一个人" (lambda ()
            (set! farewell-news? #t)
            (第一幕-告别消息)))))
        ((and (equal? location "剧院") (> world-day 9)
              (not rehearsal-seen?) (not rehearsal-news?))
          (list (arrival "彩排后的消息" (lambda ()
            (set! rehearsal-news? #t)
            (play-dialogue! (line "世界" "夜莺在大剧院的第一次彩排已经结束。"))))))
        (else '())))

    (define (nodes-at location)
      (append
        (if (and (equal? location "家") (not opened?))
          (list (node "旅馆清晨" :required-before-rest "先起床看看"
            :resolve (instant start!))) '())
        (if (and (equal? location "老街酒馆") (= act 1)
                 (> nightingale-stage 0) (<= world-day 5))
          (list (at-anchor "夜莺@酒馆"
            (note-node "标注：夜莺驻唱" "夜莺" "今晚仍在这里演唱。"))) '())
        (if (and (equal? location "码头") (= drink-day world-day)
                 (equal? drink-state "待答复"))
          (list (container "艾迪的邀请" (list
            (instant-action "去坐一会儿" (lambda ()
              (set! drink-state "已答应")
              (play-dialogue! (line "艾迪" "那就酒馆见。"))))
            (instant-action "改天吧" (lambda ()
              (set! drink-state "婉拒")
              (play-dialogue! (line "艾迪" "行。下次我再找你。"))))))) '())
        (if (and (equal? location "老街酒馆")
                 (= world-day drink-day) (equal? drink-state "已答应"))
          (list (action "与艾迪喝酒" (list (req-die))
            (instant (outcome (lambda ()
              (set! drink-state "赴约")
              (set! drank? #t) (第一幕-艾迪喝酒)))))) '())
        (if (and (equal? location "老街酒馆") drank? (not drink-talk?))
          (list (container "收工后的话" (map (lambda (answer)
            (instant-action (car answer) (lambda ()
              (set! drink-talk? #t)
              (play-dialogue! (line "尼尔" (cadr answer))
                (line "艾迪" "那就先过好这个月。")))))
            (list (list "先交房租" "先把房钱挣出来。")
                  (list "有活就干" "哪儿有活就去哪里。")
                  (list "找点像样的事" "总得找点像样的事做。"))))) '())
        (if (and (equal? location "老街酒馆")
                 (= act 1) (= world-day 6) (not farewell-seen?))
          (list (node "听她唱最后一场" :anchor "夜莺@酒馆"
            :subtitle "夜莺今晚离开这座酒馆的舞台"
            :resolve (instant farewell!))) '())
        (if (and (equal? location "剧院") (= act 2)
                 (= world-day 9) (not rehearsal-seen?))
          (list (node "观看正式彩排" :anchor "剧院-中央台"
            :subtitle "她第一次站在大剧院的空舞台上"
            :requires (list (req-die))
            :resolve (instant (outcome rehearsal!)))) '())
        (if (and (equal? location "剧院") (= act 2)
                 (= world-day 9) rehearsal-seen?
                 (first-act-walk 'close?) (not rehearsal-answer?))
          (list (container "她在舞台上" (map (lambda (answer)
            (instant-action (car answer) (lambda () (answer! (cadr answer)))))
            (list (list "很漂亮" "很漂亮。")
                  (list "唱得很好" "你唱得很好。")
                  (list "属于这里" "你像是属于这里。"))))) '())))
    (define-turn-start-rule "第一幕与彩排日程"
      (lambda () #t)
      (lambda ()
        (if (and (> drink-day 0) (> world-day drink-day)
                 (member? drink-state '("待答复" "已答应")))
          (set! drink-state "错过") #f)
        (if (and opened? (= act 1) (>= world-day 5) (not farewell-notice?))
          (begin
            (set! farewell-notice? #t)
            (play-dialogue!
              (line "调酒师" "明晚夜莺在这里唱最后一场。")
              (line "调酒师" "之后她就去大剧院排练了。")))
          #f)
        (if (and opened? (= act 1) (>= world-day 7))
          (begin
            (set! act 2)
            (spotlight! "第二幕" "这里有我的朋友。夜莺开始去大剧院排练。"))
          #f)
        (if (and opened? (= act 2) (= world-day 8))
          (play-dialogue!
            (line "世界" "大剧院的排练表贴了出来。明天是夜莺第一次正式彩排。"))
          #f)))
    (lambda args
      (let ((msg (car args)))
        (cond
          ((eq? msg 'nodes-at) (nodes-at (cadr args)))
          ((eq? msg 'arrivals-at) (arrivals-at (cadr args)))
          ((eq? msg 'opened?) opened?)
          ((eq? msg 'work-open?) tavern-seen?)
          ((eq? msg 'theater-open?) (>= act 2))
          ((eq? msg 'act) act)
          ((eq? msg 'eddie-met?) (> eddie-stage 0))
          ((eq? msg 'nightingale-met?) (> nightingale-stage 0))
          ((eq? msg 'on-tavern-work!) (tavern-work!))
          ((eq? msg 'on-work!) (on-work! (cadr args) (caddr args)))
          ((eq? msg 'rehearsal-seen?) rehearsal-seen?)
          ((eq? msg 'debug-finish!)
            (set! opened? #t) (set! tavern-seen? #t)
            (set! act 2) (set! farewell-notice? #t))
          ((eq? msg 'dossier)
            (list (dossier "这座城里的人" :kind '主线 :primary #t
              :status (if (= act 1) '进行中 '进行中)
              :now
                (cond ((not opened?) "起床，想想今天去哪里找活。")
                  ((not tavern-seen?) "去酒馆问问最近有什么活。")
                  ((= act 1) "靠工作过日子。夜莺第六天将告别酒馆。")
                  ((and (= act 2) (< world-day 9)) "她开始在剧院彩排。")
                  (else "继续工作，看看熟悉的人过得怎样。"))
              :where (cond ((not opened?) "家")
                ((not tavern-seen?) "老街酒馆") (else "")))))
          ((eq? msg 'save)
            (list (list "opened" opened?) (list "tavern" tavern-seen?)
              (list "act" act)
              (list "nightingale-stage" nightingale-stage)
              (list "eddie" eddie-stage) (list "lucy" lucy-stage)
              (list "eddie-count" eddie-count) (list "lucy-count" lucy-count)
              (list "drink-day" drink-day) (list "drink-state" drink-state)
              (list "drank" drank?) (list "drink-talk" drink-talk?)
              (list "farewell-notice" farewell-notice?)
              (list "farewell-seen" farewell-seen?)
              (list "farewell-news" farewell-news?)
              (list "rehearsal-seen" rehearsal-seen?)
              (list "rehearsal-news" rehearsal-news?)
              (list "rehearsal-answer" rehearsal-answer?)))
          ((eq? msg 'load!)
            (let ((data (cadr args)))
              (set! opened? (assoc-get data "opened" #f))
              (set! tavern-seen? (assoc-get data "tavern" #f))
              (set! act (assoc-get data "act" 1))
              (set! nightingale-stage (assoc-get data "nightingale-stage" 0))
              (set! eddie-stage (assoc-get data "eddie" 0))
              (set! lucy-stage (assoc-get data "lucy" 0))
              (set! eddie-count (assoc-get data "eddie-count" 0))
              (set! lucy-count (assoc-get data "lucy-count" 0))
              (set! drink-day (assoc-get data "drink-day" 0))
              (set! drink-state (assoc-get data "drink-state" "未邀请"))
              (set! drank? (assoc-get data "drank" #f))
              (set! drink-talk? (assoc-get data "drink-talk" #f))
              (set! farewell-notice? (assoc-get data "farewell-notice" #f))
              (set! farewell-seen? (assoc-get data "farewell-seen" #f))
              (set! farewell-news? (assoc-get data "farewell-news" #f))
              (set! rehearsal-seen? (assoc-get data "rehearsal-seen" #f))
              (set! rehearsal-news? (assoc-get data "rehearsal-news" #f))
              (set! rehearsal-answer? (assoc-get data "rehearsal-answer" #f))
              (if (and (member? act '(1 2))
                       (member? nightingale-stage '(0 1 2 3))
                       (member? eddie-stage '(0 1 2 3))
                       (member? lucy-stage '(0 1 2))
                       (member? drink-state
                         '("未邀请" "待答复" "已答应" "赴约" "婉拒" "错过")))
                #t (error "第一幕存档：状态非法"))))
          (else (error "第一幕：未知消息")))))))
(set-global! '开场动作 "旅馆清晨")
