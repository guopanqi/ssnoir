;; 艾迪前段：日常工作中的相识与四次业余练拳。后段生活事件本轮暂不开放。
(define 艾迪生活
  (let ()
    (define 拳台见过? #f)
    (define 练拳 (make-clock "货栈练拳" 4 'gauge "有空陪艾迪练拳，输赢都算一次。顺利时有彩头，失手不受伤。" :beneficial-direction 'increase))
    (define (known?) (码头工作 'met?))
    (define 搭手
      (make-triggered-event "艾迪搬运搭手" "行动结算" "码头搬运"
        (lambda (ctx) (and (equal? (assoc-get ctx "result" "") "坏")
          (码头工作 'familiar?) (known?) (not (艾迪的房间 'resting?))))
        (lambda (ctx)
          (play-bubble!
            (line "尼尔" "啊！我的手！" :at "艾迪@码头")
            (bubble-restore-composure (line "艾迪" "我来！你松手！" :at "艾迪@码头")
              'player 1 "艾迪帮了你一把，心情恢复1点。")
            (line "艾迪" "哈哈哈，熟能生巧，下次就好了。" :at "艾迪@码头")) #t)
        1 0 100))
    (define (介绍!)
      (set! 拳台见过? #t)
      (play-dialogue!
    (line "世界" "下工哨响过半小时了，废货栈后头还传出闷响。尼尔绕过去，看见艾迪光着膀子，正对着一个麻袋改的沙包出拳，背上全是汗，嘴里哼着轻快的调子。")
    (line "艾迪" "哟，还没走？正好，别干看着，过来帮我扶一下，这麻袋老乱晃。")
    (line "世界" "他从木箱上扔过来一副旧皮手靶。尼尔接住套在手上，学着样子举起来。艾迪一记刺拳打在靶心，震得尼尔手腕一麻，往后退了半步。")
    (line "艾迪" "哈哈，胳膊别绷太死，顺着劲儿往回卸一点！对，就这样，再来！")
    (line "世界" "又接了三拳，尼尔慢慢摸到了点门道，两人的动作发出清脆的“啪、啪”声。艾迪收了拳，拿脖子上挂的毛巾擦了把脸，笑得很痛快。")
    (line "艾迪" "行啊你，比码头上那帮只会使蛮力的强多了。我每天下工都在这儿打几组，出透了汗回去睡得香。你有空就过来搭个手，旁边工友有时凑点彩头，打得好能分八美元。")
    (line "尼尔" "那你得把零钱备好了。")))
    (define (练! win?)
      (if (and 拳台见过? (not (练拳 'full?))) #t (error "艾迪练拳：当前不可参加"))
      (练拳 'advance! 1)
      (if win? (add-item! "金钱" 8) #f)
      (if (练拳 'full?)
        (play-dialogue!
    (line "世界" "最后一拳打完，两人都撑着膝盖喘气。海风吹过来，带着点咸腥味。艾迪一屁股坐在货箱上，把水壶扔给尼尔。")
    (line "艾迪" "痛快！这几回要不是你陪我练，我那沙包又得打破两个。")
    (line "尼尔" "我这胳膊明天估计抬不起来了。你这拳头是真重。")
    (line "艾迪" "搬货有工头催，这个没有。我就是喜欢出拳那一下，打完出透汗，回去睡得香。")
    (line "世界" "他接回水壶灌了一大口，拍了拍尼尔的肩膀。")
    (line "艾迪" "谢了兄弟，陪我流这么多汗。收拾收拾，今天不打了。哪天去街口买两个热肉饼，我请。")) #f))
    (lambda (msg . args)
      (cond
        ((eq? msg 'interactions) (list 搭手))
        ((eq? msg 'at?) (and (known?) (equal? (car args) "码头")))
        ((eq? msg 'arrivals-at)
          (if (and (equal? (car args) "码头") (known?) (not 拳台见过?)
                   (>= world-day (+ (码头工作 'met-day) 2)) (not (第二章 'started?)))
            (list (arrival "货栈里的沙袋" 介绍!)) '()))
        ((eq? msg 'nodes-at)
          (if (and (equal? (car args) "码头") (known?))
            (append
              (list (at-anchor "艾迪@码头" (note-node "艾迪·在场" "艾迪" (if (艾迪的房间 'resting?) "他坐在货棚旁休息，手掌裹着纱布，看见你时抬了抬下巴。" "他扛着麻袋走过跳板，看见你时笑着扬了扬下巴。"))))
              (if (and 拳台见过? (not (练拳 'full?)) (not (艾迪的房间 'resting?)) (not (第二章 'started?)))
                (list (node "陪艾迪练拳" :name "货栈练拳" :anchor "码头-货堆"
                  :subtitle "陪艾迪打靶切磋，输了不受伤，赢了有彩头。" :requires (list (req-die)) :risk '稳妥
                  :clocks (list (练拳 'render-data)) :progress-target (list 'clock "货栈练拳")
                  :resolve (roll 'violence (outcome (lambda () (练! #f)))
                    (outcome (lambda () (练! #f))) (outcome (lambda () (练! #t)))))) '())) '()))
        ((eq? msg 'dossier)
          (if (not (known?)) '()
            (list (dossier "艾迪与货栈拳台" :kind '人物 :where "码头"
              :clocks (if (and 拳台见过? (not (练拳 'full?))) (list (练拳 'render-data)) '())
              :status (if (练拳 'full?) '了结 '进行中)
              :now (cond ((练拳 'full?) "和艾迪切磋过几回，渐渐合拍。他还在码头上工，碰面照样会打招呼。")
                (拳台见过? "艾迪下工后爱在货栈练拳。陪他切磋四次，打得好还有工友凑的彩头。")
                (else "搬运工艾迪替你解了围，只抽走一根烟。他常在货栈一带干活。"))))))
        ((eq? msg 'hired?) #f)
        ((eq? msg 'moved?) #f)
        ((eq? msg 'on-clearance!) #t)
        ((eq? msg 'save) (list (list "interactions" (interaction-save (list 搭手))) (list "boxing-intro" 拳台见过?) (list "boxing" (练拳 'save))))
        ((eq? msg 'load!) (let ((s (car args)))
          (interaction-load! (list 搭手) (assoc-get s "interactions" '()))
          (set! 拳台见过? (assoc-get s "boxing-intro" #f)) (练拳 'load! (assoc-get s "boxing" 0))))
        (else (error "艾迪生活：未知消息"))))))
