;; scenes/world/第二章/晚宴.scm - 锚点一《晚宴》
;;
;; 短事件，不是 Contract。它要办成的事只有一件：让玩家**被这个世界吸引**——
;; 钱很多，生活漂亮，事情好像都很容易办；然后在散场时发现，她已经开始适应这里了。
;;
;; 这一场只有一个晚上，三个人站在三个方向，玩家只来得及走向其中一个。
;; 不是每个选择都有回报，但每个都有代价：你站在谁旁边，另外两扇门今晚就不开。
;;
;; 窗口是这一版的第一个样本：**固定日期，提前看得见，而且到了那天绕不过去。**
;;   预告  章节一开始就摆进卷宗，带一根从日期算出来的倒计时
;;   开门  只有晚宴当天，剧院里有那张卡
;;   堵着  它是主轴上的一拍，所以那天不许睡过去：结算完之前，休息一直被挡回剧院
;;
;; 「可有可无」和「主轴」的区别就落在这里：主轴上的事件不靠玩家配合才发生。
;; 玩家仍然可以选择在那间厅里谁也不走近——但那是他当场按下的一张卡，
;; 是一个有代价的选择，不是一次「今天不去了」的缺席。
;;
;; **一场事件只结算一次，靠的是状态机，不是「卡片通常会消失」。**
;; 下面每一次转换都先问自己现在在哪一格，不合法就当场报错——卡片没消失、
;; 被点了第二下、或者以后有别的入口把人放进来，都会在这里断掉，而不是
;; 悄悄给玩家发第二份好处。
(define 晚宴
  (let ()
    ;; 未开始 → 进行中 → 陪着她 / 找了林 / 找了薇拉 / 没站队
    ;; 没有「没去」这一格：那一天休息被堵着，除非结算过，否则夜过不去。
    (define 结果 "未开始")

    (define (开始了?) (第二章 'started?))
    (define (今天?) (and (开始了?) (= world-day (第二章 'banquet-day))))
    (define (未开始?) (equal? 结果 "未开始"))
    (define (进行中?) (equal? 结果 "进行中"))
    (define (还没结?) (or (未开始?) (进行中?)))
    (define (剩几天) (max 0 (- (第二章 'banquet-day) world-day)))

    ;; ── 必经拍：到日子就堵着 ─────────────────────────
    ;; 和《制造一个故事》《机器进入老街》同一套写法：阻塞是派生状态，
    ;; 每次状态或日子变了都整条重算一遍，不做增量。
    (define (sync-blockers!)
      (rest-release! "第二章/晚宴")
      (cond
        ;; 还没进场：把玩家指到剧院那张卡上。
        ((and (今天?) (未开始?))
         (rest-block! "第二章/晚宴" "今晚的晚宴，她在剧院等你" "剧院" "赴晚宴"))
        ;; 已经在厅里：不指任何一张——今晚该走向谁，正是这一场要玩家自己回答的问题。
        ((and (今天?) (进行中?))
         (rest-block! "第二章/晚宴" "你还站在那间厅里"))
        (#t #f)))

    ;; ── 状态转换 ────────────────────────────────────
    (define (进场!)
      (if (未开始?)
          (begin (set! 结果 "进行中") (sync-blockers!))
          (error "晚宴：只能从「未开始」进场")))

    (define (收场! 选择 标题 正文)
      (if (还没结?)
          (begin
            (set! 结果 选择)
            (sync-blockers!)
            ((第二章 'journal) 'add! 正文)
            (spotlight! 标题 正文))
          (error "晚宴：这一场已经收过了")))

    ;; ── 卷宗那一句 ──────────────────────────────────
    (define (now)
      (cond
        ((进行中?) "今晚你只来得及走向一个人")
        ((今天?) "今晚的晚宴。她在剧院等你一起走")
        ((还没结?) (string-append "还有 " (number->string (剩几天)) " 天，晚宴那晚陪她去"))
        ((equal? 结果 "没站队") "你去了，可那一晚谁也没走近")
        (else "晚宴散场了。她已经开始适应那个地方")))

    (define (where) (if (还没结?) "剧院" ""))

    (define (clocks)
      (if (and (还没结?) (not (今天?)))
          (list (日期倒计时 "离晚宴" (第二章 'banquet-day) 3
                  "归零那晚在剧院会合，只有那一晚。"))
          '()))

    ;; ── 那一晚 ──────────────────────────────────────
    ;; 不要骰：主轴上的必经拍不跟今天的城市生活抢那四颗骰。
    ;; 骰子是「可做可不做的事」的价钱；这一晚玩家没有不去的选项，
    ;; 真让他把骰花光了又睡不了觉，就成了软锁。
    (define (node-go)
      (instant-action "赴晚宴"
        (lambda ()
          (进场!)
          (play-dialogue!
            (line "夜莺" "别站那么直，他们又不查你的票。")
            (line "尼尔" "你紧张。")
            (line "夜莺" "我等了六年才有人请我来这种地方。")
            (line "世界" "厅里灯亮得没有影子。有人在谈一笔生意，谈完就散了。")
            (line "世界" "那笔生意够码头上一个人干两年。")))))

    (define (node-stay)
      (instant-action "陪着她"
        (lambda ()
          (play-dialogue!
            (line "夜莺" "你一直站在我旁边。")
            (line "尼尔" "你请我来的。")
            (line "夜莺" "他们以为你是我的人。")
            (line "尼尔" "他们爱怎么想怎么想。")
            (line "世界" "她笑了一下，那笑不是给你的，是给看过来的人的。"))
          (nightingale 'on-banquet-stayed!)
          (收场! "陪着她" "你没离开她半步"
            "整晚你都站在她旁边。她记住了这件事，也让所有人都看见了。"))))

    (define (node-lin)
      (instant-action "找林说话"
        (lambda ()
          (play-dialogue!
            (line "林" "侦探。上次那台机器散架的时候，你还替我撑了几秒。")
            (line "尼尔" "它现在成了他们拿出来展示的东西。")
            (line "林" "它现在能干活了。这是两回事，也是同一回事。")
            (line "林" "哪天来试验场，我让你看看它现在怎么走。"))
          (lin 'on-banquet-talk!)
          (收场! "找了林" "他要带你去看那台机器"
            "你把整晚给了林。他答应带你进公司试验场。"))))

    (define (node-vera)
      (instant-action "找薇拉"
        (lambda ()
          (play-dialogue!
            (line "薇拉" "芬奇先生说你办事很干净。")
            (line "尼尔" "他替保险公司说话，不替我。")
            (line "薇拉" "干净的意思是：该结束的时候，你让它结束了。")
            (line "世界" "她说完就转向了别人。你听见她把老码头说成一块地。"))
          (收场! "找了薇拉" "你认识了那个说了算的人"
            "你把整晚给了薇拉。她记住了你的名字，也让你听见了她怎么谈论老街。"))))

    ;; 第四扇门：谁也不走近。它和另外三张一样是一张卡、一次结算——
    ;; 「不选」在这一场里也是一个选择，得由玩家自己按下去，不能靠睡过去代劳。
    (define (node-alone)
      (instant-action "谁也不走近"
        (lambda ()
          (play-dialogue!
            (line "世界" "你在窗边站了整晚。酒换过三次，没有一杯是你要的。")
            (line "世界" "她在厅那头笑，回头看过你一次。")
            (line "尼尔" "……"))
          (nightingale 'on-drifted-apart!)
          (收场! "没站队" "你在场，但没在她身边"
            "你在那间厅里站了一晚上。她跟别人说话的时候，回头看过你一次。"))))

    ;; 入口只认状态，不只认日子：收过场以后，今天仍然是晚宴日，但那扇门已经关了。
    (define (nodes-at location)
      (if (equal? location "剧院")
          (cond
            ((进行中?) (list (node-stay) (node-lin) (node-vera) (node-alone)))
            ((and (今天?) (未开始?)) (list (node-go)))
            (else '()))
          '()))

    ;; ── 日终 ────────────────────────────────────────
    ;; 由章节在日终统一调用（见 第二章.scm），不自己登记日终规则——
    ;; 那样谁先谁后就成了文件加载顺序说了算。
    ;;
    ;; 这里没有「错过了怎么办」的分支：晚宴当天休息被堵着，日子推不过去。
    ;; 日终唯一要做的是按新的日子重算阻塞——晚宴日到了就竖起来。
    (define (on-day-end!)
      (if (开始了?)
          (begin
            (sync-blockers!)
            (if (今天?)
                (spotlight! "今晚"
                  "车晚上到剧院门口。她说过只等你一次。")
                #f))
          #f))

    (lambda args
      (let ((msg (car args)))
        (cond
          ((equal? msg 'nodes-at) (nodes-at (cadr args)))
          ((equal? msg 'arrivals-at) '())
          ((equal? msg 'dossier) '())
          ((equal? msg 'on-day-end!) (on-day-end!))
          ((equal? msg 'sync-blockers!) (sync-blockers!))
          ;; 调试用：当作那一晚你没离开她半步，好让后面的锚点接得上。
          ((equal? msg 'debug-settle!)
           (set! 结果 "陪着她")
           (sync-blockers!))
          ((equal? msg 'now) (now))
          ((equal? msg 'where) (where))
          ((equal? msg 'clocks) (clocks))
          ((equal? msg 'result) 结果)
          ((equal? msg 'save) (list (list "result" 结果)))
          ((equal? msg 'load!)
           (let ((data (cadr args)))
             (set! 结果 (assoc-get data "result" "未开始"))))
          (else (error "晚宴：收到未知消息")))))))
