;; 第二幕新增公共生活节拍。不改夜校及赞助人交锋，只加生活和事件入口。
(define 第二幕节奏
 (let ()
  (define tavern? #f)
  (define ship? #f)
  (define coffee? #f)
  (define dock-mark? #f)
  (define poster? #f)
  (define invitation? #f)
  (define (active?) (and (= (第一幕 'act) 2) (not (第二章 'started?))))
  (define (empty-tavern!)
    (set! tavern? #t)
    (play-dialogue!
      (line "世界" "小舞台还在，灯却没亮。酒保擦着那块从前放歌谱的吧台。")
      (line "调酒师" "她走了以后，这儿倒清静。")
      (line "尼尔" "你不是总嫌她唱得太晚？")
      (line "调酒师" "嫌归嫌。晚上少点动静，酒都卖得慢了。")
      (line "调酒师" "剧院在招搬布景的。你不是总嫌这儿没出息？")))
  (define (ship-arrival!)
    (set! ship? #t)
    (play-dialogue!
      (line "世界" "一声长汽笛响起。一艘临时改港的大船被拖进码头，工人从旧街往栈桥跑来。")
      (line "工人" "这么大一条？不是说去北港吗？")
      (line "世界" "弗兰克爬上货箱，组织人手分班卸货。")
      (line "弗兰克" "东边先接货！等吊索停稳再过去！")
      (line "世界" "艾迪帮年轻工人抬稳箱子，又把水壶递给他。")
      (line "艾迪" "先喝口水。船又不会自己跑掉。")
      (line "弗兰克" "艾迪！东边缺两个人！")
      (line "艾迪" "来了！尼尔，跟不跟？今晚多给钱。")))
  (define (shift! kind)
    (cond
      ((eq? kind '好) (add-item! "金钱" 28))
      ((eq? kind '中) (add-item! "金钱" 16) (spend-composure! 1))
      (else (add-item! "金钱" 6) (spend-composure! 2)))
    (play-dialogue!
      (line "世界" "工人把货箱一只只传下栈桥。吊索停住后，艾迪示意大家先歇口气。")
      (line "艾迪" "好样的！先喝口水，下一车还得等着呢。")))
  (define (manager-coffee!)
    (set! coffee? #t)
    (play-dialogue!
      (line "世界" "经理在前厅送客，看到尼尔，便从侍者的托盘上拿下一杯咖啡。")
      (line "经理" "兄弟！忙坏了吧？来，喝杯热的。")
      (line "尼尔" "你不用特意——")
      (line "经理" "年轻人不能光顾着挣钱！咱们是一家人。")
      (line "世界" "赞助人叫住经理。他立刻转身，伸出了手。")
      (line "经理" "马上来，亲爱的朋友！")
      (line "世界" "他再拍拍尼尔肩膀，匆匆走远。")))
  (define (dock-mark!)
    (set! dock-mark? #t)
    (play-dialogue!
      (line "世界" "货栈外墙出现几道测绘的粉笔线，旁边贴着腾退评估通知。")
      (line "工人" "这墙上画的什么？明天还在这儿干活吗？")
      (line "世界" "测绘员没有回答。远处又响起一声船笛。")))
  (define (poster!)
    (set! poster? #t)
    (play-dialogue!
      (line "世界" "大剧院外刚挂上一张新海报：从旧港走向新城——夜莺首演。")
      (line "世界" "她在海报里笑得灿烂，剧院的工人仍忙着调灯。")))
  (define (next-job!)
    (set! invitation? #t)
    (play-dialogue!
      (line "经理" "尼尔！兄弟，有件更像样的调查想请你帮忙。")
      (line "尼尔" "什么事？")
      (line "经理" "有人不愿意让夜莺顺利登台。线索也许就在旧港。")
      (line "经理" "我开得出更好的价钱。这回真得靠你。")))
  (define (arrivals-at loc)
    (if (not (active?)) '()
      (append
        (if (and (= world-day 7) (equal? loc "老街酒馆") (not tavern?))
          (list (arrival "酒馆里少了一个人" empty-tavern!)) '())
        (if (and (= world-day 9) (equal? loc "码头") (not ship?))
          (list (arrival "大船靠岸" ship-arrival!)) '())
        (if (and (>= world-day 13) (equal? loc "码头") (not dock-mark?))
          (list (arrival "旧港测绘标记" dock-mark!)) '())
        (if (and (>= world-day 13) (equal? loc "剧院") (not poster?))
          (list (arrival "新城海报" poster!)) '()))))
  (define (nodes-at loc)
    (if (not (active?)) '()
      (append
        (if (and (equal? loc "码头") (= world-day 9))
          (list (工作 "抢卸夜班" '冒险 'violence
            (outcome (lambda () (shift! '好)))
            (outcome (lambda () (shift! '中)))
            (outcome (lambda () (shift! '坏)))
            "临时大船，高薪夜班；失手损失冷静"
            :risk-target (list 'composure "player")
            :progress-target (list 'item "金钱"))) '())
        (if (and (equal? loc "剧院") (= world-day 10)
                 (第二幕生活 'manager-met?) (not coffee?))
          (list (instant-action "经理请喝咖啡" manager-coffee!)) '())
        (if (and (equal? loc "剧院") (>= world-day 13)
                 (第二幕生活 'manager-met?) (not invitation?))
          (list (instant-action "经理的新委托" next-job!)) '()))))
  (define (dossier-at)
    (if (and (active?) (>= world-day 8) (<= world-day 9))
      (list (dossier "临时货船" :kind '城市 :primary #f
        :now (if (= world-day 8)
          "听说一艘大船明天临时改港，码头或许有夜班。"
          "大船今天靠岸。去码头可以参加抢卸夜班。")
        :where "码头")) '()))
  (lambda args
    (let ((msg (car args)))
      (cond
        ((eq? msg 'nodes-at) (nodes-at (cadr args)))
        ((eq? msg 'arrivals-at) (arrivals-at (cadr args)))
        ((eq? msg 'dossier) (dossier-at))
        ((eq? msg 'save) (list (list "tavern" tavern?) (list "ship" ship?)
          (list "coffee" coffee?) (list "dock-mark" dock-mark?)
          (list "poster" poster?) (list "invitation" invitation?)))
        ((eq? msg 'load!)
          (let ((data (cadr args)))
            (set! tavern? (assoc-get data "tavern" #f))
            (set! ship? (assoc-get data "ship" #f))
            (set! coffee? (assoc-get data "coffee" #f))
            (set! dock-mark? (assoc-get data "dock-mark" #f))
            (set! poster? (assoc-get data "poster" #f))
            (set! invitation? (assoc-get data "invitation" #f))))
        (else (error "第二幕节奏：未知消息")))))))