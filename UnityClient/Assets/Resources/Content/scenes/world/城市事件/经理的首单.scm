;; 经理首单：城市中的残局；成败只改变回应和报酬，不截断合作。
(define 醉酒演员 (speaker "演员亨利" :name "亨利" :appearance '成年男性))
(define 经理首单餐厅老板 (speaker "演员餐厅老板" :name "餐厅老板" :appearance '成年男性))
(define 经理的首单
  (let ()
    (define 阶段 "未见")
    (define 到场? #f)
    (define 结果 "")
    (define 进展 (make-clock "收拾残局" 6 'gauge "安抚亨利，与餐厅老板谈妥赔偿。" :beneficial-direction 'increase))
    (define 危险 (make-clock "警察注意" 4 'pressure "满格时巡警介入，差事失败，但仍要向经理交代。" :beneficial-direction 'decrease))
    (define (介绍!)
      (set! 阶段 "待答复")
      (第二幕生活 'remember-manager!)
      (play-dialogue!
    (line "世界" "卡座在酒馆最里头，离吵闹的吧台有段距离。男人穿着剪裁合身的呢子大衣，面前的威士忌只喝了一浅口。他朝尼尔抬了抬手，示意对面的空位。")
    (line "经理" "坐吧，尼尔先生。前些时候门口那场乱子，多亏你肯出面。")
    (line "世界" "酒保端着抹布过来想解释两句，男人只是温和地摆了摆手，酒保便识趣地退开了。尼尔拉开椅子坐下，手放在桌沿，没去碰桌上的酒。")
    (line "尼尔" "您认识我？")
    (line "经理" "听吉姆提过一嘴，说店里来了个话不多、遇事肯出面的年轻人。我是东街大剧院的经理。")
    (line "尼尔" "刚才那也不算压住，就是让人别在店里动手。")
    (line "经理" "肯站出来接住这摊事，就不容易。我管着一个剧团，天天都在跟脾气打交道，知道里面的分寸。")
    (line "世界" "他把旁边的干净酒杯往尼尔面前推了半寸。")
    (line "经理" "正好，我手头有个不大不小的麻烦，不适合让剧院出面，更不能惊动警察。不知道你接不接这种私活？")
    (line "尼尔" "您先说说看。")
    (line "经理" "我们剧团的男演员亨利，在剧院旁边的餐厅陪赞助人吃饭。席间被对方讥讽了两句，这蠢货喝多了，等人走后把包厢给砸了。现在餐厅老板堵着门要报警，亨利还在里头耍酒疯。")
    (line "尼尔" "您要我把他带出来？")
    (line "经理" "先把人安抚住，别让他闹到报上去；再帮我把包厢里砸坏的东西清点清楚。赔偿的钱我出，不让你垫一分。只要把事情收住，别惊动警察，事成之后，这四十美元是你的酬劳。")))
    (define (接受!)
      (if (equal? 阶段 "待答复") #t (error "经理首单：无待答复委托"))
      (set! 阶段 "处理中")
      (play-dialogue!
    (line "尼尔" "餐厅叫什么？我现在过去。")
    (line "经理" "金雀餐厅，就在剧院南侧巷口。跟老板提我的名字，他知道账找谁算。麻烦你了，尼尔先生。")))
    (define (婉拒!)
      (set! 阶段 "婉拒")
      (play-dialogue!
    (line "尼尔" "抱歉，醉鬼的事太碎，我还有别的活。")
    (line "经理" "理解。这种烂摊子确实讨嫌。酒钱我结过了，以后有机会再合作，尼尔先生。")))
    (define (到场!)
      (set! 到场? #t)
      (play-dialogue!
    (line "世界" "包厢门半开着，一地碎瓷片和红酒渍。老板站在门口，手里攥着账本，脸色铁青；演员亨利歪在沙发里，领结扯开了一半，正拿餐巾擦袖口上的酒。")
    (line 经理首单餐厅老板 "我不管他是哪个台上的角儿！这面镜子是从外地运来的，今天不给个说法，巡警就在街口！")
    (line 醉酒演员 "去叫啊！叫他们来看看，那群卖猪肉的暴发户是怎么跟艺术家说话的！")
    (line "尼尔" "两位，我是大剧院经理派来的。门先关上，外头还有客人吃饭，闹大了对谁都没好处。")
    (line 经理首单餐厅老板 "你是来付钱的？")
    (line "尼尔" "钱由剧院照价赔。但在那之前，咱们得先把账算清，让他清醒点。")))
    (define (处理回应! ability progress danger)
      (if (eq? ability 'social)
        (cond ((> danger 0) (play-bubble!
    (line 醉酒演员 "连你也来教训我？滚出去！" :at "剧院")
    (line "世界" "空酒瓶砸在门框上，大厅里又有人探头往这边看。")))
          ((> progress 1) (play-bubble!
    (line "尼尔" "人已经走了。你越砸，他们越觉得自己说得没错。先喝口水。")
    (line 醉酒演员 "……水呢？别给我倒酒了。" :at "剧院")))
          (else (play-bubble!
    (line "尼尔" "经理让我来看看。你有话，可以等回剧院再说。")
    (line 醉酒演员 "他也就会哄那些有钱人。你先别替他开口。" :at "剧院"))))
        (cond ((> danger 0) (play-bubble!
    (line 经理首单餐厅老板 "你们是来算账还是赖账的？再这么磨，我就去找巡警！" :at "剧院")))
          ((> progress 1) (play-bubble!
    (line "尼尔" "这把椅子的旧裂口还在，不能全按新家具算。碎了的镜子我们认。")
    (line 经理首单餐厅老板 "……椅子我再算。镜子一分不能少。" :at "剧院")))
          (else (play-bubble!
    (line "尼尔" "先把损坏的东西列清楚。单子我会带给经理看。")
    (line 经理首单餐厅老板 "我一件件记着呢。你也看仔细点。" :at "剧院"))))))
    (define (处理! ability progress danger)
      (if (equal? 阶段 "处理中") #t (error "经理首单：已经结算"))
      (进展 'advance! progress) (危险 'advance! danger)
      (if (or (进展 'full?) (危险 'full?)) #f
        (处理回应! ability progress danger))
      (cond
        ((危险 'full?)
          (set! 阶段 "失败待交差") (set! 结果 "失败")
          (play-dialogue!
    (line "世界" "包厢外传来沉重的靴子声，两个巡警推开老板走了进来，警棍在门板上敲了两下。")
    (line "巡警" "怎么回事？整条街都听见摔东西了！这位先生跟我们回局子说清楚，别的人让开！")
    (line 醉酒演员 "别碰我！你们知道我是谁吗——")
    (line "尼尔" "……麻烦大了。得回去通知经理捞人了。")))
        ((进展 'full?)
          (set! 阶段 "成功待交差") (set! 结果 "成功")
          (play-dialogue!
    (line "世界" "老板收好签了字的单据，冷着脸让服务生进来扫地。亨利披着大衣站起来，酒醒了一半，低着头不敢看走廊里的客人。")
    (line 醉酒演员 "……今天这事，经理那边怎么说？")
    (line "尼尔" "他让你回去睡一觉，明早排练别迟到。走后门吧，车在巷子里。")))
        (else #f)))
    (define (交差!)
      (if (member? 阶段 '("成功待交差" "失败待交差")) #t (error "经理首单：尚无结果可交差"))
      (set! 阶段 "已交差")
      (add-item! "金钱" (if (equal? 结果 "成功") 40 10))
      (调查职业 'recognize!)
      (if (equal? 结果 "成功")
        (play-dialogue!
    (line "世界" "经理放下手里的节目单，听尼尔把事情说完，没有急着插话。")
    (line "经理" "亨利呢？")
    (line "尼尔" "接回去了。赔偿单也交代清楚，就等您派人结账。")
    (line "世界" "经理翻了翻单子，从西装内袋拿出信封，放到两人之间。")
    (line "经理" "四十美元，说好的。")
    (line "尼尔" "您不再核一遍？")
    (line "经理" "老板会来找我。亨利也会。要是有漏下的东西，我迟早听得见。")
    (line "世界" "尼尔看了他一眼，才把信封收进衣袋。")
    (line "经理" "这次你替我把事情收住了。下回有合适的差事，我还找你。后台的门房我会打招呼，你过来不必在门口等。")
    (line "尼尔" "好。有事您说话。"))
        (play-dialogue!
    (line "世界" "经理正在看新印的节目单。尼尔走上前，他先把手里的纸放下。")
    (line "尼尔" "巡警还是进来了。亨利被带走了。")
    (line "经理" "我知道。警局那边已经处理，餐厅的账也清了。")
    (line "世界" "尼尔顿了一下，准备好的解释咽了回去。经理数出十美元递来，尼尔没接。")
    (line "尼尔" "事办砸了，这钱我不能拿。")
    (line "经理" "这事不怪你。亨利发疯的时候，十个看场子的也未必拦得住。你跑了一趟，该拿跑腿钱。")
    (line "世界" "经理把钱留在桌上，重新拿起节目单，又想起什么似的抬头。")
    (line "经理" "后台那边我会交代。以后来找我，门房不会拦你。下回有适合的差事，咱们再试。")
    (line "尼尔" "……谢了。"))))
    (define (处理行动 id title ability)
      (node id :name title :anchor "剧院" :requires (list (req-die)) :risk '冒险
        :subtitle (if (eq? ability 'social)
          "听亨利抱怨，劝他安静；失手引来警察。"
          "清点损坏、稳住老板；失手引来警察。")
        :progress-target (list 'clock "收拾残局")
        :resolve (roll ability (outcome (lambda () (处理! ability 0 1)))
          (outcome (lambda () (处理! ability 1 0))) (outcome (lambda () (处理! ability 2 0))))))
    (define (nodes-at loc)
      (append
        (if (and (equal? loc "老街酒馆") (equal? 阶段 "待答复"))
          (list (node "经理首单答复" :name "经理的差事" :anchor "老街酒馆-工作" :display 'inline
            :children (list
              (node "接受经理首单" :subtitle "去剧院旁餐厅收拾亨利的残局。" :name "接下差事" :button-text "接受" :resolve (instant (outcome 接受!)))
              (node "婉拒经理首单" :subtitle "表示不便插手，礼貌回绝经理。" :name "婉拒差事" :button-text "拒绝" :resolve (instant (outcome 婉拒!)))))) '())
        (if (and (equal? loc "世界") (equal? 阶段 "处理中") 到场?)
          (list (node "旅馆演员残局" :name "餐厅包厢的残局" :anchor "剧院"
            :children (list
              (at-anchor "剧院" (clock-node "亨利残局进展" (进展 'render-data)))
              (at-anchor "剧院" (clock-node "亨利警察注意" (危险 'render-data)))
              (处理行动 "安抚演员亨利" "安抚亨利" 'social)
                            (处理行动 "清点演员赔偿" "核清赔偿" 'sharpness)))) '())
        (if (and (member? 阶段 '("成功待交差" "失败待交差"))
                 (equal? loc "剧院"))
          (list (node "经理首单交差" :name "交代结果" :button-text "交谈"
            :required-before-rest "先向经理交代餐厅里的结果"
            :anchor "剧院-后台"
            :subtitle "向经理说明亨利一事的收场。" :resolve (instant (outcome 交差!)))) '())
        (if (and (equal? loc "剧院") (第二幕生活 'manager-met?))
          (list (at-anchor "剧院-后台" (note-node "经理此刻" "经理" "他在道具间外核对账目，偶尔停笔应付路过的演员。"))) '())))
    (lambda (msg . args)
      (cond
        ((eq? msg 'arrivals-at)
          (cond ((and (equal? (car args) "老街酒馆") (酒馆起步 'settled?) (equal? 阶段 "未见"))
                  (list (arrival "经理请你喝酒" 介绍!)))
                ((and (equal? (car args) "世界") (equal? 阶段 "处理中") (not 到场?))
                  (list (arrival "餐厅里的醉酒演员" 到场!))) (else '())))
        ((eq? msg 'access?) (member? 阶段 '("处理中" "成功待交差" "失败待交差" "已交差")))
        ((eq? msg 'nodes-at) (nodes-at (car args)))
        ((eq? msg 'dossier)
          (if (equal? 阶段 "未见") '()
            (list (dossier "经理的第一份差事" :kind '委托
              :status (if (member? 阶段 '("已交差" "婉拒")) '了结 '进行中)
              :now (cond ((equal? 阶段 "待答复") "经理请你安置闹事的演员亨利，办成付40美元。是否接下，由你决定。")
                ((equal? 阶段 "处理中") "回餐厅安抚亨利、核清赔偿，别把巡警招来。成败都要向经理交代。")
                ((equal? 阶段 "已交差") "经理结清酬劳，也交代门房让你出入后台。以后还有事会找你。")
                ((equal? 阶段 "婉拒") "你婉拒了这份差事，经理另找了人。")
                (else "事情已有结果。休息前去找经理，当面交代经过。"))
              :clocks (if (equal? 阶段 "处理中") (list (进展 'render-data) (危险 'render-data)) '())
              :where (if (equal? 阶段 "处理中") "世界" "剧院")))))
        ((eq? msg 'save) (list (list "stage" 阶段) (list "arrived" 到场?) (list "result" 结果) (list "progress" (进展 'save)) (list "danger" (危险 'save))))
        ((eq? msg 'load!) (let ((s (car args)))
          (set! 阶段 (assoc-get s "stage" "未见")) (set! 到场? (assoc-get s "arrived" #f)) (set! 结果 (assoc-get s "result" ""))
          (进展 'load! (assoc-get s "progress" 0)) (危险 'load! (assoc-get s "danger" 0))
          (if (member? 阶段 '("未见" "待答复" "处理中" "成功待交差" "失败待交差" "已交差" "婉拒")) #t (error "经理首单：非法阶段"))))
        (else (error "经理首单：未知消息"))))))
