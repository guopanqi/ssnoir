;; Tommy 的新起步只做到收账；旧帮派后段保持暂隐。
(define 鞋匠莫里斯 (speaker "鞋匠莫里斯" :name "莫里斯" :appearance '成年男性))
(define 马场比尔 (speaker "马场比尔" :name "比尔" :appearance '成年男性))
(define Tommy收账
  (let ()
    (define 阶段 "未见")
    (define 相识日 0)
    (define 线索日 0)
    (define 请过客? #f)
    (define 锁面 '())
    (define 已开 '())
    (define (初遇!)
      (set! 阶段 "饭钱待答")
      (play-dialogue!
        (line "世界" "汤米和两个街头熟人挤在酒馆角落。他穿着宽垫肩西装，替两人续满杯子。")
        (line "汤米" "跟着我，什么时候让你们吃过亏？今晚算我的。")
        (line "世界" "两人喝完先走了。酒保把账单推来，汤米数了数口袋里的零钱，将账单翻过去。")
        (line "调酒师" "还差十五美元。你说今晚结清。")
        (line "汤米" "我知道。小点声。")))
    (define (相识! paid?)
      (if paid? #t (error "汤米：借款行动必须实际付款"))
      (set! 请过客? #t) (set! 相识日 world-day) (set! 阶段 "相识")
      (play-dialogue!
        (line "世界" "尼尔把十美元和五美元压在账单下面，推给酒保。")
        (line "尼尔" "先垫上。")
        (line "汤米" "借我的。不是请我。")
        (line "尼尔" "行。我叫尼尔。")
        (line "汤米" "汤米。过几天还你三十。今天这事，不必跟那两个家伙提。")))
    (define (邀收账!)
      (if 请过客? (add-item! "金钱" 30) #f)
      (set! 阶段 "收账待答复")
      (begin (if 请过客? (play-dialogue!
    (line "世界" "刚碰面，汤米就大步流星地走过来，把一张二十美元和一张十美元钞票塞进你手里，下巴扬得老高。")
    (line "汤米" "呐，拿着！我汤米说话算话，说还双倍就还双倍，从不欠人情。")) (play-dialogue!
    (line "世界" "汤米晃着那身宽大的西装朝你走来，熟络地跟你打了个响指。")
    (line "汤米" "哟，尼尔！前几天在酒馆我就看出你是个干大事的人了。"))) (play-dialogue!
    (line "汤米" "（左右看了看，神秘兮兮地凑近半步）我手里刚接了一笔大买卖——码头巷口修鞋铺的莫里斯，欠了人一笔陈年坏账死活不认。我需要个镇得住场的搭档跟我一起去拿人，事成之后，分你二十美元！干不干？"))))
    (define (答复! accepted?)
      (set! 阶段 (if accepted? "初次收账" "婉拒"))
      (if accepted? (play-dialogue!
    (line "尼尔" "二十美元？行，我倒想看看你汤米大爷是怎么收账的。")
    (line "汤米" "痛快！咱们这就去码头巷口的鞋铺会会那个老狐狸！")) (play-dialogue!
    (line "尼尔" "听着像是个得罪人的苦差事，你自己去发财吧，我不掺和。")
    (line "汤米" "啧，白白放过挣快钱的机会！算了，我自己去会会他。"))))
    (define (碰壁!)
      (set! 阶段 "等线索") (set! 线索日 (+ world-day 2))
      (add-item! "莫里斯债据" 1)
      (play-dialogue!
    (line "世界" "码头巷口的修鞋铺里堆满了破皮靴，空气里满是胶水和臭脚汗味。汤米一脚踩在门槛上，双手叉腰，把嗓门压得又低又粗。")
    (line "汤米" "莫里斯老头！识相的就把欠款交出来，不然今天让你这铺子开不下去！")
    (line 鞋匠莫里斯 "（头都没抬，猛地抓起手边沉重的铁木鞋楦，哐当一声砸在柜台上，怒目圆睁）滚出去！小兔崽子，拿张欠条就想拆我的铺子？再不滚，老子把这鞋楦砸进你鼻梁里！")
    (line "世界" "莫里斯拎着铁鞋楦冲出柜台，你们两个被他劈头盖脸地轰到了巷子外。汤米狼狈地扶正歪掉的领带，气得直喘粗气。")
    (line "尼尔" "看来你的狠话对他不太管用。")
    (line "汤米" "（咬了咬牙，脸上有些挂不住，但很快又梗起脖子）这老家伙滑得很，光靠嚷嚷唬不住他。你等着，尼尔！这笔莫里斯亲笔签名的现用债据你先收好，我去托道上的朋友挖挖他的老底。给我两天时间，不揪出他的真把柄，你等我的消息！")))
    (define (线索!)
      (set! 阶段 "找比尔")
      (play-dialogue!
    (line "世界" "汤米风风火火地找了过来，条纹西装下摆沾着泥点，眼眶有点发青，但精神却亢奋得很。")
    (line "汤米" "尼尔！被我挖出来了！那个修鞋的莫里斯，年轻时候根本不叫莫里斯，他在码头混的时候外号叫「快脚雷」！")
    (line "尼尔" "快脚雷？听着像是个跑路很快的人。")
    (line "汤米" "可不是嘛！当年他替一帮码头工友收合买赛马的赌金，结果出了乱子。我打听到当年跟他搭过伙的一个老工人叫比尔，现在常在码头货棚看货。")
    (line "尼尔" "干得不错啊，汤米。这回真让你摸到门道了。")
    (line "汤米" "（得意地抹了把鼻子）那是自然！我这就去鞋铺外头盯着那老小子的动静，免得他跑了。你去码头货棚找比尔问问当年的事，看看能不能拿到实打实的证据！")))
    (define (见比尔!)
      (set! 阶段 "开箱")
      (set! 锁面 (map (lambda (i) (random-choice '(1 2))) '(0 1 2 3)))
      (play-dialogue!
    (line "世界" "码头货棚旁，老工人比尔坐在一只积灰的铁皮箱边歇脚。听你提起「快脚雷」三个字，他手里的烟灰落在裤腿上。")
    (line 马场比尔 "……快脚雷？那狗娘养的还活着？")
    (line "尼尔" "改名叫莫里斯了，在码头巷口修鞋。我想找点他当年干坏事的铁证，让他吐出欠款。")
    (line 马场比尔 "（狠狠唾了一口）旧账簿还在码头货棚的马票箱里，我那笔钱也记在上面。这几年我钥匙早丢了，箱子上的四个锁扣也锈死了。你要是能把那四个锁扣弄开，我就在这儿跟你说说。当年我们可没少在他身上吃亏！")))
    (define (故事!)
      (if (> (item-count "莫里斯债据") 0) #t (error "Tommy收账：缺少先前交给尼尔的债据"))
      (set! 阶段 "得到把柄")
      (add-item! "快脚雷的旧账" 1)
      (play-dialogue!
    (line "世界" "随着最后一个锁扣弹开，码头货棚里扬起一阵陈年灰尘。掀开铁皮箱盖，里面躺着一本泛黄的硬皮旧账簿，还有几张印着红色编号的旧马票。跟过来的比尔喘着粗气，伸手摸出那张写着「星期天」字样的马票，手指有些发抖。")
    (line 马场比尔 "就是这匹马……「星期天」。十五年前的春季大奖赛，快脚雷在工棚里跟大伙拍胸脯，说他有马场的内部门路，「星期天」稳赢，赔率一比八。")
    (line "尼尔" "（翻开旧账簿，上面密密麻麻记着十几个码头工人的名字和凑出来的零钱）你们把积蓄都交给他去下注了？")
    (line 马场比尔 "整整一个月的血汗钱啊！比赛当天晚上，他拿着这几张马票回来，说已经赢了，大伙儿高兴疯了，凑钱在酒馆请他喝了一宿的酒，等第二天分到赢来的钱。结果第二天赛报一出来——")
    (line "尼尔" "那匹马输了？")
    (line 马场比尔 "（苦笑了一声，眼里全是血丝）输了倒也认栽了！赛报上白纸黑字写着，「星期天」因为腿伤，在开赛前两天就已经正式退赛了！那天它根本就没进赛场！")
    (line "尼尔" "（仔细端详手里的马票）所以他根本没去下注，只是找私印坊印了几张假票糊弄你们，自己揣着大伙儿的赌金连夜跑路了。")
    (line 马场比尔 "没错！等我们拿着假票去马场被人轰出来，回工棚一看，那小子的铺盖早空了。这些年他居然敢换个名字摸回码头开鞋铺！")
    (line "尼尔" "（从口袋里掏出汤米留下的「莫里斯债据」，与旧账簿最后一页快脚雷的亲笔收款签名并排放在一起）姓氏虽然改了，但你看这个字母「R」收尾的弯钩，还有数字「5」连笔的习惯……跟当年快脚雷的亲笔收款页一模一样。加上你这个当事人的指认，他赖不掉的。")
    (line 马场比尔 "（看着两张纸，重重吐出一口浊气，把旧账簿塞进你手里）拿去吧，小伙子。当年那帮老弟兄死的死、散的散，我也不指望他能把十几年前的钱全吐出来，但别让这混球再在码头上安心睡大觉了！")))
    (define (开扣! i)
      (if (and (equal? 阶段 "开箱") (not (member? i 已开))) #t (error "开锁：锁扣不可重复结算"))
      (set! 已开 (cons i 已开))
      (if (= (length 已开) 4) (故事!) #f))
    (define (收账!)
      (if (equal? 阶段 "得到把柄") #t (error "Tommy收账：缺少把柄阶段"))
      (set! 阶段 "完成")
      (add-item! "金钱" 20)
      (play-dialogue!
    (line "世界" "修鞋铺里，莫里斯原本还想抄起鞋楦骂人，但当你把那本泛黄的旧账簿和印着「星期天」的假马票拍在柜台上时，老头的脸色变了。")
    (line "尼尔" "「星期天」在开赛前两天就退赛了，快脚雷。老比尔还在酒馆里坐着呢，而且你现在签字的习惯，可跟十五年前一模一样。")
    (line 鞋匠莫里斯 "（嘴唇哆嗦着，眼神惊恐地往门外瞟了一眼）你……你们想怎么样？那都是十几年前的旧事了！")
    (line "尼尔" "我不是巡警，也不是替当年所有工友来算总账的。但要是这本账簿明天贴到码头招工板上去，你的老主顾会怎么想？先把今天这笔欠款结清。")
    (line "世界" "莫里斯像被抽掉了脊梁骨一样跌坐回矮凳上，颤抖着手撬开柜台底下的铁盒，把一沓钞票推了出来。")
    (line "世界" "走出暗巷后，汤米把属于你的二十美元数出来递给你。往常总是咋咋呼呼的年轻人，这会儿却有些出奇地安静，只是低头看着手里的钞票。")
    (line "尼尔" "怎么不说话了？钱要回来了，不吹两句？")
    (line "汤米" "（把钱塞进宽大的西装内袋，轻轻呼了口气）……我以前以为收账就是比谁嗓门大、谁拳头硬。没想到一张十几年前的旧纸片，能把人吓成那样。谢了，尼尔。今天这事，我还以为只要把嗓门压低就行了。")))
    (define (locks)
      (map (lambda (i)
        (node (string-append "旧马票箱锁扣" (number->string (+ i 1)))
          :name (string-append "锁扣" (number->string (+ i 1))) :anchor "码头-货堆"
          :subtitle (string-append "需要" (number->string (list-ref 锁面 i)) "点骰子；投入后直接打开")
          :requires (list (req-die (list-ref 锁面 i)))
          :resolve (instant (outcome (lambda () (开扣! i))))))
        (filter (lambda (i) (not (member? i 已开))) '(0 1 2 3))))
    (define (nodes-at loc)
      (append
        (if (equal? loc "老街酒馆")
          (append
            (if (equal? 阶段 "饭钱待答")
              (list (node "汤米饭钱" :name "汤米的酒账" :anchor "老街酒馆-工作" :display 'inline
                :children (list
                  (node "请汤米吃土豆" :button-text "执行" :subtitle "借给汤米15美元，补清他请客的酒账。" :name "替他垫账" :requires (list (req-item "金钱" 15)) :resolve (instant (outcome (lambda () (相识! #t)))))
                  ))) '())
            (if (equal? 阶段 "收账待答复")
              (list (node "汤米收账邀请" :name "汤米的坏账" :anchor "老街酒馆-工作" :display 'inline
                :children (list
                  (node "接下汤米收账" :subtitle "和汤米去莫里斯鞋铺收账。" :name "接下收账" :button-text "接受" :resolve (instant (outcome (lambda () (答复! #t)))))
                  (node "婉拒汤米收账" :subtitle "不参加这次收账。" :name "婉拒收账" :button-text "拒绝" :resolve (instant (outcome (lambda () (答复! #f)))))))) '())
          ) '())
        (if (equal? loc "码头")
          (append
            (if (equal? 阶段 "找比尔")
              (list (node "打听快脚雷" :subtitle "找码头货棚旁的比尔问快脚雷的往事。" :name "打听旧事" :anchor "码头-货堆" :button-text "交谈" :resolve (instant (outcome 见比尔!)))) '())
            (if (equal? 阶段 "初次收账")
              (list (node "第一次找莫里斯" :subtitle "和汤米去码头鞋铺找莫里斯要钱。" :name "上门收账" :anchor "码头-巷口" :button-text "交谈" :resolve (instant (outcome 碰壁!)))) '())
            (if (member? 阶段 '("等线索" "找比尔" "开箱" "得到把柄"))
              (list (node "莫里斯收账" :name "让他还钱" :anchor "码头-巷口" :button-text "交付"
                :subtitle "让莫里斯看看他从前的旧账。" :requires (list (req-item "快脚雷的旧账" 1))
                :resolve (instant (outcome 收账!)))) '())
            (if (equal? 阶段 "开箱")
              (list (node "旧马票箱" :anchor "码头-货堆" :display 'inline :children (locks))) '())
            (if (equal? 阶段 "等线索")
              (list (at-anchor "码头-巷口" (note-node "汤米打听旧人" "汤米的去向" "他去打听鞋匠的旧相识了，说好两天后带消息回来。"))) '())) '())
        (if (and (equal? loc "老街酒馆") (member? 阶段 '("等线索" "初次收账" "开箱" "得到把柄")))
          (list (at-anchor "老街酒馆-工作" (note-node "汤米酒馆去向" "汤米的去向"
            (if (equal? 阶段 "等线索") "他去打听马场的旧人了，说好两天后带回消息。" "他去码头的莫里斯鞋铺盯着那笔账了。")))) '())
        (if (and (equal? loc "老街酒馆") (member? 阶段 '("相识" "完成" "婉拒")))
          (list (at-anchor "老街酒馆-工作" (note-node "汤米在酒馆" "汤米" "他坐在酒馆角落喝汽水，偏大的西装袖口挽了两折。"))) '())))
    (lambda (msg . args)
      (cond
        ((eq? msg 'nodes-at) (nodes-at (car args)))
        ((eq? msg 'arrivals-at)
          (let ((loc (car args)))
            (cond
              ((and (equal? loc "老街酒馆") (> (酒馆起步 'count) 0) (equal? 阶段 "未见")) (list (arrival "汤米的酒账" 初遇!)))
              ((and (member? loc '("家" "老街酒馆")) (equal? 阶段 "相识") (>= world-day (+ 相识日 4))) (list (arrival "汤米加倍奉还" 邀收账!)))
              ((and (member? loc '("家" "老街酒馆")) (equal? 阶段 "等线索") (>= world-day 线索日)) (list (arrival "汤米带回线索" 线索!)))
              (else '()))))
        ((eq? msg 'dossier)
          (if (equal? 阶段 "未见") '()
            (list (dossier "汤米的第一笔坏账" :kind '人物 :status (if (member? 阶段 '("完成" "婉拒")) '了结 '进行中)
              :now (cond ((equal? 阶段 "饭钱待答") "汤米请人喝酒，结账还差十五美元。可以借他周转，替他保住面子。")
                ((equal? 阶段 "相识") "汤米说自己收账很有办法，过几天还会碰面。")
                ((equal? 阶段 "收账待答复") "汤米邀你去莫里斯鞋铺收账，可以接受或拒绝。")
                ((equal? 阶段 "初次收账") "去码头巷口找莫里斯。")
                ((equal? 阶段 "等线索") "第一次收账碰壁。汤米去打听旧人，两天后会带来消息。")
                ((equal? 阶段 "找比尔") "去码头货棚找比尔，问问快脚雷的往事。")
                ((equal? 阶段 "开箱") (string-append "比尔的账簿锁在码头旧马票箱中。已开锁扣 " (number->string (length 已开)) "/4；按显示点数投入骰子，可以分次打开。"))
                ((equal? 阶段 "得到把柄") "拿到快脚雷的旧账，回码头鞋铺让莫里斯还钱。")
                ((equal? 阶段 "婉拒") "你没参加这次收账。汤米决定自己想办法。")
                (else "莫里斯还了欠款，你分得20美元。汤米没忘记搭档的份额。"))
              :where (if (member? 阶段 '("初次收账" "找比尔" "开箱" "得到把柄")) "码头" "老街酒馆")))))
        ((eq? msg 'save) (list (list "stage" 阶段) (list "met-day" 相识日) (list "clue-day" 线索日) (list "paid" 请过客?) (list "faces" 锁面) (list "opened" 已开)))
        ((eq? msg 'load!) (let ((s (car args)))
          (set! 阶段 (assoc-get s "stage" "未见")) (set! 相识日 (assoc-get s "met-day" 0)) (set! 线索日 (assoc-get s "clue-day" 0))
          (set! 请过客? (assoc-get s "paid" #f)) (set! 锁面 (assoc-get s "faces" '())) (set! 已开 (assoc-get s "opened" '()))
          (if (and (member? 阶段 '("未见" "饭钱待答" "相识" "收账待答复" "初次收账" "等线索" "找比尔" "开箱" "得到把柄" "完成" "婉拒"))
                   (or (null? 锁面) (and (= (length 锁面) 4) (null? (filter (lambda (x) (not (member? x '(1 2)))) 锁面))))
                   (null? (filter (lambda (x) (not (member? x '(0 1 2 3)))) 已开))
                   (or (not (equal? 阶段 "开箱")) (and (= (length 锁面) 4) (< (length 已开) 4)))) #t (error "Tommy收账：非法存档"))))
        (else (error "Tommy收账：未知消息"))))))
