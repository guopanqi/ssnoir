;; 马丁的妻子：先了解并决定是否接取；两段调查分别揭示去向与原因。
(define 委托人海伦 (speaker "委托人海伦" :name "海伦" :appearance '成年女性))
(define 海伦的丈夫 (speaker "海伦的丈夫" :name "马丁" :appearance '成年男性))
(define 马丁委托旅馆老板 (speaker "马丁委托旅馆老板" :name "旅馆老板" :appearance '成年男性))
(define 海伦的委托
  (let ()
    (define 阶段 "未出现")
    (define 结果 "")
    (define 跟踪 (make-clock "跟踪马丁" 4 'gauge "跟踪马丁离开工厂后的行踪，拍下他去的地方。" :beneficial-direction 'increase))
    (define 调查 (make-clock "查明马丁的去向" 6 'gauge "向旅馆老板与马丁问清原因，不增加报酬。" :beneficial-direction 'increase))
    (define (进行中?) (member? 阶段 '("跟踪中" "初步材料" "查明实情")))
    (define (介绍!)
      (if (equal? 阶段 "待交谈") #t (error "海伦：当前不可介绍"))
      (set! 阶段 "待答复")
      (play-dialogue!
    (line "世界" "一位衣着整洁但眼窝深陷的妇人坐在你房间唯一的木椅上，双手紧紧攥着一只旧手提包。")
    (line 委托人海伦 "尼尔先生，我叫海伦。这事我实在没法跟街坊亲戚开口……我怀疑我丈夫马丁在外头有人了。")
    (line "尼尔" "有什么具体的迹象吗，海伦女士？")
    (line 委托人海伦 "他在码头的罐头厂做工。上个月起厂里生意不好，原本全天班改成了只开半天，工友们下午都回家了，可马丁每天还是拖到半夜才回来，说是厂里留他加班。我闻过他的衣服，根本不是罐头厂的铁锈味，而是一股廉价肥皂和油烟味。")
    (line "尼尔" "你想让我跟着他，查清楚他下半天去了哪儿？")
    (line 委托人海伦 "（咬了咬嘴唇，从包里摸出攒下的零钞看了一眼）我能拿出二十五美元。请您帮我跟着他，拍张照片回来，让我死个明白。")))
    (define (接受!)
      (if (equal? 阶段 "待答复") #t (error "海伦：没有待答复委托"))
      (set! 阶段 "跟踪中")
      (play-dialogue!
    (line "尼尔" "二十五美元。我会把他在外头的去向拍下来交给你。")))
    (define (婉拒!)
      (if (equal? 阶段 "待答复") #t (error "海伦：没有待答复委托"))
      (set! 阶段 "婉拒")
      (play-dialogue!
    (line "尼尔" "抱歉，海伦女士。这次我接不了。您再找人问问吧。")))
    (define (跟踪推进! n)
      (if (equal? 阶段 "跟踪中") #t (error "海伦：当前不可跟踪"))
      (跟踪 'advance! n)
      (if (跟踪 'full?)
        (begin (set! 阶段 "初步材料") (add-item! "马丁的旅馆门口照片" 1)
          (play-dialogue!
    (line "世界" "下午从罐头厂出来后，马丁并没有回家，而是低着头穿过两条街，和几个男女一起走进了一家招牌剥落的廉价旅馆。你隔着街角按下快门，拍下了他走进旅馆大门的画面。")
    (line "世界" "单凭这张门口的照片，已经足以拿回去向海伦交差领钱；但旅馆一楼连着嘈杂的后街餐厅，他进去究竟是私会情人还是另有隐情，这扇门外还看不真切。"))) #f))
    (define (调查推进! n)
      (if (equal? 阶段 "初步材料") #t (error "海伦：当前不可追加调查"))
      (调查 'advance! n)
      (if (调查 'full?)
        (begin (set! 阶段 "查明实情") (add-item! "马丁的餐厅工作照片" 1)
          (play-dialogue!
    (line 马丁委托旅馆老板 "马丁？后头刷盘子呢。他哪有钱住店。")
    (line "世界" "后厨的水槽前，马丁停下手里的活，望着尼尔的相机。")
    (line 海伦的丈夫 "海伦让你来的？")
    (line "尼尔" "厂里下工以后，你就来这里？")
    (line 海伦的丈夫 "少了半天工钱。房租可没少。")
    (line "尼尔" "为什么不告诉她？")
    (line "世界" "马丁把洗净的盘子放到一边。")
    (line 海伦的丈夫 "每天出门，她还替我装好午饭。我总想着，下星期厂里就恢复了。")
    (line "尼尔" "她以为你在外头找了别人。")
    (line "世界" "马丁低下头。尼尔拍下他站在水槽旁的照片。")
    (line 海伦的丈夫 "……你跟她说吧。"))) #f))
    (define (交付! 完整?)
      (if (and (进行中?) (if 完整? (equal? 阶段 "查明实情") (member? 阶段 '("初步材料" "查明实情"))))
        #t (error "海伦：没有可交付的调查材料"))
      (define 已知实情? (equal? 阶段 "查明实情"))
      (set! 结果 (if 完整? "查明实情" "初步材料"))
      (set! 阶段 "完成")
      (add-item! "金钱" 25)
      (cond (完整? (play-dialogue!
    (line "世界" "海伦接过后厨的照片，凑近看了看。")
    (line 委托人海伦 "这是马丁？")
    (line "尼尔" "工厂少了半天班，他来这里洗碗、搬货，补些收入。")
    (line "世界" "她的指尖停在照片里那双泡白的手上。")
    (line 委托人海伦 "每天回来，我还问他怎么一句话都不肯说。")
    (line "世界" "她把照片收好，取出说好的二十五美元。")))
        (已知实情? (play-dialogue!
    (line "世界" "尼尔把旅馆门口的照片放在海伦面前，留下了后厨的那张。")
    (line "尼尔" "这是他离开工厂后去的地方。不过进旅馆，并不能证明他有外遇。")
    (line 委托人海伦 "他明明说在加班。")
    (line "尼尔" "他没有告诉你实际去了哪里。")
    (line 委托人海伦 "好，我自己去问他。钱在这里。")
    (line "世界" "她把照片收进手袋，手指仍压着照片上的门牌。")))
        (else (play-dialogue!
    (line "世界" "尼尔把旅馆门口的照片放在桌上。")
    (line "尼尔" "他离开工厂，去了这里。不过我只拍到他进门，还没查清里面的事。这不能证明外遇。")
    (line 委托人海伦 "可他说在加班。")
    (line "尼尔" "这件事，他确实没告诉你。")
    (line 委托人海伦 "钱在这里。剩下的，我自己问他。")))))
    (define (搜寻行动 id name subtitle skill anchor clock effect)
      (node id :name name :anchor anchor :subtitle subtitle
        :clocks (list (clock 'render-data)) :risk '稳妥
        :progress-target (list 'clock (cadr (clock 'render-data)))
        :requires (list (req-die)) :resolve (roll skill
          (outcome (lambda () #f))
          (outcome (lambda () (effect 1))) (outcome (lambda () (effect 2))))))
    (define (交付行动 完整?)
      (node (if 完整? "海伦交付完整照片" "海伦交付") :button-text "交付"
        :name (if 完整? "告知实情" "交还门口照")
        :subtitle (if 完整? "交出工作照并说明原因，领取25美元。" "交门口照得25美元；照片不能证明外遇。")
        :requires (list (req-item (if 完整? "马丁的餐厅工作照片" "马丁的旅馆门口照片") 1))
        :resolve (instant (outcome (lambda () (交付! 完整?))))))
    (define (nodes-at 地点)
      (cond
        ((equal? 地点 "家")
          (let ((children
            (cond
              ((equal? 阶段 "待交谈")
                (list (node "询问海伦委托" :name "门口的海伦" :button-text "交谈" :resolve (instant (outcome 介绍!)))))
              ((equal? 阶段 "待答复")
                (list (node "接下海伦委托" :name "接受委托" :button-text "接受" :resolve (instant (outcome 接受!)))
                      (node "婉拒海伦委托" :name "拒绝委托" :button-text "拒绝" :resolve (instant (outcome 婉拒!)))))
              ((进行中?) (append (list (交付行动 #f))
                (if (equal? 阶段 "查明实情") (list (交付行动 #t)) '())))
              (else '()))))
            (if (null? children) '()
              (list (node "城市事件-海伦" :name "海伦的委托" :notice-version 阶段 :display 'inline :anchor "家" :children children)))))
        ((and (equal? 地点 "码头") (equal? 阶段 "跟踪中"))
          (list (搜寻行动 "跟踪海伦丈夫" "跟踪马丁" "等马丁离开工厂，跟着他拍下去向。" 'sharpness "码头-巷口" 跟踪 跟踪推进!)))
        ((and (equal? 地点 "码头") (equal? 阶段 "初步材料"))
          (list (搜寻行动 "打听马丁" "追查实情" "找旅馆老板问清去向；追加调查不加钱。" 'social "码头-巷口" 调查 调查推进!)))
        (else '())))
    (lambda (msg . args)
      (cond
        ((eq? msg 'eligible?) (equal? 阶段 "未出现"))
        ((eq? msg 'awaiting-intro?) (equal? 阶段 "待交谈"))
        ((eq? msg 'activate!) (if (equal? 阶段 "未出现") (set! 阶段 "待交谈") (error "海伦：重复出现")))
        ((eq? msg 'on-day-start!) #t)

        ((eq? msg 'arrivals-at) '())
        ((eq? msg 'nodes-at) (nodes-at (car args)))
        ((eq? msg 'dossier)
          (if (equal? 阶段 "未出现") '()
            (list (dossier "海伦：马丁去哪儿了？" :kind '委托 :where (if (member? 阶段 '("跟踪中" "初步材料")) "码头" "家")
              :clocks (cond ((equal? 阶段 "跟踪中") (list (跟踪 'render-data))) ((equal? 阶段 "初步材料") (list (调查 'render-data))) (else '()))
              :status (if (member? 阶段 '("完成" "婉拒" "到期")) '了结 '进行中)
              :now (cond
                ((equal? 阶段 "待交谈") "海伦上门想请你查查丈夫的去向。")
                ((equal? 阶段 "待答复") "海伦想知道马丁是否有外遇。可以接受或拒绝；交差报酬25美元。")
                ((equal? 阶段 "跟踪中") "到码头工厂附近等马丁，跟踪他离开后的去向。这份委托没有期限。")
                ((equal? 阶段 "初步材料") "马丁进了廉价旅馆。可以拿门口照交差，也可以找旅馆老板问清原因。")
                ((equal? 阶段 "查明实情") "马丁在旅馆后厨补贴收入。回家交照片，可以说明实情，也可只交门口照。")
                ((equal? 阶段 "婉拒") "你没有接下这次调查。")
                ((equal? 阶段 "到期") "这份旧委托已经结束。")
                (else (if (equal? 结果 "查明实情") "你交出工作照和实情。海伦收起照片，付了25美元。" "你交出门口照，说明它不能证明外遇。海伦决定亲自问马丁，付了25美元。")))))))
        ((eq? msg 'save) (list (list "stage" 阶段) (list "result" 结果) (list "track" (跟踪 'save)) (list "investigate" (调查 'save))))
        ((eq? msg 'load!) (let ((data (car args)))
          (set! 阶段 (assoc-get data "stage" "未出现")) (set! 结果 (assoc-get data "result" ""))
          (if (member? 阶段 '("未出现" "待交谈" "待答复" "跟踪中" "初步材料" "查明实情" "完成" "婉拒" "到期")) #t
            (error "海伦：非法存档阶段"))
          (跟踪 'load! (assoc-get data "track" 0))
          (调查 'load! (if (equal? 阶段 "查明实情") 6 (assoc-get data "investigate" 0)))))
        (else (error "海伦：未知消息"))))))
