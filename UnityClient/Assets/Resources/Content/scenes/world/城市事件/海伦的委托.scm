;; 城市事件：下班以后。旅馆餐厅作为旧街内的调查地点，不新增地图空间。
(define 委托人海伦 (speaker "委托人海伦" :name "海伦" :appearance '成年女性))
(define 海伦的丈夫 (speaker "海伦的丈夫" :name "马丁" :appearance '成年男性))
(define 海伦的委托
  (let ()
    (define 阶段 "未出现")
    (define 接受日 0)
    (define 截止日 0)
    (define 结果 "")
    (define 跟踪 (make-clock "跟踪马丁" 4 'gauge "查到去向即可交差；照片未必能解释他在做什么。" :beneficial-direction 'increase))
    (define 调查 (make-clock "查明马丁的去向" 4 'gauge "继续调查不会增加尾款，但能查明他在旅馆做什么。" :beneficial-direction 'increase))
    (define (进行中?) (member? 阶段 '("跟踪中" "初步材料" "查明实情")))
    (define (期限)
      (if (进行中?)
        (list (clock-priority (list 'clock "海伦委托期限" (max 0 (- 截止日 world-day)) 3 'countdown
          "接受后的第三个早晨到期；未交付则失去尾款，预付款保留。") 'secondary)) '()))
    (define (介绍!)
      (if (equal? 阶段 "待交谈") #t (error "海伦：当前不可介绍"))
      (set! 阶段 "待答复")
      (play-dialogue!
        (line 委托人海伦 "我丈夫六点下班，九点才回家。他说工厂很忙，可外套一点机油味都没有。")
        (line 委托人海伦 "跟他一次，拍张能说明去向的照片。十五块预付，交差再给二十五。")
        (line 委托人海伦 "接下后就去码头工厂侧街等他。第三天早晨以前，把结果带给我。我会来你住处等消息。")))
    (define (接受!)
      (if (equal? 阶段 "待答复") #t (error "海伦：当前不可接受"))
      (set! 阶段 "跟踪中") (set! 接受日 world-day) (set! 截止日 (+ world-day 3))
      (add-item! "金钱" 15)
      (play-dialogue! (line "尼尔" "我去查清他下班以后去了哪里。")))
    (define (婉拒!)
      (if (equal? 阶段 "待答复") #t (error "海伦：当前不可婉拒"))
      (set! 阶段 "婉拒")
      (play-dialogue! (line "尼尔" "这几天腾不出手。抱歉。")))
    (define (跟踪推进! n)
      (if (and (equal? 阶段 "跟踪中") (>= world-day 接受日) (< world-day 截止日)) #t (error "海伦：不在跟踪窗口"))
      (跟踪 'advance! n)
      (if (跟踪 'full?)
        (begin (set! 阶段 "初步材料") (add-item! "马丁的旅馆门口照片" 1)
          (play-dialogue!
            (line "世界" "马丁拎着午餐盒穿过旧街，走进一家廉价旅馆。尼尔拍下了他进门的照片。")
            (line "尼尔" "只能证明他进了这扇门。还不知道他进去做什么。"))) #f))
    (define (调查推进! n)
      (if (and (equal? 阶段 "初步材料") (< world-day 截止日)) #t (error "海伦：当前不可追加调查"))
      (调查 'advance! n)
      (if (调查 'full?)
        (begin (set! 阶段 "查明实情") (add-item! "马丁的餐厅工作照片" 1)
          (play-dialogue!
            (line "世界" "尼尔在旅馆餐厅看见马丁穿着白围裙收拾餐盘，拍下了照片。收工时，他在后门等到了马丁。")
            (line 海伦的丈夫 "她让你来的？")
            (line "尼尔" "她不知道你在这里。")
            (line 海伦的丈夫 "工厂一个月前就不要我了。我想着找到下一份再告诉她，后来就一天拖一天。")
            (line "尼尔" "她以为你有了别人。")
            (line "世界" "马丁低下头，擦掉午餐盒盖上的水。")
            (line 海伦的丈夫 "这里九点收工。你告诉她吧。"))) #f))
    (define (交付!)
      (if (and (member? 阶段 '("初步材料" "查明实情")) (< world-day 截止日)
               (> (item-count "马丁的旅馆门口照片") 0)
               (or (equal? 阶段 "初步材料") (> (item-count "马丁的餐厅工作照片") 0)))
        #t (error "海伦：需要有效调查材料"))
      (set! 结果 阶段) (set! 阶段 "完成") (add-item! "金钱" 25)
      (if (equal? 结果 "查明实情")
        (play-dialogue!
          (line "尼尔" "他失业了，在旅馆餐厅洗盘子。这是他工作的照片。")
          (line "世界" "海伦把两张照片摆在一起，沉默了一会儿。")
          (line 委托人海伦 "九点收工，是吗？我今晚过去等他。这是说好的尾款。"))
        (play-dialogue!
          (line "尼尔" "我只查到他进了这家旅馆。照片不能证明他有外遇。")
          (line 委托人海伦 "我知道了。我自己去问。这是剩下的钱。"))))
    (define (搜寻行动 id name skill clock effect)
      (node id :name name :anchor (if (equal? id "跟踪海伦丈夫") "码头-巷口" "码头居民区-东侧门廊") :subtitle "投入行动调查；坏结果损失1心情。"
        :clocks (cons (clock 'render-data) (期限)) :risk '冒险
        :risk-target (list 'composure "player") :progress-target (list 'clock (cadr (clock 'render-data)))
        :requires (list (req-die)) :resolve (roll skill
          (outcome (lambda () (spend-composure! 1)))
          (outcome (lambda () (effect 1))) (outcome (lambda () (effect 2))))))
    (define (nodes-at 地点)
      (cond
        ((equal? 地点 "家")
          (let ((children
            (cond
              ((equal? 阶段 "待交谈")
                (list (node "海伦委托介绍" :button-text "交谈" :name "听取委托"
                  :subtitle "海伦想雇人查查丈夫下班后的去向" :resolve (instant (outcome 介绍!)))))
              ((equal? 阶段 "待答复")
                (list (node "接下海伦委托" :name "接受委托" :button-text "接受" :resolve (instant (outcome 接受!)))
                      (node "婉拒海伦委托" :name "拒绝委托" :button-text "拒绝" :resolve (instant (outcome 婉拒!)))))
              ((进行中?)
                (list (node "海伦交付" :button-text "交付" :notice-version 阶段 :name (cond
                    ((equal? 阶段 "查明实情") "说明完整实情")
                    ((equal? 阶段 "初步材料") "按现有材料交差")
                    (else "提交调查材料"))
                  :subtitle (cond
                    ((equal? 阶段 "跟踪中") "到码头工厂侧街跟踪马丁，带回照片领取25美元尾款")
                    ((equal? 阶段 "查明实情") "领取25美元尾款")
                    (else "照片只证明进入旅馆，不能证明外遇；可继续查或交差领取25美元"))
                  :requires (append (list (req-item "马丁的旅馆门口照片" 1))
                    (if (equal? 阶段 "查明实情") (list (req-item "马丁的餐厅工作照片" 1)) '()))
                  :resolve (instant (outcome 交付!)))))
              (else '()))))
            (if (null? children) '()
              (list (node "城市事件-海伦" :name "海伦：丈夫晚归" :display 'inline :anchor "家"
                :clocks (期限) :children children)))))
        ((and (equal? 地点 "码头") (equal? 阶段 "跟踪中"))
          (list (搜寻行动 "跟踪海伦丈夫" "工厂侧街：跟踪马丁" 'sharpness 跟踪 跟踪推进!)))
        ((and (equal? 地点 "码头居民区") (equal? 阶段 "初步材料"))
          (list (node "马丁旅馆调查" :anchor "码头居民区-东侧门廊" :name "旧街旅馆：追加调查" :subtitle "继续调查不会增加尾款"
            :clocks (list (调查 'render-data)) :children
              (list (搜寻行动 "守候马丁" "守候餐厅后门" 'sharpness 调查 调查推进!)
                    (搜寻行动 "打听马丁" "向餐厅侍者打听" 'social 调查 调查推进!)))))
        (else '())))
    (lambda (msg . args)
      (cond
        ((eq? msg 'eligible?) (equal? 阶段 "未出现"))
        ((eq? msg 'activate!) (if (equal? 阶段 "未出现") (set! 阶段 "待交谈") (error "海伦：重复出现")))
        ((eq? msg 'on-day-start!) (if (and (进行中?) (>= world-day 截止日)) (set! 阶段 "到期") #f))
        ((eq? msg 'nodes-at) (nodes-at (car args)))
        ((eq? msg 'dossier)
          (if (equal? 阶段 "未出现") '()
            (list (dossier "海伦：下班以后" :kind '委托 :where "家" :clocks (期限)
              :status (if (member? 阶段 '("完成" "婉拒" "到期")) '了结 '进行中)
              :now (cond
                ((equal? 阶段 "待交谈") "海伦上门寻找能接调查工作的人。")
                ((equal? 阶段 "待答复") "预付15美元、尾款25美元。接受后即可跟踪，第三个早晨到期。")
                ((equal? 阶段 "跟踪中") "到码头工厂侧街跟踪马丁；到期前向海伦交差。")
                ((equal? 阶段 "初步材料") "马丁进了旧街旅馆。可以交差，或去码头居民区的旅馆餐厅继续调查，不增加尾款。")
                ((equal? 阶段 "查明实情") "马丁失业后在旅馆洗盘子，没有告诉妻子。带两张照片回家交差。")
                ((equal? 阶段 "到期") "海伦已自行找丈夫谈过，不再需要调查。预付款保留，失去尾款。")
                ((equal? 阶段 "婉拒") "你没有接下这次调查。")
                (else (if (equal? 结果 "查明实情") "已说明失业实情，收到尾款。海伦准备去接丈夫下班。" "已交付旅馆门口照片，说明了材料的局限，收到尾款。")))))))
        ((eq? msg 'save) (list (list "stage" 阶段) (list "accepted" 接受日) (list "deadline" 截止日)
          (list "result" 结果) (list "track" (跟踪 'save)) (list "investigate" (调查 'save))))
        ((eq? msg 'load!) (let ((data (car args)))
          (set! 阶段 (assoc-get data "stage" "未出现")) (set! 接受日 (assoc-get data "accepted" 0))
          (set! 截止日 (assoc-get data "deadline" 0)) (set! 结果 (assoc-get data "result" ""))
          (if (and (member? 阶段 '("未出现" "待交谈" "待答复" "跟踪中" "初步材料" "查明实情" "完成" "婉拒" "到期"))
                   (or (not (进行中?)) (and (> 接受日 0) (= 截止日 (+ 接受日 3)))))
            #t (error "海伦：非法存档阶段或期限"))
          (跟踪 'load! (assoc-get data "track" 0)) (调查 'load! (assoc-get data "investigate" 0))))
        (else (error "海伦：未知消息"))))))
