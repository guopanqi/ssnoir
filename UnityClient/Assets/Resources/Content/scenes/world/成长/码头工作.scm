;; 玩家码头生计的进展。次数只存在这根钟里；人物与事件读取它，不另记好感。
(define 码头工作
  (let ()
    (define 熟悉 (make-clock "熟悉码头工作" 4 'gauge "多做几次搬运，摸熟门道，也认识些工友。" :beneficial-direction 'increase))
    (define 靠岸日 0)
    (define 相识日 0)
    (define (on-haul!)
      (let ((first? (熟悉 'empty?)) (ready? (熟悉 'full?)))
        (熟悉 'advance! 1)
        (cond
          (first? (set! 相识日 world-day) (第一幕-艾迪教搬运)  #t)
          ((and (not ready?) (熟悉 'full?))
            (set! 靠岸日 (+ world-day 1))
            (play-dialogue!
    (line "世界" "收工结账的队伍很长。艾迪排在尼尔前头，数完手里的零钞，转过身压低了声音。")
    (line "艾迪" "尼尔，明晚有条外地来的大货轮靠岸，赶潮水，要连夜抢卸一批机器零件。")
    (line "尼尔" "夜班？工头怎么没贴通知？")
    (line "艾迪" "通知还没贴。顺利卸完能拿四十八美元，没赶上进度也有六美元辛苦钱。工头让我叫几个熟手，我看你干活不惜力，来不来？")
    (line "尼尔" "四十八美元……我留意着。什么时候？")
    (line "艾迪" "船明天靠岸，就这四天里的事，什么时候有空什么时候去，别错过了就行。")) #t)
          (else #f))))
    (define (nodes-at loc)
      (if (and (equal? loc "码头") (第一幕 'work-open?) (not (第二章 'started?)) (not (熟悉 'full?)))
        (list (at-anchor "码头-货堆" (clock-node "码头工作目标" (熟悉 'render-data)))) '()))
    (lambda (msg . args)
      (cond
        ((eq? msg 'on-haul!) (on-haul!))
        ((eq? msg 'met-day) 相识日)
        ((eq? msg 'met?) (not (熟悉 'empty?)))
        ((eq? msg 'familiar?) (熟悉 'full?))
        ((eq? msg 'count) (熟悉 'current))
        ((eq? msg 'ship-day) 靠岸日)
        ((eq? msg 'nodes-at) (nodes-at (car args)))
        ((eq? msg 'dossier)
          (if (or (not (第一幕 'work-open?)) (第二章 'started?)) '()
            (list (dossier "码头的出路" :kind '打算 :primary #f :where "码头"
              :clocks (if (熟悉 'full?) '() (list (熟悉 'render-data)))
              :status (if (大船靠岸 'followup-ready?) '了结 '进行中)
              :now (cond ((大船靠岸 'followup-ready?) "这班大船的活过去了。码头仍有搬运工作，也还能碰见艾迪。")
                ((熟悉 'full?) "艾迪提过一班大船的活。留意码头招工，靠岸后四天内可参加。")
                (else "多去搬几次货，摸熟门道。工友们有了新活，也许愿意叫上你。"))))))
        ((eq? msg 'save) (list (list "work" (熟悉 'save)) (list "met-day" 相识日) (list "ship-day" 靠岸日)))
        ((eq? msg 'load!) (let ((data (car args)))
          (熟悉 'load! (assoc-get data "work" 0))
          (set! 相识日 (assoc-get data "met-day" (if (熟悉 'empty?) 0 world-day)))
          (set! 靠岸日 (assoc-get data "ship-day" 0))
          (if (and (number? 靠岸日) (>= 靠岸日 0) (or (not (熟悉 'full?)) (> 靠岸日 0))) #t
            (error "码头工作：靠岸日与工作阶段不一致"))))
        (else (error "码头工作：未知消息"))))))
