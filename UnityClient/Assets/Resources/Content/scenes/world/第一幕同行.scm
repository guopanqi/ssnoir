;; 彩排后的酒馆聚会中，夜莺提出陪同请求；交锋回写真实经历。
(define first-act-walk
  (let ()
    (define status "未邀请")
    (define result "")
    (define ignored? #f)
    (define cared? #f)
    (define aftermath? #f)
    (define final-fear 0)
    (define (pending?)
      (and (= world-day 5) (第一幕 'rehearsal-seen?)
           (not (第二章 'started?)) (not (equal? status "已结束"))))

    (define (promise!)
      (if (equal? status "未邀请") #t (error "同行：请求已处理，不能重复答应"))
      (set! status "已答应")

      (play-dialogue!
        (line "世界" "彩排后的聚会散了。夜莺在吧台边拿起外套。")
        (line "夜莺" "我该回去了。后巷那个人，我好像又看见了。")
        (line "夜莺" "你能陪我走到住处吗？")
        (line "尼尔" "我陪你。")
        (line "夜莺" "谢谢。我们走吧。")))
    (define (on-result data)
      (if (and (list? data) (= (length data) 4)
               (member? (car data) '(抵达 叫车离开 倒下))
               (member? (cadr data) '(#t #f)) (member? (caddr data) '(#t #f))
               (member? (cadddr data) '(0 1 2 3)))
        #t (error "雨夜同行：结果格式非法"))
      (set! status "已结束") (set! result (cond ((eq? (car data) '抵达) "抵达")
        ((eq? (car data) '叫车离开) "叫车离开")
        (else "倒下")))
      (set! ignored? (cadr data)) (set! cared? (caddr data)) (set! final-fear (cadddr data))
      )
    (define (arrivals-at location)
      (if (not (equal? location "老街酒馆")) '()
        (cond
          ((and (pending?) (equal? status "未邀请"))
            (list (arrival "彩排后的聚会" promise!)))
          ((and (not aftermath?) (equal? status "已结束") (not (equal? result "叫车离开")))
            (list (arrival "雨夜后的见面" (lambda ()
              (set! aftermath? #t)
              (play-dialogue! (line "夜莺"
                (cond (ignored? "下回我说害怕的时候，先听我说完，好吗？")
                  ((equal? result "倒下") "你还好吗？那晚后来有人帮了我们。")
                  ((and (equal? result "抵达") (= final-fear 3)) "那晚到了家，我还是缓了好一会儿。")
                  ((equal? result "抵达") (if cared? "那晚谢谢你。你没有让我一个人等着。" "那天谢谢你陪我走回来。")))))))))
          (else '()))))
    (lambda args
      (cond
        ((eq? (car args) 'walked?) (equal? status "已结束"))
        ((eq? (car args) 'met?) (not (equal? status "未邀请")))
        ((eq? (car args) 'close?) (and (equal? status "已结束")
          (equal? result "抵达") (not ignored?) (< final-fear 3)))

        ((eq? (car args) 'nodes-at)
          (if (and (equal? (cadr args) "老街酒馆") (pending?))
            (if (equal? status "未邀请")
              (list (node "夜莺的请求" :required-before-rest "先去酒馆见夜莺" :resolve (instant promise!)))
              (list (node "陪夜莺回家" :required-before-rest "先陪夜莺回家" :subtitle "今晚陪她回家；交锋中每回合消耗冷静"
                :resolve (instant (outcome (lambda () (start-encounter "雨夜同行" on-result))))))) '()))
        ((eq? (car args) 'arrivals-at) (arrivals-at (cadr args)))
        ((eq? (car args) 'save)
          (list (list "status" status) (list "result" result)
            (list "ignored?" ignored?) (list "cared?" cared?) (list "aftermath?" aftermath?) (list "final-fear" final-fear)))
        ((eq? (car args) 'load!)
          (let ((data (cadr args)))
            (set! status (assoc-get data "status" "未邀请"))
            (set! result (assoc-get data "result" ""))
            (set! ignored? (assoc-get data "ignored?" #f))
            (set! cared? (assoc-get data "cared?" #f))
            (set! aftermath? (assoc-get data "aftermath?" #f))
            (set! final-fear (assoc-get data "final-fear" 0))
            (if (and (member? result '("" "抵达" "叫车离开" "倒下"))
                     (member? final-fear '(0 1 2 3))
                     (member? ignored? '(#t #f)) (member? cared? '(#t #f))
                     (member? aftermath? '(#t #f)))
              #t (error "同行存档：经历字段非法"))
            (if (member? status '("未邀请" "已答应" "已结束"))
              #t (error "同行存档：邀请状态非法"))))
        (else (error "第一幕同行：未知消息"))))))
