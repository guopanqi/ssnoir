;; 酒馆消息触发闹事，收场后开放四班工作，结果带来职业口碑，不与地点的工资逻辑混放。
(define 酒馆起步
  (let ()
    (define 工作 (make-clock "做熟酒馆工作" 4 'gauge "替酒保维持秩序，慢慢熟悉这里的常客。" :beneficial-direction 'increase))
    (define 相遇日 0)
    (define 阶段 "消息中") ; 消息中／待处理／待回酒馆／已收场；工作进度独立于闹事阶段
    (define (on-news!)
      (if (equal? 阶段 "消息中")
        (begin (set! 阶段 "待处理")
          (play-dialogue!
    (line "世界" "劣质麦酒刚喝到底，角落里突然传来椅子翻倒的脆响。两桌醉客因为一副脏扑克揪住了彼此的领口，酒瓶在桌沿摇摇欲坠。吧台后的酒保皱起眉头，手按在了木棍上，但还没走出吧台。"))) #f))
    (define (on-work!)
      (if (equal? 阶段 "已收场")
        (let ((was-full? (工作 'full?)))
          (工作 'advance! 1)
          (if (and (not was-full?) (工作 'full?))
            (begin (set! 相遇日 world-day)
              (play-dialogue!
    (line "世界" "下半场散了，酒馆里全是烟味。夜莺夹着歌谱下台，高跟鞋踩在倒数第三块木板上，木板翘了一下。")
    (line "世界" "尼尔正端着空酒瓶路过，伸手托了她小臂一把。她借力站稳，把胳膊收回去，顺手按了按鬓角。")
    (line "夜莺" "谢谢。这块板子松了三天了。")
    (line "尼尔" "老吉姆说明天修。")
    (line "夜莺" "他上礼拜也这么说。")
    (line "世界" "尼尔蹲下，把滑在啤酒沫旁边的两页谱子捡起来递给她。纸边用红铅笔画满了换气的记号，有几处快把纸划破了。")
    (line "尼尔" "改得挺狠。在台下听不出来。")
    (line "夜莺" "让你听出来，老吉姆就该扣我钱了。")
    (line "世界" "她把谱子合上，看了尼尔一眼。")
    (line "夜莺" "你是新来看场子的？这两天门口没人闹事，清净了不少。我叫夜莺。")
    (line "尼尔" "尼尔。")
    (line "夜莺" "谢了，尼尔。")
    (line "世界" "她点点头，掀开后台帘子走了进去。")))
            (if (and (> 相遇日 0) (>= world-day (+ 相遇日 2))) (first-act-walk 'request!) #f)))
        (error "酒馆工作：尚未处理闹事，不能开始看场")))
    (define (finish! result)
      (if (and (equal? 阶段 "待处理") (member? result '(success fail 倒下))) #t (error "酒馆起步：非法闹事结算"))
      (if (eq? result '倒下)
        (set! 阶段 "待回酒馆")
        (begin
      (set! 阶段 "已收场")
      (if (eq? result 'success) (play-dialogue!
    (line "世界" "闹事的汉子骂骂咧咧地坐了回去，把翻倒的木椅扶正。屋里重新恢复了嘈杂的低语。")
    (line "调酒师" "（把抹布搭在肩上，推过来半杯热酒）手脚挺干净。没把我的桌子砸了，也没把巡警招来。")
    (line "尼尔" "他们只是喝多了，缺个台阶下。")
    (line "调酒师" "能让人顺着台阶下来，也是本事。平时晚上来帮我盯着点场面吧，有工钱。")) (play-dialogue!
    (line "世界" "地上碎了两只酒杯，闹事的人捂着鼻子散开了。你甩了甩发麻的手背，外套上沾了点啤酒沫。")
    (line "调酒师" "（拎着扫帚走出来，看了一眼地上的玻璃碴）动静大了点，不过好歹没让人把店拆了。")
    (line "尼尔" "抱歉，那家伙比看着更轴。")
    (line "调酒师" "肯在这时候站出来挡一下，总比缩在角落看戏强。以后店里忙的时候，你来帮我搭把手看场子吧。")))
      (begin)
      (调查职业 'on-trouble-settled!))))
    (define (return-after-collapse!)
      (set! 阶段 "已收场")
      (play-dialogue!
        (line "调酒师" "回来了？那天后来有人叫了巡警，把那两桌赶散了。")
        (line "尼尔" "给你添麻烦了。")
        (line "调酒师" "肯站出来就够了。往后店里忙，你还可以来搭把手。别再一个人硬顶。"))
      (调查职业 'on-trouble-settled!))
    (lambda (msg . args)
      (cond
        ((eq? msg 'on-news!) (on-news!))
        ((eq? msg 'on-work!) (on-work!))
        ((eq? msg 'pending?) (equal? 阶段 "待处理"))
        ((eq? msg 'settled?) (equal? 阶段 "已收场"))
        ((eq? msg 'count) (工作 'current))
        ((eq? msg 'met?) (> 相遇日 0))
        ((eq? msg 'ready?) (and (工作 'full?) (> 相遇日 0) (>= world-day (+ 相遇日 2))))
        ((eq? msg 'arrivals-at)
          (if (and (equal? (car args) "老街酒馆") (equal? 阶段 "待回酒馆"))
            (list (arrival "送医后回到酒馆" return-after-collapse!)) '()))
        ((eq? msg 'nodes-at)
          (if (or (not (equal? (car args) "老街酒馆")) (not (第一幕 'work-open?)) (第二章 'started?)) '()
            (cond
              ((and (equal? 阶段 "已收场") (not (工作 'full?))) (list (at-anchor "老街酒馆-工作" (clock-node "酒馆工作目标" (工作 'render-data)))))
              ((equal? 阶段 "待处理")
                (list (node "醉客互相叫骂" :anchor "老街酒馆" :subtitle "拦住两桌争吵的醉客，别让店里乱起来。"
                  :resolve (instant (outcome (lambda () (start-scenario "醉客互相叫骂" finish!)))))))
              (else '()))))
        
        ((eq? msg 'work-clock) (工作 'render-data))
        ((eq? msg 'save) (list (list "met-day" 相遇日) (list "work" (工作 'save)) (list "stage" 阶段)))
        ((eq? msg 'load!) (let ((data (car args)))
          (工作 'load! (assoc-get data "work" 0))
          (set! 相遇日 (assoc-get data "met-day" (if (工作 'full?) world-day 0))) (set! 阶段 (assoc-get data "stage" "消息中"))
          (if (equal? 阶段 "工作中") (set! 阶段 "已收场") #f)
          (if (member? 阶段 '("消息中" "待处理" "待回酒馆" "已收场")) #t (error "酒馆起步：阶段与进度不一致"))))
        (else (error "酒馆起步：未知消息"))))))
