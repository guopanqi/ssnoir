;; 独立照相馆交涉原型，未接入城市或实际线索物品发放。
;; A/B各6，达到3帮助另一边；结果记录已完成的事实，不取原始底片。
(define finished? #f)
(define traces (make-clock "确认加工来源" 6 'gauge "满6确认设备与加工痕迹吻合；到3缩小订单查询范围。"))
(define orders (make-clock "取得订单信息" 6 'gauge "满6找到匿名订单与取件信息；到3提供同批样片供比对。"))
(define suspicion (make-clock "店主戒心" 6 'gauge "满6店主收起材料，交涉结束；已经完成的成果保留。"))
(define (tier)
  (cond ((and (traces 'full?) (orders 'full?)) '可信来源线索)
        ((traces 'full?) '加工吻合) ((orders 'full?) '候选订单) (else '尚未证实)))
(define (finish! reason)
  (if finished? (error "照相馆：重复结算") #t)
  (set! finished? #t)
  (spotlight! "照相馆调查"
    (string-append (if (equal? reason '拒绝) "店主合上登记簿。" "你收起抄录和照片。")
      (cond ((equal? (tier) '可信来源线索) "加工痕迹与匿名订单相互印证，取得可信的来源线索。")
            ((equal? (tier) '加工吻合) "设备与痕迹吻合，但还没有确认对应订单。")
            ((equal? (tier) '候选订单) "找到符合条件的订单，仍需核对加工来源。")
            (else "没有得到足以证实来源的线索。"))))
  (end-encounter (list reason (tier) (traces 'current) (orders 'current))))
(define (check!)
  (cond ((suspicion 'full?) (finish! '拒绝))
        ((and (traces 'full?) (orders 'full?)) (finish! '完成)) (else #f)))
(define (advance-goal! goal n)
  (let ((clock (if (eq? goal '加工) traces orders)))
    (let ((before (clock 'current)))
      (clock 'advance! n)
      (if (and (< before 3) (>= (clock 'current) 3))
        (if (eq? goal '加工)
          (play-dialogue!
            (line "尼尔" "照片边缘这道细口，店里的样片也有。")
            (line "店主" "是那台裁刀留下的。查这种尺寸的单子就够了。"))
          (play-dialogue!
            (line "店主" "那几天有几笔小幅照片。这些是同批的测试样片。")
            (line "尼尔" "借我对照一下。"))) #f)
      (if (and (not (= before 6)) (clock 'full?))
        (if (eq? goal '加工)
          (play-dialogue! (line "世界" "相纸与裁刀留下的细口吻合，但仍可能来自别处。"))
          (play-dialogue!
            (line "店主" "这笔匿名订单，小幅六张，星期二傍晚取件。")
            (line "店主" "取件人穿着不合身的邮务制服。我不知道他的名字。"))) #f))))
(define (resolve! goal direct? grade)
  (cond ((eq? grade '坏)
         (spend-composure! 1)
         (suspicion 'advance! (if direct? 2 1)))
        ((eq? grade '中)
         (advance-goal! goal 1)
         (if direct? (suspicion 'advance! 1) #f))
        (else (advance-goal! goal 2)))
  (check!))
(define (action-node title description skill goal direct?)
  (node title :subtitle description
    :requires (list (req-die))
    :resolve (roll skill
      (lambda ()
        (cond ((and (eq? goal '加工) (>= (orders 'current) 3))
               (list (modifier -1 "样片对照")))
              ((and (eq? goal '订单) (>= (traces 'current) 3))
               (list (modifier -1 "范围缩小")))
              (else '())))
      (outcome (lambda () (resolve! goal direct? '坏)))
      (outcome (lambda () (resolve! goal direct? '中)))
      (outcome (lambda () (resolve! goal direct? '好))))))
(define (on-encounter-enter)
  (play-dialogue!
    (line "尼尔" "这张照片的裁边，和你店里的很像。")
    (line "店主" "像不等于是。客人的事情，我也不能随便说。")
    (line "尼尔" "先核对加工方式，再看看有没有对应的订单。")))
(define (on-encounter-collapse)
  (collapse-result (list '倒下 (tier) (traces 'current) (orders 'current))))
(define (get-render-data)
  (container "照相馆交涉"
    (append
      (clock-nodes (traces 'render-data) (orders 'render-data) (suspicion 'render-data))
      (list (note-node "标注：照相馆材料" "照片、样片与登记簿"
        "加工到3缩小查账范围；订单到3提供对照样片。单边完成可收手，双边完成相互印证。"))
      (if (traces 'full?) '()
        (list (action-node "核对加工" "检查相纸规格与裁刀留下的痕迹" 'knowledge '加工 #f)
              (action-node "细看照片" "在印记、边缘和样片中辨认细微差异" 'sharpness '加工 #f)))
      (if (orders 'full?) '()
        (list (action-node "争取查账" "解释勒索、请求查看；中增戒心1，坏增2" 'social '订单 #t)
              (action-node "核对登记" "按日期、规格与数量排查候选订单" 'knowledge '订单 #f)))
      (if (or (traces 'full?) (orders 'full?))
        (list (instant-action "带走现有证据" (lambda () (finish! '收手)))) '()))))
