;; 独立深入交涉：A→A1→加工结果；B→B1→订单结果。
;; 每层6格，每完成一层使另一整条路线准备值+1，最多+2（降低难度）。
;; 未接入城市或实际线索物品，不获取原始底片。
(define finished? #f)
(define paper (make-clock "A：辨认相纸" 6 'gauge "满6找到相纸批次，开放设备比对；订单路线难度降低1。"))
(define equipment (make-clock "A1：核对设备" 6 'gauge "满6取得加工结果；订单路线难度再降低1。"))
(define permission (make-clock "B：争取查账" 6 'gauge "满6店主提供候选订单，开放订单核对；加工路线难度降低1。"))
(define records (make-clock "B1：核对订单" 6 'gauge "满6取得订单结果；加工路线难度再降低1。"))
(define suspicion (make-clock "店主戒心" 7 'gauge "满7结束交涉；每个坏结果扣冷静1，并增加戒心。已有成果保留。"))
(define (a-help) (+ (if (paper 'full?) 1 0) (if (equipment 'full?) 1 0)))
(define (b-help) (+ (if (permission 'full?) 1 0) (if (records 'full?) 1 0)))
(define (tier)
  (cond ((and (equipment 'full?) (records 'full?)) '可信来源线索)
        ((equipment 'full?) '加工吻合) ((records 'full?) '候选订单) (else '尚未证实)))
(define (finish! reason)
  (if finished? (error "照相馆：重复结算") #t)
  (set! finished? #t)
  (spotlight! "照相馆调查"
    (string-append (if (equal? reason '拒绝) "店主合上登记簿。" "你收起抄录和照片。")
      (cond ((equal? (tier) '可信来源线索) "加工痕迹与匿名订单相互印证，取得可信来源线索。")
            ((equal? (tier) '加工吻合) "设备与加工痕迹吻合，但对应订单尚未确认。")
            ((equal? (tier) '候选订单) "找到符合条件的订单，加工来源仍待核实。")
            (else "只有初步发现，还不能证实照片来源。"))))
  (end-encounter (list reason (tier) (paper 'current) (equipment 'current)
    (permission 'current) (records 'current))))
(define (check!)
  (cond ((suspicion 'full?) (finish! '拒绝))
        ((and (equipment 'full?) (records 'full?)) (finish! '完成)) (else #f)))
(define (advance-stage! stage n)
  (let ((clock (cond ((eq? stage 'A) paper) ((eq? stage 'A1) equipment)
                    ((eq? stage 'B) permission) ((eq? stage 'B1) records)
                    (else (error "照相馆：未知调查层次")))))
    (clock 'advance! n)
    ;; 完成层的行动立即撤下，剩余进度不跨层溢出。
    (if (clock 'full?)
      (cond ((eq? stage 'A)
             (play-bubble!
               (line "尼尔" "老板，你看这背面的压纹。昨天我在你这里洗的照片也有。" :at "尼尔@照相馆交涉")
               (line "店主" "这个……相纸也是批发来的。不过这种纸，我们上周才进。" :at "店主@照相馆交涉")))
            ((eq? stage 'A1)
             (play-bubble!
               (line "尼尔" "这里缺了一点。你刚裁的这张也一样。" :at "尼尔@照相馆交涉")
               (line "店主" "这个……诶，是前些天刀口磕了。那几天的小照片都有这个毛病。" :at "店主@照相馆交涉")
               (line "尼尔" "你记得大概的日期吗？" :at "尼尔@照相馆交涉")
               (line "店主" "唔……也许吧。" :at "店主@照相馆交涉")))
            ((eq? stage 'B)
             (play-bubble!
               (line "尼尔" "这张照片被人用来勒索。也许有一天，你也会受影响。" :at "尼尔@照相馆交涉")
               (line "店主" "我只是个洗照片的，和我有什么关系？" :at "店主@照相馆交涉")
               (line "尼尔" "警车停在你门前的时候，你的顾客也许不这么想。" :at "尼尔@照相馆交涉")
               (line "店主" "……那几批试印都留着。你自己看。" :at "店主@照相馆交涉")))
            ((eq? stage 'B1)
             (play-bubble!
               (line "尼尔" "我是侦探，不是警察。告诉我该查哪几天，就没你的事了。" :at "尼尔@照相馆交涉")
               (line "店主" "你说话算数？" :at "店主@照相馆交涉")
               (line "尼尔" "这纸，前些天是不是换过一批？" :at "尼尔@照相馆交涉")
               (line "店主" "……是有这么回事。" :at "店主@照相馆交涉")))) #f)))
(define (resolve! stage direct? grade)
  (cond ((eq? grade '坏)
         (spend-composure! 1) (suspicion 'advance! (if direct? 2 1)))
        ((eq? grade '中)
         (advance-stage! stage 1) (if direct? (suspicion 'advance! 1) #f))
        (else (advance-stage! stage 2)))
  (check!))
(define (action-anchor title stage)
  (cond ((eq? stage 'A) "照相馆交涉-相纸台")
        ((eq? stage 'A1) (if (equal? title "细看样片") "照相馆交涉-相纸台" "照相馆交涉-裁刀"))
        ((eq? stage 'B) "照相馆交涉-柜台")
        ((eq? stage 'B1) (if (equal? title "追问取件") "照相馆交涉-柜台" "照相馆交涉-登记簿"))
        (else (error "照相馆：行动缺少空间落点"))))
(define (action-node title description skill stage direct?)
  (node title :anchor (action-anchor title stage) :subtitle description :requires (list (req-die))
    :resolve (roll skill
      (lambda ()
        (let ((help (if (member? stage '(A A1)) (b-help) (a-help))))
          (if (> help 0) (list (modifier help
            (if (member? stage '(A A1)) "老板建议" "你的证据"))) '())))
      (outcome (lambda () (resolve! stage direct? '坏)))
      (outcome (lambda () (resolve! stage direct? '中)))
      (outcome (lambda () (resolve! stage direct? '好))))))
(define (on-encounter-enter)
  (play-dialogue!
    (line "尼尔" "这张照片可能在这里加工过。我想核对一下。" :at "尼尔@照相馆交涉")
    (line "店主" "先弄清楚你要查什么，客户的事情不能随便说。" :at "店主@照相馆交涉")
    (line "世界" "每条路线有两层；每完成一层，另一条更容易。")))
(define (on-encounter-collapse)
  (collapse-result (list '倒下 (tier) (paper 'current) (equipment 'current)
    (permission 'current) (records 'current))))
(define (get-render-data)
  (container "照相馆交涉"
    (append
      (clock-nodes (suspicion 'render-data))
      (list (note-node "标注：调查结构" "加工比对与订单追查"
        (string-append "每层6格；好2、中1。加工路线难度降低"
          (number->string (b-help)) "，订单路线难度降低" (number->string (a-help)) "。")))
      (cond ((not (paper 'full?))
             (append (clock-nodes (paper 'render-data))
               (list (action-node "核对相纸" "按规格与批次比对；坏扣冷静1、戒心1" 'knowledge 'A #f)
                     (action-node "辨认压纹" "细看背面与边缘；坏扣冷静1、戒心1" 'sharpness 'A #f))))
            ((not (equipment 'full?))
             (append (clock-nodes (equipment 'render-data))
               (list (action-node "核对裁刀" "对照设备留下的细口" 'knowledge 'A1 #f)
                     (action-node "细看样片" "辨认样片与照片的加工痕迹" 'sharpness 'A1 #f))))
            (else (list (note-node "标注：加工成果" "加工结果已取得" "本店设备与照片痕迹吻合；仍需订单印证。"))))
      (cond ((not (permission 'full?))
             (append (clock-nodes (permission 'render-data))
               (list (action-node "解释查账" "说明勒索；中戒心1，坏冷静1、戒心2" 'social 'B #t)
                     (action-node "限定查询" "说明只查规格日期；坏冷静1、戒心1" 'knowledge 'B #f))))
            ((not (records 'full?))
             (append (clock-nodes (records 'render-data))
               (list (action-node "核对登记" "从候选单比对数量与时间" 'knowledge 'B1 #f)
                     (action-node "追问取件" "请店主回忆取件；中戒心1，坏冷静1、戒心2" 'social 'B1 #t))))
            (else (list (note-node "标注：订单成果" "订单结果已取得" "匿名订单：小幅六张，星期二傍晚取件。取件人是年轻男人，邮务制服不合身；姓名未知。"))))
      (if (or (equipment 'full?) (records 'full?))
        (list (instant-action "带走现有证据" (lambda () (finish! '收手)))) '()))))
