;; 独立交锋：多回合核账，不推进世界日期。
(define 工时 (make-clock "核清工时" 5 'gauge "找到那半班没有入账的装卸记录。" :beneficial-direction 'increase))
(define 作证 (make-clock "工友作证" 4 'gauge "让同一班的人愿意在记录上签名。" :beneficial-direction 'increase))
(define 升级 (make-clock "争执升级" 6 'pressure "工头把核账当成挑衅，再闹下去会停掉艾迪的班。" :beneficial-direction 'decrease))
(define 危机? #f)
(define 弗兰克已帮? #f)
(define 结束? #f)
(define (收场! result)
  (if 结束? (error "工钱交锋：重复结算") #t)
  (set! 结束? #t)
  (play-dialogue!
    (line "世界" (if (eq? result '上工)
      "账房把漏掉的工时补进册子，年轻工人终于拿到了钱。"
      "工头合上账本，把艾迪的名字从接下来几天的排班里划去。"))
    (line "艾迪" (if (eq? result '上工) "行了，回去干活。别把钱弄丢了。"
      "你先回去。我的班，我自己担着。")))
  (end-encounter result))
(define (检查局势!)
  (cond ((升级 'full?) (收场! '停班))
    ((and (工时 'full?) (作证 'full?)) (收场! '上工))
    ((and (not 危机?) (or (>= (升级 'current) 3) (>= (工时 'current) 3)))
      (set! 危机? #t)
      (play-dialogue!
        (line "工头" "账我可以再核。可你再带头闹，明天就别来上工了。")
        (line "年轻工人" "艾迪……我还得在这儿干活。")
        (line "艾迪" "我只是要他把工钱给你。")))
    (else #f)))
(define (投入! target amount heat)
  (if 结束? (error "工钱交锋：已结束") #t)
  (target 'advance! amount) (升级 'advance! heat)
  (检查局势!))
(define (请弗兰克!)
  (if (and 危机? (not 弗兰克已帮?)) #t (error "工钱交锋：协助不可重复"))
  (set! 弗兰克已帮? #t)
  (升级 'advance! -1) (作证 'advance! 1)
  (play-dialogue!
    (line "弗兰克" "你把饭碗丢了，下回谁替他们说话？")
    (line "弗兰克" "先别吵。同一班的人，有谁肯把自己的工时签在这儿？")
    (line "世界" "他把笔递给工友，站到艾迪和工头中间。"))
  (检查局势!))
(define (交涉行动 id name skill target risky?)
  (node id :name name
    :subtitle (if risky? "中结果也会激化争执；坏结果没有进展" "慢慢核实；坏结果会激化争执")
    :risk (if risky? '危险 '冒险)
    :progress-target (list 'clock (cadr (target 'render-data)))
    :risk-target (list 'clock "争执升级") :requires (list (req-die))
    :resolve (roll skill
      (outcome (lambda () (投入! target 0 1)))
      (outcome (lambda () (投入! target 1 (if risky? 1 0))))
      (outcome (lambda () (投入! target (if risky? 2 1) 0))))))
(define-opponent-rule "争执越来越难收拾"
  (lambda () (not 结束?))
  (lambda () (升级 'advance! 1) (检查局势!)))
(define (on-encounter-enter)
  (工时 'load! 0) (作证 'load! 0) (升级 'load! 0)
  (set! 危机? #f) (set! 弗兰克已帮? #f) (set! 结束? #f))
(define (on-encounter-collapse) (collapse-result '停班))
(define (get-render-data)
  (container "少了十块钱" (append
    (list (note-node "工钱：目标" "核清工钱" "找齐工时和签名，别让艾迪把工作也赔进去。")
      (note-node "工钱：回合回应" "工头的耐心" "每次结束回合，争执升级增加1；满格后艾迪被停班。"))
    (clock-nodes (工时 'render-data) (作证 'render-data) (升级 'render-data))
    (if (工时 'full?) '() (list
      (交涉行动 "核对工时簿" "核对工时簿" 'sharpness 工时 #f)
      (交涉行动 "追问账房" "当面追问账房" 'social 工时 #t)))
    (if (作证 'full?) '() (list
      (交涉行动 "私下对证" "私下找工友" 'social 作证 #f)
      (交涉行动 "当场作证" "请工友表态" 'social 作证 #t)))
    (if (and 危机? (not 弗兰克已帮?))
      (list (node "请弗兰克协助" :subtitle "请他缓和争执，帮工友签名" :requires (list (req-die))
        :resolve (instant (outcome 请弗兰克!)))) '())
    (list (instant-action "离开这场争执" (lambda () (收场! '停班)))))))
