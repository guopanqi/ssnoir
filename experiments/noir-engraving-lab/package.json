{
  "name": "ssnoir-noir-engraving-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "capture": "node tools/capture.mjs",
    "build:skyline-noir-glm": "vite build -c vite.skyline-noir-glm.config.js",
    "capture:skyline-noir-glm": "node tools/capture-skyline-noir-glm.mjs",
    "build:heishui": "vite build --config vite.heishui.config.js",
    "build:lantern-spark": "vite build -c vite.lantern-spark.config.js",
    "capture:lantern-spark": "node tools/capture-lantern-spark.mjs",
    "build:backlight": "vite build -c vite.backlight.config.js",
    "capture:backlight": "node tools/capture-backlight.mjs",
    "export:backlight": "blender -b ../../city-box/build/city/city_build.blend --python tools/export-backlight.py",
    "capture:heishui": "node tools/heishui-capture.mjs",
    "perf:heishui": "node tools/heishui-perf.mjs",
    "export:heishui": "blender -b ../../city-box/build/city/city_build.blend --python tools/heishui-export.py",
    "build:fog-neon": "vite build -c vite.fog-neon.config.js",
    "export:fog-neon": "blender -b ../../city-box/build/city/city_build.blend --python tools/fog-neon-export.py",
    "export:fog-neon-roads": "blender -b ../../city-box/prefabs/世界.blend --python tools/fog-neon-roads.py",
    "status": "node tools/status.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "playwright": "1.55.0",
    "sharp": "0.34.4"
  }
}
