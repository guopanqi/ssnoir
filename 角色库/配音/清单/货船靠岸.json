{
  "version": 1,
  "module": "货船",
  "location": "码头",
  "source": "UnityClient/Assets/Resources/Content/scenes/world/人物/弗兰克.scm",
  "cues": [
    {
      "id": "货船/码头/靠岸/01/尼尔",
      "speaker": "尼尔",
      "text": "今天怎么回事？",
      "sourcePath": "弗兰克.scm/靠岸/01"
    },
    {
      "id": "货船/码头/靠岸/02/弗兰克",
      "speaker": "弗兰克",
      "text": "东边缺两个人！钢缆别堆在跳板上！",
      "sourcePath": "弗兰克.scm/靠岸/02"
    },
    {
      "id": "货船/码头/靠岸/03/弗兰克",
      "speaker": "弗兰克",
      "text": "找活的？今天加钱。去那边报名字。",
      "sourcePath": "弗兰克.scm/靠岸/03"
    },
    {
      "id": "货船/码头/靠岸/04/尼尔",
      "speaker": "尼尔",
      "text": "他是谁？",
      "sourcePath": "弗兰克.scm/靠岸/04"
    },
    {
      "id": "货船/码头/靠岸/05/码头工人",
      "speaker": "码头工人",
      "text": "进水了，临时拖来的。弗兰克在管，别挡跳板。",
      "sourcePath": "弗兰克.scm/靠岸/05",
      "style": "三十多岁的美国码头工人，劳动后喘着气，嗓音粗哑，急着继续干活。"
    },
    {
      "id": "货船/码头/坏结果/01/弗兰克",
      "speaker": "弗兰克",
      "text": "先放下！那根绳滑了，下面的人怎么办？",
      "sourcePath": "弗兰克.scm/坏结果/01"
    },
    {
      "id": "货船/码头/收工/01/贝恩斯",
      "speaker": "贝恩斯",
      "text": "岸口的人可以撤了？",
      "sourcePath": "弗兰克.scm/收工/01"
    },
    {
      "id": "货船/码头/收工/02/弗兰克",
      "speaker": "弗兰克",
      "text": "再留十分钟。最后一班还没上来。",
      "sourcePath": "弗兰克.scm/收工/02"
    },
    {
      "id": "货船/码头/收工/03/贝恩斯",
      "speaker": "贝恩斯",
      "text": "十分钟。",
      "sourcePath": "弗兰克.scm/收工/03"
    },
    {
      "id": "货船/码头/收工/04/弗兰克",
      "speaker": "弗兰克",
      "text": "尼尔……你不是我这儿的人。",
      "sourcePath": "弗兰克.scm/收工/04"
    },
    {
      "id": "货船/码头/收工/05/尼尔",
      "speaker": "尼尔",
      "text": "今天算是。",
      "sourcePath": "弗兰克.scm/收工/05"
    },
    {
      "id": "货船/码头/收工/06/弗兰克",
      "speaker": "弗兰克",
      "text": "今天算。工钱去岸口领。",
      "sourcePath": "弗兰克.scm/收工/06"
    },
    {
      "id": "货船/码头/环境喊声/01/工人",
      "speaker": "码头工人",
      "text": "泵往这边送！跳板让开！",
      "sourcePath": "弗兰克.scm/靠岸/场外喊声",
      "style": "四十岁美国码头工人，嗓音粗哑，隔着码头向同伴高声喊话，急促清楚。"
    }
  ]
}
