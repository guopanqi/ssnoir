    },
    {
      "id": "_gwNZLeXPSIEpHmv33CZ1",
      "type": "text",
      "x": 1692.6683473919586,
      "y": 1251.064990263717,
      "width": 280.263381573097,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 50,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 513435323,
      "version": 675,
      "versionNonce": 1376372725,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782876636449,
      "link": null,
      "locked": false,
      "text": "经理很着急，他觉得夜莺是他手里的一\n颗明珠，一份财产，他对于丑闻难以容\n忍。\n\n和夜莺交谈后，可以和经理交谈，和经\n理交谈后开始正式调查，开启下一节，\n解锁码头",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "经理很着急，他觉得夜莺是他手里的一颗明珠，一份财产，他对于丑闻难以容忍。\n\n和夜莺交谈后，可以和经理交谈，和经理交谈后开始正式调查，开启下一节，解锁码头",
      "autoResize": false,
      "lineHeight": 1.25
    },
