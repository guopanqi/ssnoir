    },
    {
      "id": "lYFIcDbzPuxrjPfkBRlWd",
      "type": "text",
      "x": 2598.6285005556006,
      "y": 1684.8830625409657,
      "width": 799.9840087890625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 50,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 773748347,
      "version": 23,
      "versionNonce": 2064678229,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1782876995886,
      "link": null,
      "locked": false,
      "text": "夜莺把包裹放进去之后，就按照约定走开了，我在一个铺子那儿坐着吃面，喝茶，我等了一个钟头，只是零零散散\n地有人投信，有一个邮差取信，并没有...邮差！",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "夜莺把包裹放进去之后，就按照约定走开了，我在一个铺子那儿坐着吃面，喝茶，我等了一个钟头，只是零零散散地有人投信，有一个邮差取信，并没有...邮差！",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "VviEAAJQi0qPz1nADD_CB",
      "type": "text",
      "x": 2900.1085115419287,
      "y": 1744.8830625409657,
      "width": 197.02398681640625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 50,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 570852021,
      "version": 23,
      "versionNonce": 1514172027,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1782876995886,
      "link": null,
      "locked": false,
      "text": "该死，你差点丢掉你的工作!",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "该死，你差点丢掉你的工作!",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pF45Gbl2OpDTHHjrE6t1D",
      "type": "text",
      "x": 2718.620504950132,
      "y": 1774.8830625409657,
      "width": 560,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 50,
      "groupIds": [],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 1235218203,
      "version": 23,
      "versionNonce": 991955637,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1782876995886,
      "link": null,
      "locked": false,
      "text": "我赶忙跟了上去，还好我提前踩了点，我记得他的方向，我知道他可能走的位置",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
