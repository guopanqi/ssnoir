      "link": null,
      "locked": false,
      "text": "赞助商薇拉\n第六节。演出前握手交流；她反常地关注并欣赏夜莺。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "theatre-sponsor",
      "originalText": "赞助商薇拉\n第六节。演出前握手交流；她反常地关注并欣赏夜莺。",
      "autoResize": false,
      "lineHeight": 1.25
    },
