      "link": null,
      "locked": false,
      "text": "向码头人打听\n了解地区与人群；注意到他们排斥西服，并抱怨“你们”。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "dock-inquiry",
      "originalText": "向码头人打听\n了解地区与人群；注意到他们排斥西服，并抱怨“你们”。",
      "autoResize": false,
      "lineHeight": 1.25
    },
