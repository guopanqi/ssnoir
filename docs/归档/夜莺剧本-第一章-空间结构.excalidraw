      "link": null,
      "locked": false,
      "text": "码头\n第二节主要空间；先踩点三天，再围绕邮箱进行交锋与追逐。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "dock",
      "originalText": "码头\n第二节主要空间；先踩点三天，再围绕邮箱进行交锋与追逐。",
      "autoResize": false,
      "lineHeight": 1.25
    },
